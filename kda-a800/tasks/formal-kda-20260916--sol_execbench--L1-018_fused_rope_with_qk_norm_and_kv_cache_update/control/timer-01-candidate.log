{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018DxQi61XRDJuybH4MkSCUN","type":"tool_result","content":"1\timport torch\n2\timport triton\n3\timport triton.language as tl\n4\t\n5\t\n6\t# =============================================================================\n7\t# L1/018 Fused RoPE + QK-Norm + KV-Cache update  (candidate c002)\n8\t#\n9\t# Option B (see docs/plan.md §3): two Triton kernels.\n10\t#   * Q kernel   : per-head RMS-norm + RoPE -> query_rotated\n11\t#   * K+V kernel : per-head RMS-norm + RoPE on K -> key_rotated + key_cache\n12\t#                  scatter; copy V verbatim -> value_cache scatter.\n13\t#\n14\t# c002 vs c001: single lever changed -> @triton.autotune over\n15\t#   BLOCK_S in {1,2,4,8,16,32} x num_warps in {1,2,4}, keyed on seq_len S.\n16\t# Everything else (math, layout, invariants) is identical to c001.\n17\t#\n18\t# Each program handles one block of BLOCK_S consecutive seq tokens of one\n19\t# (b, head). Row is loaded as two halves [BLOCK_S, HALF] so rotate_half is\n20\t# free (halves-paired RoPE, dim j pairs with j+HALF, shared angle theta_j).\n21\t#\n22\t# Correctness invariants (unchanged from c001):\n23\t#   - RMS variance accumulated in fp32, divided by HEAD_DIM, +eps inside rsqrt.\n24\t#   - weight applied as weight.float() * xn, rounded to bf16 on store.\n25\t#   - RoPE halves-paired (j, j+64); position_ids drives the angle.\n26\t#   - V copied verbatim into value_cache (never normed/roped).\n27\t#   - cache_position drives the cache row; cache offsets computed in int64.\n28\t#   - in-place scatter of only S rows; caches returned as the passed objects.\n29\t# =============================================================================\n30\t\n31\t\n32\tdef _autotune_configs():\n33\t    configs = []\n34\t    for bs in (1, 2, 4, 8, 16, 32):\n35\t        for nw in (1, 2, 4):\n36\t            configs.append(\n37\t                triton.Config({\"BLOCK_S\": bs}, num_warps=nw, num_stages=1)\n38\t            )\n39\t    return configs\n40\t\n41\t\n42\t_CONFIGS = _autotune_configs()\n43\t\n44\t\n45\t@triton.autotune(configs=_CONFIGS, key=[\"S\"])\n46\t@triton.jit\n47\tdef _q_norm_rope_kernel(\n48\t    q_ptr, out_ptr,\n49\t    pos_ptr,\n50\t    w_ptr, inv_freq_ptr,\n51\t    eps,\n52\t    S,\n53\t    stride_qb, stride_qh, stride_qs, stride_qd,\n54\t    stride_ob, stride_oh, stride_os, stride_od,\n55\t    stride_pb, stride_ps,\n56\t    NH: tl.constexpr,\n57\t    BLOCK_S: tl.constexpr,\n58\t    HALF: tl.constexpr,\n59\t    HEAD_DIM: tl.constexpr,\n60\t):\n61\t    pid_bh = tl.program_id(0)\n62\t    pid_s = tl.program_id(1)\n63\t    b = pid_bh // NH\n64\t    h = pid_bh % NH\n65\t\n66\t    s_off = pid_s * BLOCK_S + tl.arange(0, BLOCK_S)\n67\t    s_mask = s_off < S\n68\t    d = tl.arange(0, HALF)  # [HALF]\n69\t\n70\t    q_base = q_ptr + b * stride_qb + h * stride_qh\n71\t    lo_ptr = q_base + s_off[:, None] * stride_qs + d[None, :] * stride_qd\n72\t    hi_ptr = q_base + s_off[:, None] * stride_qs + (d + HALF)[None, :] * stride_qd\n73\t\n74\t    a = tl.load(lo_ptr, mask=s_mask[:, None], other=0.0).to(tl.float32)\n75\t    c = tl.load(hi_ptr, mask=s_mask[:, None], other=0.0).to(tl.float32)\n76\t\n77\t    ssq = tl.sum(a * a, axis=1) + tl.sum(c * c, axis=1)          # [BLOCK_S]\n78\t    inv = tl.rsqrt(ssq / HEAD_DIM + eps)                         # [BLOCK_S]\n79\t\n80\t    w_lo = tl.load(w_ptr + d).to(tl.float32)                    # [HALF]\n81\t    w_hi = tl.load(w_ptr + d + HALF).to(tl.float32)\n82\t\n83\t    an = a * inv[:, None] * w_lo[None, :]\n84\t    cn = c * inv[:, None] * w_hi[None, :]\n85\t\n86\t    pos = tl.load(pos_ptr + b * stride_pb + s_off * stride_ps,\n87\t                  mask=s_mask, other=0).to(tl.float32)          # [BLOCK_S]\n88\t    invf = tl.load(inv_freq_ptr + d)                            # [HALF] fp32\n89\t    theta = pos[:, None] * invf[None, :]                        # [BLOCK_S, HALF]\n90\t    cos = tl.cos(theta)\n91\t    sin = tl.sin(theta)\n92\t\n93\t  