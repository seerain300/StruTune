{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CZxbRDz1FSgHX5WKgpDHi8","type":"tool_result","content":"1\timport torch\n2\timport triton\n3\timport triton.language as tl\n4\t\n5\t\n6\t# =============================================================================\n7\t# L1/018 Fused RoPE + QK-Norm + KV-Cache update  (candidate c001)\n8\t#\n9\t# Option B (see docs/plan.md §3): two Triton kernels.\n10\t#   * Q kernel   : per-head RMS-norm + RoPE -> query_rotated\n11\t#   * K+V kernel : per-head RMS-norm + RoPE on K -> key_rotated + key_cache\n12\t#                  scatter; copy V verbatim -> value_cache scatter.\n13\t#\n14\t# Each program handles one block of BLOCK_S consecutive seq tokens of one\n15\t# (b, head). Row is loaded as two halves [BLOCK_S, HALF] so rotate_half is\n16\t# free (halves-paired RoPE, dim j pairs with j+HALF, shared angle theta_j).\n17\t#\n18\t# Correctness invariants:\n19\t#   - RMS variance accumulated in fp32, divided by HEAD_DIM, +eps inside rsqrt.\n20\t#   - weight applied as weight.float() * xn, rounded to bf16 on store.\n21\t#   - RoPE halves-paired (j, j+64); position_ids drives the angle.\n22\t#   - V copied verbatim into value_cache (never normed/roped).\n23\t#   - cache_position drives the cache row; cache offsets computed in int64.\n24\t#   - in-place scatter of only S rows; caches returned as the passed objects.\n25\t# =============================================================================\n26\t\n27\t\n28\t@triton.jit\n29\tdef _q_norm_rope_kernel(\n30\t    q_ptr, out_ptr,\n31\t    pos_ptr,\n32\t    w_ptr, inv_freq_ptr,\n33\t    eps,\n34\t    S,\n35\t    stride_qb, stride_qh, stride_qs, stride_qd,\n36\t    stride_ob, stride_oh, stride_os, stride_od,\n37\t    stride_pb, stride_ps,\n38\t    NH: tl.constexpr,\n39\t    BLOCK_S: tl.constexpr,\n40\t    HALF: tl.constexpr,\n41\t    HEAD_DIM: tl.constexpr,\n42\t):\n43\t    pid_bh = tl.program_id(0)\n44\t    pid_s = tl.program_id(1)\n45\t    b = pid_bh // NH\n46\t    h = pid_bh % NH\n47\t\n48\t    s_off = pid_s * BLOCK_S + tl.arange(0, BLOCK_S)\n49\t    s_mask = s_off < S\n50\t    d = tl.arange(0, HALF)  # [HALF]\n51\t\n52\t    q_base = q_ptr + b * stride_qb + h * stride_qh\n53\t    lo_ptr = q_base + s_off[:, None] * stride_qs + d[None, :] * stride_qd\n54\t    hi_ptr = q_base + s_off[:, None] * stride_qs + (d + HALF)[None, :] * stride_qd\n55\t\n56\t    a = tl.load(lo_ptr, mask=s_mask[:, None], other=0.0).to(tl.float32)\n57\t    c = tl.load(hi_ptr, mask=s_mask[:, None], other=0.0).to(tl.float32)\n58\t\n59\t    ssq = tl.sum(a * a, axis=1) + tl.sum(c * c, axis=1)          # [BLOCK_S]\n60\t    inv = tl.rsqrt(ssq / HEAD_DIM + eps)                         # [BLOCK_S]\n61\t\n62\t    w_lo = tl.load(w_ptr + d).to(tl.float32)                    # [HALF]\n63\t    w_hi = tl.load(w_ptr + d + HALF).to(tl.float32)\n64\t\n65\t    an = a * inv[:, None] * w_lo[None, :]\n66\t    cn = c * inv[:, None] * w_hi[None, :]\n67\t\n68\t    pos = tl.load(pos_ptr + b * stride_pb + s_off * stride_ps,\n69\t                  mask=s_mask, other=0).to(tl.float32)          # [BLOCK_S]\n70\t    invf = tl.load(inv_freq_ptr + d)                            # [HALF] fp32\n71\t    theta = pos[:, None] * invf[None, :]                        # [BLOCK_S, HALF]\n72\t    cos = tl.cos(theta)\n73\t    sin = tl.sin(theta)\n74\t\n75\t    out_lo = an * cos - cn * sin\n76\t    out_hi = cn * cos + an * sin\n77\t\n78\t    o_base = out_ptr + b * stride_ob + h * stride_oh\n79\t    o_lo_ptr = o_base + s_off[:, None] * stride_os + d[None, :] * stride_od\n80\t    o_hi_ptr = o_base + s_off[:, None] * stride_os + (d + HALF)[None, :] * stride_od\n81\t    tl.store(o_lo_ptr, out_lo.to(tl.bfloat16), mask=s_mask[:, None])\n82\t    tl.store(o_hi_ptr, out_hi.to(tl.bfloat16), mask=s_mask[:, None])\n83\t\n84\t\n85\t@triton.jit\n86\tdef _kv_norm_rope_kernel(\n87\t    k_ptr, v_ptr, out_ptr,\n88\t    kcache_ptr, vcache_ptr,\n89\t    pos_ptr, cache_pos_ptr,\n90\t    w_ptr, inv_freq_ptr,\n91\t    eps,\n92\t    S,\n93\t    stride_kb, stride_kh, stride_ks, stride_kd,\n94\t    stride_vb, stride_vh, stride_vs, stride_vd,\n95\t    stride_ob, stride_oh, stride_os, stride_od,\n96\t    stride_kcb, stride_kch, stride_kcp, stride_kcd,\n97\t    stride_vcb, stride_vch, stride_vcp, stride_vcd,\n98\t    stride_pb, stride_ps,\n99\t    stride_cp,\n100\t    NH: tl.constexpr,\n101\t    BLOCK_S: tl.constexpr,\n102\t    HALF: tl.constexpr,\n103\t    HEAD_DIM: tl.constexpr,\n104\t):\n105\t    pid_bh = tl.program_id(0)\n106\t    pid_s = tl.program_id(1)\n107\t    b = pid_bh // NH\n108\t    h = pid_bh % NH\n109\t\n110\t    s_off = pid_s * BLOCK_S + tl.arange(0, BLOCK_S)\n111\t    s_mask = s_off < S\n112\t    d = tl.arange(0, HALF)  # [HALF]\n113\t\n114\t    # --- load K row as two halves ---\n115\t    k_base = k_ptr + b * stride_kb + h * stride_kh\n116\t    k_lo_ptr = k_base + s_off[:, None] * stride_ks + d[None, :] * stride_kd\n117\t    k_hi_ptr = k_base + s_off[:, None] * stride_ks + (d + HALF)[None, :] * stride_kd\n118\t    a = tl.load(k_lo_ptr, mask=s_mask[:, None], other=0.0).to(tl.float32)\n119\t    c = tl.load(k_hi_ptr, mask=s_mask[:, None], other=0.0).to(tl.float32)\n120\t\n121\t    ssq = tl.sum(a * a, axis=1) + tl.sum(c * c, axis=1)\n122\t    inv = tl.rsqrt(ssq / HEAD_DIM + eps)\n123\t\n124\t    w_lo = tl.load(w_ptr + d).to(tl.float32)\n125\t    w_hi = tl.load(w_ptr + d + HALF).to(tl.float32)\n126\t\n127\t    an = a * inv[:, None] * w_lo[None, :]\n128\t    cn = c * inv[:, None] * w_hi[None, :]\n129\t\n130\t    pos = tl.load(pos_ptr + b * stride_pb + s_off * stride_ps,\n131\t                  mask=s_mask, other=0).to(tl.float32)\n132\t    invf = tl.load(inv_freq_ptr + d)\n133\t    theta = pos[:, None] * invf[None, :]\n134\t    cos = tl.cos(theta)\n135\t    sin = tl.sin(theta)\n136\t\n137\t    out_lo = an * cos - cn * sin\n138\t    out_hi = cn * cos + an * sin\n139\t    out_lo_bf = out_lo.to(tl.bfloat16)\n140\t    out_hi_bf = out_hi.to(tl.bfloat16)\n141\t\n142\t    # ---