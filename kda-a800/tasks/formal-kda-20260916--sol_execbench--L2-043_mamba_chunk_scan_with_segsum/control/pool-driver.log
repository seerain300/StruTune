{"type":"assistant","message":{"id":"chatcmpl-b6174c5a-1296-4fb6-bab6-370455d6e383","type":"message","role":"assistant","model":"Claude-Opus-4.8","content":[{"type":"tool_use","id":"toolu_01YaKca4NzWXuSSHwEAVbbtH","name":"Write","input":{"file_path":"/data1/workspace/weihongren/kda-runs/formal-kda-20260916--sol_execbench--L2-043_mamba_chunk_scan_with_segsum/solution/solution.py","content":"\"\"\"L2/043 Mamba-2 chunk scan with segment sum — Triton solution.\n\nCandidate c002: Option-A 4-stage SSD, bf16 tensor-core matmuls (fp32 accumulation).\n\nChange vs c001 (which RUNTIME_ERROR'd on all 5 workloads — a compile/launch failure,\nnot algebra): every ``tl.dot`` now consumes **bf16 operands** with the default fp32\naccumulator, and the ``input_precision=\"ieee\"`` kwarg is removed. This (a) sidesteps any\nkwarg-compat issue on the installed Triton build and (b) halves dot-operand shared memory,\nwhich is the prime suspect for the c001 launch failure (fp32 [64,256]/[256,64] tiles in a\npipelined loop overflow A800 SRAM). ``num_warps``/``num_stages`` are pinned to bound SRAM.\n\nNumerical note: the input tensors are natively bf16, so bf16 tensor-core inputs carry the\nsame operand precision as the reference (which merely upcasts bf16→fp32 losslessly before\nmatmul); products accumulate in fp32. All decays, cumsum, exp arguments, accumulators and\nthe D residual stay in fp32; only ``output``/``final_state`` are cast to bf16 at the end.\n\nStages (all working intermediates in fp32; only output / final_state cast to bf16):\n  K1 chunk_cumsum   : a[t] = cumsum_t A over each chunk, plus a_last = a[Q-1].\n  K2 chunk_state    : states[p,n] = sum_t exp(a_last - a[t]) * X[t,p] * B[t,n].\n  K3 state_passing  : sequential inter-chunk recurrence seeded by initial_states,\n                      new_states[c+1] = exp(a_last(c)) * new_states[c] + states[c];\n                      states_out[c] = new_states[c], final_state = new_states[NC].\n  K4 chunk_scan     : Y = (G∘L)·X  +  exp(a[t])·(C·states_out)  +  D[h]·X\n                      with G[i,j] = C_i·B_j (head-independent), L[i,j]=exp(a[i]-a[j]),\n                      lower-triangular; never materializes [Q,Q] to DRAM.\n\nConstants for this task: H=16, P=64, N=256, n_groups=1, Q(chunk)=256.\nNo Torch/CPU/NumPy computational fallback anywhere: Triton is the only compute path.\n\"\"\"\n\nimport torch\nimport triton\nimport triton.language as tl\n\n\n# ---------------------------------------------------------------------------\n# K1: per-chunk inclusive cumsum of A, and per-chunk total (a_last).\n# ---------------------------------------------------------------------------\n@triton.jit\ndef _cumsum_kernel(\n    A_ptr, acum_ptr, alast_ptr,\n    sA_b, sA_h, sA_l,\n    sac_b, sac_h, sac_c, sac_q,\n    sal_b, sal_h, sal_c,\n    L,\n    Q: tl.constexpr,\n):\n    b = tl.program_id(0)\n    c = tl.program_id(1)\n    h = tl.program_id(2)\n\n    t = tl.arange(0, Q)\n    seq = c * Q + t\n    m = seq < L\n    a = tl.load(A_ptr + b * sA_b + h * sA_h + seq * sA_l, mask=m, other=0.0).to(tl.float32)\n    acum = tl.cumsum(a, axis=0)\n    tl.store(acum_ptr + b * sac_b + h * sac_h + c * sac_c + t * sac_q, acum)\n    last = tl.sum(a, axis=0)\n    tl.store(alast_ptr + b * sal_b + h * sal_h + c * sal_c, last)\n\n\n# ---------------------------------------------------------------------------\n# K2: per-(b,chunk,head) state = sum_t decay_state[t] * X[t,:] outer B[t,:].\n#     grid = (B*NC*H, N // BLOCK_N)\n# ---------------------------------------------------------------------------\n@triton.jit\ndef _chunk_state_kernel(\n    X_ptr, B_ptr, acum_ptr, alast_ptr, states_ptr,\n    sX_b, sX_l, sX_h, sX_p,\n    sB_b, sB_l, sB_n,\n    sac_b, sac_h, sac_c, sac_q,\n    sal_b, sal_h, sal_c,\n    sst_b, sst_c, sst_h, sst_p, sst_n,\n    L, NC, H,\n    Q: tl.constexpr, P: tl.constexpr, N: tl.constexpr, BLOCK_N: tl.constexpr,\n):\n    bch = tl.program_id(0)\n    nblk = tl.program_id(1)\n    b = bch // (NC * H)\n    rem = bch % (NC * H)\n    c = rem // H\n    h = rem % H\n\n    t = tl.arange(0, Q)\n    seq = c * Q + t\n    tmask = seq < L\n    p = tl.arange(0, P)\n    n = nblk * BLOCK_N + tl.arange(0, BLOCK_N)\n\n    acum = tl.load(acum_ptr + b * sac_b + h * sac_h + c * sac_c + t * sac_q).to(tl.float32)\n    alast = tl.load(alast_ptr + b * sal_b + h * sal_h + c * sal_c).to(tl.float32)\n    decay = tl.exp(alast - acum)  # [Q]\n\n    X = tl.load(\n        X_ptr + b * sX_b + seq[:, None] * sX_l + h * sX_h + p[None, :] * sX_p,\n        mask=tmask[:, None], other=0.0,\n    ).to(tl.float32)  # [Q, P]\n    Xd = (X * decay[:, None]).to(tl.bfloat16)  # [Q, P] bf16 (decay applied in fp32)\n\n    Bt = tl.load(\n        B_ptr + b * sB_b + seq[:, None] * sB_l + n[None, :] * sB_n,\n        mask=tmask[:, None], other=0.0,\n    )  # [Q, BLOCK_N] bf16 (native)\n\n    states = tl.dot(tl.trans(Xd), Bt)  # [P, BLOCK_N] fp32 accumulate\n    tl.store(\n        states_ptr + b * sst_b + c * sst_c + h * sst_h + p[:, None] * sst_p + n[None, :] * sst_n,\n        states,\n    )\n\n\n# ---------------------------------------------------------------------------\n# K3: inter-chunk sequential recurrence. grid = (B, H, N // BLOCK_N).\n#     Elementwise in (p, n), so tiling over n is safe.\n# ---------------------------------------------------------------------------\n@triton.jit\ndef _state_passing_kernel(\n    states_ptr, init_ptr, states_out_ptr, final_ptr, alast_ptr,\n    sst_b, sst_c, sst_h, sst_p, sst_n,\n    si_b, si_h, si_p, si_n,\n    so_b, so_c, so_h, so_p, so_n,\n    sf_b, sf_h, sf_p, sf_n,\n    sal_b, sal_h, sal_c,\n    NC, H,\n    P: tl.constexpr, N: tl.constexpr, BLOCK_N: tl.constexpr,\n):\n    b = tl.program_id(0)\n    h = tl.program_id(1)\n    nblk = tl.program_id(2)\n\n    p = tl.arange(0, P)\n    n = nblk * BLOCK_N + tl.arange(0, BLOCK_N)\n\n    state = tl.load(\n        init_ptr + b * si_b + h * si_h + p[:, None] * si_p + n[None, :] * si_n\n    ).to(tl.float32)  # [P, BLOCK_N]\n\n    for c in range(0, NC):\n        tl.store(\n            states_out_ptr + b * so_b + c * so_c + h * so_h + p[:, None] * so_p + n[None, :] * so_n,\n            state,\n        )\n        alast = tl.load(alast_ptr + b * sal_b + h * sal_h + c * sal_c).to(tl.float32)\n        g = tl.exp(alast)\n        st = tl.load(\n            states_ptr + b * sst_b + c * sst_c + h * sst_h + p[:, None] * sst_p + n[None, :] * sst_n\n        ).to(tl.float32)\n        state = g * state + st\n\n    tl.store(\n        final_ptr + b * sf_b + h * sf_h + p[:, None] * sf_p + n[None, :] * sf_n,\n        state.to(tl.bfloat16),\n    )\n\n\n# ---------------------------------------------------------------------------\n# K4: chunk scan. grid = (B*NC*H, Q // BLOCK_M).\n# ---------------------------------------------------------------------------\n@triton.jit\ndef _chunk_scan_kernel(\n    C_ptr, B_ptr, X_ptr, acum_ptr, states_out_ptr, D_ptr, out_ptr,\n    sC_b, sC_l, sC_n,\n    sB_b, sB_l, sB_n,\n    sX_b, sX_l, sX_h, sX_p,\n    sac_b, sac_h, sac_c, sac_q,\n    so_b, so_c, so_h, so_p, so_n,\n    sD_h,\n    sout_b, sout_l, sout_hp,\n    L, NC, H,\n    Q: tl.constexpr, P: tl.constexpr, N: tl.constexpr, BLOCK_M: tl.constexpr,\n):\n    bch = tl.program_id(0)\n    iblk = tl.program_id(1)\n    b = bch // (NC * H)\n    rem = bch % (NC * H)\n    c = rem // H\n    h = rem % H\n\n    im = iblk * BLOCK_M + tl.arange(0, BLOCK_M)  # chunk-local query rows\n    seq_i = c * Q + im\n    imask = seq_i < L\n    nidx = tl.arange(0, N)\n    pidx = tl.arange(0, P)\n\n    a_i = tl.load(acum_ptr + b * sac_b + h * sac_h + c * sac_c + im * sac_q).to(tl.float32)  # [BLOCK_M]\n    C_i = tl.load(\n        C_ptr + b * sC_b + seq_i[:, None] * sC_l + nidx[None, :] * sC_n,\n        mask=imask[:, None], other=0.0,\n    )  # [BLOCK_M, N] bf16\n\n    acc = tl.zeros((BLOCK_M, P), dtype=tl.float32)\n\n    for jblk in range(0, iblk + 1):\n        jm = jblk * BLOCK_M + tl.arange(0, BLOCK_M)\n        seq_j = c * Q + jm\n        jmask = seq_j < L\n        a_j = tl.load(acum_ptr + b * sac_b + h * sac_h + c * sac_c + jm * sac_q).to(tl.float32)\n        B_j = tl.load(\n            B_ptr + b * sB_b + seq_j[:, None] * sB_l + nidx[None, :] * sB_n,\n            mask=jmask[:, None], other=0.0,\n        )  # [BLOCK_M, N] bf16\n        X_j = tl.load(\n            X_ptr + b * sX_b + seq_j[:, None] * sX_l + h * sX_h + pidx[None, :] * sX_p,\n            mask=jmask[:, None], other=0.0,\n        )  # [BLOCK_M, P] bf16\n\n        G = tl.dot(C_i, tl.trans(B_j))  # [BLOCK_M, BLOCK_M] fp32\n        diff = a_i[:, None] - a_j[None, :]\n        cmask = im[:, None] >= jm[None, :]\n        Lm = tl.where(cmask, tl.exp(diff), 0.0)\n        M = (G * Lm).to(tl.bfloat16)\n        acc += tl.dot(M, X_j)\n\n    states_o = tl.load(\n        states_out_ptr + b * so_b + c * so_c + h * so_h + pidx[:, None] * so_p + nidx[None, :] * so_n\n    ).to(tl.bfloat16)  # [P, N]\n    Cstate = tl.dot(C_i, tl.trans(states_o))  # [BLOCK_M, P] fp32\n    a_i_exp = tl.exp(a_i)\n    Y = acc + a_i_exp[:, None] * Cstate\n\n    X_i = tl.load(\n        X_ptr + b * sX_b + seq_i[:, None] * sX_l + h * sX_h + pidx[None, :] * sX_p,\n        mask=imask[:, None], other=0.0,\n    ).to(tl.float32)\n    Dh = tl.load(D_ptr + h * sD_h).to(tl.float32)\n    Y = Y + Dh * X_i\n\n    out_off = out_ptr + b * sout_b + seq_i[:, None] * sout_l + (h * P + pidx[None, :]) * sout_hp\n    tl.store(out_off, Y.to(tl.bfloat16), mask=imask[:, None])\n\n\n# ---------------------------------------------------------------------------\n# Host entry point.\n# ---------------------------------------------------------------------------\n@torch.no_grad()\ndef run(hidden_states, A, B, C, D, initial_states):\n    Bb, L, H, P = hidden_states.shape\n    N = 256\n    Q = 256\n    device = hidden_states.device\n\n    pad = (Q - L % Q) % Q\n    L_pad = L + pad\n    NC = L_pad // Q\n\n    BLOCK_M = 64\n    BLOCK_N = 64\n\n    acum = torch.empty((Bb, H, NC, Q), dtype=torch.float32, device=device)\n    alast = torch.empty((Bb, H, NC), dtype=torch.float32, device=device)\n    states = torch.empty((Bb, NC, H, P, N), dtype=torch.float32, device=device)\n    states_out = torch.empty((Bb, NC, H, P, N), dtype=torch.float32, device=device)\n    final_state = torch.empty((Bb, H, P, N), dtype=torch.bfloat16, device=device)\n    output = torch.empty((Bb, L, H * P), dtype=torch.bfloat16, device=device)\n\n    # strides\n    sA_b, sA_h, sA_l = A.stride(0), A.stride(1), A.stride(2)\n    sX_b, sX_l, sX_h, sX_p = hidden_states.stride()\n    sB_b, sB_l, sB_n = B.stride(0), B.stride(1), B.stride(3)\n    sC_b, sC_l, sC_n = C.stride(0), C.stride(1), C.stride(3)\n    sD_h = D.stride(0)\n    si_b, si_h, si_p, si_n = initial_states.stride()\n\n    sac_b, sac_h, sac_c, sac_q = acum.stride()\n    sal_b, sal_h, sal_c = alast.stride()\n    sst_b, sst_c, sst_h, sst_p, sst_n = states.stride()\n    so_b, so_c, so_h, so_p, so_n = states_out.stride()\n    sf_b, sf_h, sf_p, sf_n = final_state.stride()\n    sout_b, sout_l, sout_hp = output.stride()\n\n    # K1: cumsum\n    _cumsum_kernel[(Bb, NC, H)](\n        A, acum, alast,\n        sA_b, sA_h, sA_l,\n        sac_b, sac_h, sac_c, sac_q,\n        sal_b, sal_h, sal_c,\n        L,\n        Q=Q, num_warps=4,\n    )\n\n    # K2: chunk_state\n    _chunk_state_kernel[(Bb * NC * H, N // BLOCK_N)](\n        hidden_states, B, acum, alast, states,\n        sX_b, sX_l, sX_h, sX_p,\n        sB_b, sB_l, sB_n,\n        sac_b, sac_h, sac_c, sac_q,\n        sal_b, sal_h, sal_c,\n        sst_b, sst_c, sst_h, sst_p, sst_n,\n        L, NC, H,\n        Q=Q, P=P, N=N, BLOCK_N=BLOCK_N, num_warps=4, num_stages=2,\n    )\n\n    # K3: state_passing\n    _state_passing_kernel[(Bb, H, N // BLOCK_N)](\n        states, initial_states, states_out, final_state, alast,\n        sst_b, sst_c, sst_h, sst_p, sst_n,\n        si_b, si_h, si_p, si_n,\n        so_b, so_c, so_h, so_p, so_n,\n        sf_b, sf_h, sf_p, sf_n,\n        sal_b, sal_h, sal_c,\n        NC, H,\n        P=P, N=N, BLOCK_N=BLOCK_N, num_warps=4,\n    )\n\n    # K4: chunk_scan\n    _chunk_scan_kernel[(Bb * NC * H, Q // BLOCK_M)](\n        C, B, hidden_states, acum, states_out, D, output,\n        sC_b, sC_l, sC_n,\n        sB_b, sB_l, sB_n,\n        sX_b, sX_l, sX_h, sX_p,\n        sac_b, sac_h, sac_c, sac_q,\n        so_b, so_c, so_h, so_p, so_n,\n        sD_h,\n        sout_b, sout_l, sout_hp,\n        L, NC, H,\n        Q=Q, P=P, N=N, BLOCK_M=BLOCK_M, num_warps=4, num_stages=2,\n    )\n\n    return output, final_state\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":96140,"cache_creation_input_tokens":0,"cache_read_input_tokens":4871,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"f6fba2c0-4823-4806-9479-4c36036ed424","uuid":"f62b5dc0-1827-45f5-b57a-1e08b9d1ab8b","timestamp":"2026-09-17T20:52:24.528Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YaKca4NzWXuSSHwEAVbbtH","type":"tool_result","content":"The file /data1/workspace/weihongren/kda-runs/formal-kda-20260916--sol_execbench--L2-043_mamba_chunk_scan_with_segsum/solution/solution.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"f6fba2c0-4823-4806-9479-4c36036ed424","uuid":"8a0971c5-d320-49a7-9fa0-82bf1f20bd17","timestamp":"2026-09-17T20:52:24.544Z","tool_use_result":{"type":"update","filePath":"/data1/workspace/weihongren/kda-runs/formal-kda-20260916--sol_execbench--L2-043_mamba_chunk_scan_with_segsum/solution/solution.py","content":"\"\"\"L2/043 Mamba-2 chunk scan with segment sum — Triton solution.\n\nCandidate c002: Option-A 4-stage SSD, bf16 tensor-core matmuls (fp32 accumulation).\n\nChange vs c001 (which RUNTIME_ERROR'd on all 5 workloads — a compile/launch failure,\nnot algebra): every ``tl.dot`` now consumes **bf16 operands** with the default fp32\naccumulator, and the ``input_precision=\"ieee\"`` kwarg is removed. This (a) sidesteps any\nkwarg-compat issue on the installed Triton build and (b) halves dot-operand shared memory,\nwhich is the prime suspect for the c001 launch failure (fp32 [64,256]/[256,64] tiles in a\npipelined loop overflow A800 SRAM). ``num_warps``/``num_stages`` are pinned to bound SRAM.\n\nNumerical note: the input tensors are natively bf16, so bf16 tensor-core inputs carry the\nsame operand precision as the reference (which merely upcasts bf16→fp32 losslessly before\nmatmul); products accumulate in fp32. All decays, cumsum, exp arguments, accumulators and\nthe D residual stay in fp32; only ``output``/``final_state`` are cast to bf16 at the end.\n\nStages (all working intermediates in fp32; only output / final_state cast to bf16):\n  K1 chunk_cumsum   : a[t] = cumsum_t A over each chunk, plus a_last = a[Q-1].\n  K2 chunk_state    : states[p,n] = sum_t exp(a_last - a[t]) * X[t,p] * B[t,n].\n  K3 state_passing  : sequential inter-chunk recurrence seeded by initial_states,\n                      new_states[c+1] = exp(a_last(c)) * new_states[c] + states[c];\n                      states_out[c] = new_states[c], final_state = new_states[NC].\n  K4 chunk_scan     : Y = (G∘L)·X  +  exp(a[t])·(C·states_out)  +  D[h]·X\n                      with G[i,j] = C_i·B_j (head-independent), L[i,j]=exp(a[i]-a[j]),\n                      lower-triangular; never materializes [Q,Q] to DRAM.\n\nConstants for this task: H=16, P=64, N=256, n_groups=1, Q(chunk)=256.\nNo Torch/CPU/NumPy computational fallback anywhere: Triton is the only compute path.\n\"\"\"\n\nimport torch\nimport triton\nimport triton.language as tl\n\n\n# ---------------------------------------------------------------------------\n# K1: per-chunk inclusive cumsum of A, and per-chunk total (a_last).\n# ---------------------------------------------------------------------------\n@triton.jit\ndef _cumsum_kernel(\n    A_ptr, acum_ptr, alast_ptr,\n    sA_b, sA_h, sA_l,\n    sac_b, sac_h, sac_c, sac_q,\n    sal_b, sal_h, sal_c,\n    L,\n    Q: tl.constexpr,\n):\n    b = tl.program_id(0)\n    c = tl.program_id(1)\n    h = tl.program_id(2)\n\n    t = tl.arange(0, Q)\n    seq = c * Q + t\n    m = seq < L\n    a = tl.load(A_ptr + b * sA_b + h * sA_h + seq * sA_l, mask=m, other=0.0).to(tl.float32)\n    acum = tl.cumsum(a, axis=0)\n    tl.store(acum_ptr + b * sac_b + h * sac_h + c * sac_c + t * sac_q, acum)\n    last = tl.sum(a, axis=0)\n    tl.store(alast_ptr + b * sal_b + h * sal_h + c * sal_c, last)\n\n\n# ---------------------------------------------------------------------------\n# K2: per-(b,chunk,head) state = sum_t decay_state[t] * X[t,:] outer B[t,:].\n#     grid = (B*NC*H, N // BLOCK_N)\n# ---------------------------------------------------------------------------\n@triton.jit\ndef _chunk_state_kernel(\n    X_ptr, B_ptr, acum_ptr, alast_ptr, states_ptr,\n    sX_b, sX_l, sX_h, sX_p,\n    sB_b, sB_l, sB_n,\n    sac_b, sac_h, sac_c, sac_q,\n    sal_b, sal_h, sal_c,\n    sst_b, sst_c, sst_h, sst_p, sst_n,\n    L, NC, H,\n    Q: tl.constexpr, P: tl.constexpr, N: tl.constexpr, BLOCK_N: tl.constexpr,\n):\n    bch = tl.program_id(0)\n    nblk = tl.program_id(1)\n    b = bch // (NC * H)\n    rem = bch % (NC * H)\n    c = rem // H\n    h = rem % H\n\n    t = tl.arange(0, Q)\n    seq = c * Q + t\n    tmask = seq < L\n    p = tl.arange(0, P)\n    n = nblk * BLOCK_N + tl.arange(0, BLOCK_N)\n\n    acum = tl.load(acum_ptr + b * sac_b + h * sac_h + c * sac_c + t * sac_q).to(tl.float32)\n    alast = tl.load(alast_ptr + b * sal_b + h * sal_h + c * sal_c).to(tl.float32)\n    decay = tl.exp(alast - acum)  # [Q]\n\n    X = tl.load(\n        X_ptr + b * sX_b + seq[:, None] * sX_l + h * sX_h + p[None, :] * sX_p,\n        mask=tmask[:, None], other=0.0,\n    ).to(tl.float32)  # [Q, P]\n    Xd = (X * decay[:, None]).to(tl.bfloat16)  # [Q, P] bf16 (decay applied in fp32)\n\n    Bt = tl.load(\n        B_ptr + b * sB_b + seq[:, None] * sB_l + n[None, :] * sB_n,\n        mask=tmask[:, None], other=0.0,\n    )  # [Q, BLOCK_N] bf16 (native)\n\n    states = tl.dot(tl.trans(Xd), Bt)  # [P, BLOCK_N] fp32 accumulate\n    tl.store(\n        states_ptr + b * sst_b + c * sst_c + h * sst_h + p[:, None] * sst_p + n[None, :] * sst_n,\n        states,\n    )\n\n\n# ---------------------------------------------------------------------------\n# K3: inter-chunk sequential recurrence. grid = (B, H, N // BLOCK_N).\n#     Elementwise in (p, n), so tiling over n is safe.\n# ---------------------------------------------------------------------------\n@triton.jit\ndef _state_passing_kernel(\n    states_ptr, init_ptr, states_out_ptr, final_ptr, alast_ptr,\n    sst_b, sst_c, sst_h, sst_p, sst_n,\n    si_b, si_h, si_p, si_n,\n    so_b, so_c, so_h, so_p, so_n,\n    sf_b, sf_h, sf_p, sf_n,\n    sal_b, sal_h, sal_c,\n    NC, H,\n    P: tl.constexpr, N: tl.constexpr, BLOCK_N: tl.constexpr,\n):\n    b = tl.program_id(0)\n    h = tl.program_id(1)\n    nblk = tl.program_id(2)\n\n    p = tl.arange(0, P)\n    n = nblk * BLOCK_N + tl.arange(0, BLOCK_N)\n\n    state = tl.load(\n        init_ptr + b * si_b + h * si_h + p[:, None] * si_p + n[None, :] * si_n\n    ).to(tl.float32)  # [P, BLOCK_N]\n\n    for c in range(0, NC):\n        tl.store(\n            states_out_ptr + b * so_b + c * so_c + h * so_h + p[:, None] * so_p + n[None, :] * so_n,\n            state,\n        )\n        alast = tl.load(alast_ptr + b * sal_b + h * sal_h + c * sal_c).to(tl.float32)\n        g = tl.exp(alast)\n        st = tl.load(\n            states_ptr + b * sst_b + c * sst_c + h * sst_h + p[:, None] * sst_p + n[None, :] * sst_n\n        ).to(tl.float32)\n        state = g * state + st\n\n    tl.store(\n        final_ptr + b * sf_b + h * sf_h + p[:, None] * sf_p + n[None, :] * sf_n,\n        state.to(tl.bfloat16),\n    )\n\n\n# ---------------------------------------------------------------------------\n# K4: chunk scan. grid = (B*NC*H, Q // BLOCK_M).\n# ---------------------------------------------------------------------------\n@triton.jit\ndef _chunk_scan_kernel(\n    C_ptr, B_ptr, X_ptr, acum_ptr, states_out_ptr, D_ptr, out_ptr,\n    sC_b, sC_l, sC_n,\n    sB_b, sB_l, sB_n,\n    sX_b, sX_l, sX_h, sX_p,\n    sac_b, sac_h, sac_c, sac_q,\n    so_b, so_c, so_h, so_p, so_n,\n    sD_h,\n    sout_b, sout_l, sout_hp,\n    L, NC, H,\n    Q: tl.constexpr, P: tl.constexpr, N: tl.constexpr, BLOCK_M: tl.constexpr,\n):\n    bch = tl.program_id(0)\n    iblk = tl.program_id(1)\n    b = bch // (NC * H)\n    rem = bch % (NC * H)\n    c = rem // H\n    h = rem % H\n\n    im = iblk * BLOCK_M + tl.arange(0, BLOCK_M)  # chunk-local query rows\n    seq_i = c * Q + im\n    imask = seq_i < L\n    nidx = tl.arange(0, N)\n    pidx = tl.arange(0, P)\n\n    a_i = tl.load(acum_ptr + b * sac_b + h * sac_h + c * sac_c + im * sac_q).to(tl.float32)  # [BLOCK_M]\n    C_i = tl.load(\n        C_ptr + b * sC_b + seq_i[:, None] * sC_l + nidx[None, :] * sC_n,\n        mask=imask[:, None], other=0.0,\n    )  # [BLOCK_M, N] bf16\n\n    acc = tl.zeros((BLOCK_M, P), dtype=tl.float32)\n\n    for jblk in range(0, iblk + 1):\n        jm = jblk * BLOCK_M + tl.arange(0, BLOCK_M)\n        seq_j = c * Q + jm\n        jmask = seq_j < L\n        a_j = tl.load(acum_ptr + b * sac_b + h * sac_h + c * sac_c + jm * sac_q).to(tl.float32)\n        B_j = tl.load(\n            B_ptr + b * sB_b + seq_j[:, None] * sB_l + nidx[None, :] * sB_n,\n            mask=jmask[:, None], other=0.0,\n        )  # [BLOCK_M, N] bf16\n        X_j = tl.load(\n            X_ptr + b * sX_b + seq_j[:, None] * sX_l + h * sX_h + pidx[None, :] * sX_p,\n            mask=jmask[:, None], other=0.0,\n        )  # [BLOCK_M, P] bf16\n\n        G = tl.dot(C_i, tl.trans(B_j))  # [BLOCK_M, BLOCK_M] fp32\n        diff = a_i[:, None] - a_j[None, :]\n        cmask = im[:, None] >= jm[None, :]\n        Lm = tl.where(cmask, tl.exp(diff), 0.0)\n        M = (G * Lm).to(tl.bfloat16)\n        acc += tl.dot(M, X_j)\n\n    states_o = tl.load(\n        states_out_ptr + b * so_b + c * so_c + h * so_h + pidx[:, None] * so_p + nidx[None, :] * so_n\n    ).to(tl.bfloat16)  # [P, N]\n    Cstate = tl.dot(C_i, tl.trans(states_o))  # [BLOCK_M, P] fp32\n    a_i_exp = tl.exp(a_i)\n    Y = acc + a_i_exp[:, None] * Cstate\n\n    X_i = tl.load(\n        X_ptr + b * sX_b + seq_i[:, None] * sX_l + h * sX_h + pidx[None, :] * sX_p,\n        mask=imask[:, None], other=0.0,\n    ).to(tl.float32)\n    Dh = tl.load(D_ptr + h * sD_h).to(tl.float32)\n    Y = Y + Dh * X_i\n\n    out_off = out_ptr + b * sout_b + seq_i[:, None] * sout_l + (h * P + pidx[None, :]) * sout_hp\n    tl.store(out_off, Y.to(tl.bfloat16), mask=imask[:, None])\n\n\n# ---------------------------------------------------------------------------\n# Host entry point.\n# ---------------------------------------------------------------------------\n@torch.no_grad()\ndef run(hidden_states, A, B, C, D, initial_states):\n    Bb, L, H, P = hidden_states.shape\n    N = 256\n    Q = 256\n    device = hidden_states.device\n\n    pad = (Q - L % Q) % Q\n    L_pad = L + pad\n    NC = L_pad // Q\n\n    BLOCK_M = 64\n    BLOCK_N = 64\n\n    acum = torch.empty((Bb, H, NC, Q), dtype=torch.float32, device=device)\n    alast = torch.empty((Bb, H, NC), dtype=torch.float32, device=device)\n    states = torch.empty((Bb, NC, H, P, N), dtype=torch.float32, device=device)\n    states_out = torch.empty((Bb, NC, H, P, N), dtype=torch.float32, device=device)\n    final_state = torch.empty((Bb, H, P, N), dtype=torch.bfloat16, device=device)\n    output = torch.empty((Bb, L, H * P), dtype=torch.bfloat16, device=device)\n\n    # strides\n    sA_b, sA_h, sA_l = A.stride(0), A.stride(1), A.stride(2)\n    sX_b, sX_l, sX_h, sX_p = hidden_states.stride()\n    sB_b, sB_l, sB_n = B.stride(0), B.stride(1), B.stride(3)\n    sC_b, sC_l, sC_n = C.stride(0), C.stride(1), C.stride(3)\n    sD_h = D.stride(0)\n    si_b, si_h, si_p, si_n = initial_states.stride()\n\n    sac_b, sac_h, sac_c, sac_q = acum.stride()\n    sal_b, sal_h, sal_c = alast.stride()\n    sst_b, sst_c, sst_h, sst_p, sst_n = states.stride()\n    so_b, so_c, so_h, so_p, so_n = states_out.stride()\n    sf_b, sf_h, sf_p, sf_n = final_state.stride()\n    sout_b, sout_l, sout_hp = output.stride()\n\n    # K1: cumsum\n    _cumsum_kernel[(Bb, NC, H)](\n        A, acum, alast,\n        sA_b, sA_h, sA_l,\n        sac_b, sac_h, sac_c, sac_q,\n        sal_b, sal_h, sal_c,\n        L,\n        Q=Q, num_warps=4,\n    )\n\n    # K2: chunk_state\n    _chunk_state_kernel[(Bb * NC * H, N // BLOCK_N)](\n        hidden_states, B, acum, alast, states,\n        sX_b, sX_l, sX_h, sX_p,\n        sB_b, sB_l, sB_n,\n        sac_b, sac_h, sac_c, sac_q,\n        sal_b, sal_h, sal_c,\n        sst_b, sst_c, sst_h, sst_p, sst_n,\n        L, NC, H,\n        Q=Q, P=P, N=N, BLOCK_N=BLOCK_N, num_warps=4, num_stages=2,\n    )\n\n    # K3: state_passing\n    _state_passing_kernel[(Bb, H, N // BLOCK_N)](\n        states, initial_states, states_out, final_state, alast,\n        sst_b, sst_c, sst_h, sst_p, sst_n,\n        si_b, si_h, si_p, si_n,\n        so_b, so_c, so_h, so_p, so_n,\n        sf_b, sf_h, sf_p, sf_n,\n        sal_b, sal_h, sal_c,\n        NC, H,\n        P=P, N=N, BLOCK_N=BLOCK_N, num_warps=4,\n    )\n\n    # K4: chunk_scan\n    _chunk_scan_kernel[(Bb * NC * H, Q // BLOCK_M)](\n        C, B, hidden_states, acum, states_out, D, output,\n        sC_b, sC_l, sC_n,\n        sB_b, sB_l, sB_n,\n        sX_b, sX_l, sX_h, sX_p,\n        sac_b, sac_h, sac_c, sac_q,\n        so_b, so_c, so_h, so_p, so_n,\n        sD_h,\n        sout_b, sout_l, sout_hp,\n        L, NC, H,\n        Q=Q, P=P, N=N, BLOCK_M=BLOCK_M, num_warps=4, num_stages=2,\n    )\n\n    return output, final_state\n","structuredPatch":[{"oldStart":1,"oldLines":32,"newStart":1,"newLines":28,"lines":[" \"\"\"L2/043 Mamba-2 chunk scan with segment sum — Triton solution."," ","-Candidate c003: head-shared G reuse (n_groups=1) — precompute G = C·Bᵀ once per","-(b, chunk) in a dedicated kernel and reuse it across all 16 heads in K4.","+Candidate c002: Option-A 4-stage SSD, bf16 tensor-core matmuls (fp32 accumulation)."," ","-Motivation (vs c002, which passes 5/5 at geomean 10.64x): a roofline check shows the","-c002 kernel runs ~7x above the A800 bf16 compute roofline and ~20x above the DRAM floor,","-i.e. it is compute-bound, not memory-bound. The G = C·Bᵀ matmul contracts over N=256 and","-is ~50% of the total matmul FLOPs, yet it is head-independent (B and C are shared across","-all H=16 heads because n_groups=1) and c002 recomputes it 16x redundantly inside K4. This","-candidate computes G exactly once per (b,chunk) in kernel ``Kg`` and stores it to DRAM","-(fp32, to reproduce c002's exact diagonal numerics: G was fp32 before the elementwise L","-multiply). K4 then loads the G tile instead of recomputing it, which also removes the","-per-head C/B loads that fed the G dot. Total matmul FLOPs drop ~2x; the extra G tensor is","-tiny (<=4 MB) and its read traffic stays far below the DRAM roofline.","+Change vs c001 (which RUNTIME_ERROR'd on all 5 workloads — a compile/launch failure,","+not algebra): every ``tl.dot`` now consumes **bf16 operands** with the default fp32","+accumulator, and the ``input_precision=\"ieee\"`` kwarg is removed. This (a) sidesteps any","+kwarg-compat issue on the installed Triton build and (b) halves dot-operand shared memory,","+which is the prime suspect for the c001 launch failure (fp32 [64,256]/[256,64] tiles in a","+pipelined loop overflow A800 SRAM). ``num_warps``/``num_stages`` are pinned to bound SRAM."," ","-Numerics are preserved bit-for-bit relative to c002 for the diagonal term: G stored in","-fp32, multiplied by the fp32 lower-triangular decay L, then cast to bf16 for the M·X dot.","-All decays / cumsum / exp / accumulators / D residual stay in fp32; bf16 only for","-tensor-core operands and the final output / final_state casts.","+Numerical note: the input tensors are natively bf16, so bf16 tensor-core inputs carry the","+same operand precision as the reference (which merely upcasts bf16→fp32 losslessly before","+matmul); products accumulate in fp32. All decays, cumsum, exp arguments, accumulators and","+the D residual stay in fp32; only ``output``/``final_state`` are cast to bf16 at the end."," "," Stages (all working intermediates in fp32; only output / final_state cast to bf16):","   K1 chunk_cumsum   : a[t] = cumsum_t A over each chunk, plus a_last = a[Q-1].","-  Kg chunk_G        : G[i,j] = sum_s C[i,s]*B[j,s]  (head-independent), fp32, lower blocks.","   K2 chunk_state    : states[p,n] = sum_t exp(a_last - a[t]) * X[t,p] * B[t,n].","   K3 state_passing  : sequential inter-chunk recurrence seeded by initial_states,","                       new_states[c+1] = exp(a_last(c)) * new_states[c] + states[c];","                       states_out[c] = new_states[c], final_state = new_states[NC].","-  K4 chunk_scan     : Y = (G∘L)·X  +  exp(a[t])·(C·states_out)  +  D[h]·X, G loaded from Kg.","+  K4 chunk_scan     : Y = (G∘L)·X  +  exp(a[t])·(C·states_out)  +  D[h]·X","+                      with G[i,j] = C_i·B_j (head-independent), L[i,j]=exp(a[i]-a[j]),","+                      lower-triangular; never materializes [Q,Q] to DRAM."," "," Constants for this task: H=16, P=64, N=256, n_groups=1, Q(chunk)=256."," No Torch/CPU/NumPy computational fallback anywhere: Triton is the only compute path."]},{"oldStart":64,"oldLines":50,"newStart":60,"newLines":6,"lines":[" "," "," # ---------------------------------------------------------------------------","-# Kg: head-shared G = C·Bᵀ per (b, chunk). grid = (B*NC, Q // BLOCK_M).","-#     Stores only lower-triangular blocks (jblk <= iblk); upper blocks are","-#     never read by K4 so they are left untouched.","-# ---------------------------------------------------------------------------","-@triton.jit","-def _chunk_G_kernel(","-    C_ptr, B_ptr, G_ptr,","-    sC_b, sC_l, sC_n,","-    sB_b, sB_l, sB_n,","-    sG_b, sG_c, sG_i, sG_j,","-    L, NC,","-    Q: tl.constexpr, N: tl.constexpr, BLOCK_M: tl.constexpr,","-):","-    bc = tl.program_id(0)","-    iblk = tl.program_id(1)","-    b = bc // NC","-    c = bc % NC","-","-    im = iblk * BLOCK_M + tl.arange(0, BLOCK_M)","-    seq_i = c * Q + im","-    imask = seq_i < L","-    nidx = tl.arange(0, N)","-","-    C_i = tl.load(","-        C_ptr + b * sC_b + seq_i[:, None] * sC_l + nidx[None, :] * sC_n,","-        mask=imask[:, None], other=0.0,","-    )  # [BLOCK_M, N] bf16","-","-    for jblk in range(0, iblk + 1):","-        jm = jblk * BLOCK_M + tl.arange(0, BLOCK_M)","-        seq_j = c * Q + jm","-        jmask = seq_j < L","-        B_j = tl.load(","-            B_ptr + b * sB_b + seq_j[:, None] * sB_l + nidx[None, :] * sB_n,","-            mask=jmask[:, None], other=0.0,","-        )  # [BLOCK_M, N] bf16","-        G = tl.dot(C_i, tl.trans(B_j))  # [BLOCK_M, BLOCK_M] fp32","-        tl.store(","-            G_ptr + b * sG_b + c * sG_c + im[:, None] * sG_i + jm[None, :] * sG_j,","-            G,","-        )","-","-","-# ---------------------------------------------------------------------------"," # K2: per-(b,chunk,head) state = sum_t decay_state[t] * X[t,:] outer B[t,:]."," #     grid = (B*NC*H, N // BLOCK_N)"," # ---------------------------------------------------------------------------"]},{"oldStart":202,"oldLines":14,"newStart":154,"newLines":14,"lines":[" "," "," # ---------------------------------------------------------------------------","-# K4: chunk scan. grid = (B*NC*H, Q // BLOCK_M). Loads head-shared G from Kg.","+# K4: chunk scan. grid = (B*NC*H, Q // BLOCK_M)."," # ---------------------------------------------------------------------------"," @triton.jit"," def _chunk_scan_kernel(","-    C_ptr, X_ptr, G_ptr, acum_ptr, states_out_ptr, D_ptr, out_ptr,","+    C_ptr, B_ptr, X_ptr, acum_ptr, states_out_ptr, D_ptr, out_ptr,","     sC_b, sC_l, sC_n,","+    sB_b, sB_l, sB_n,","     sX_b, sX_l, sX_h, sX_p,","-    sG_b, sG_c, sG_i, sG_j,","     sac_b, sac_h, sac_c, sac_q,","     so_b, so_c, so_h, so_p, so_n,","     sD_h,"]},{"oldStart":231,"oldLines":6,"newStart":183,"newLines":10,"lines":["     pidx = tl.arange(0, P)"," ","     a_i = tl.load(acum_ptr + b * sac_b + h * sac_h + c * sac_c + im * sac_q).to(tl.float32)  # [BLOCK_M]","+    C_i = tl.load(","+        C_ptr + b * sC_b + seq_i[:, None] * sC_l + nidx[None, :] * sC_n,","+        mask=imask[:, None], other=0.0,","+    )  # [BLOCK_M, N] bf16"," ","     acc = tl.zeros((BLOCK_M, P), dtype=tl.float32)"," "]},{"oldStart":239,"oldLines":24,"newStart":195,"newLines":22,"lines":["         seq_j = c * Q + jm","         jmask = seq_j < L","         a_j = tl.load(acum_ptr + b * sac_b + h * sac_h + c * sac_c + jm * sac_q).to(tl.float32)","-        G = tl.load(","-            G_ptr + b * sG_b + c * sG_c + im[:, None] * sG_i + jm[None, :] * sG_j","-        )  # [BLOCK_M, BLOCK_M] fp32 (head-shared, precomputed by Kg)","+        B_j = tl.load(","+            B_ptr + b * sB_b + seq_j[:, None] * sB_l + nidx[None, :] * sB_n,","+            mask=jmask[:, None], other=0.0,","+        )  # [BLOCK_M, N] bf16","         X_j = tl.load(","             X_ptr + b * sX_b + seq_j[:, None] * sX_l + h * sX_h + pidx[None, :] * sX_p,","             mask=jmask[:, None], other=0.0,","         )  # [BLOCK_M, P] bf16"," ","+        G = tl.dot(C_i, tl.trans(B_j))  # [BLOCK_M, BLOCK_M] fp32","         diff = a_i[:, None] - a_j[None, :]","         cmask = im[:, None] >= jm[None, :]","         Lm = tl.where(cmask, tl.exp(diff), 0.0)","         M = (G * Lm).to(tl.bfloat16)","         acc += tl.dot(M, X_j)"," ","-    C_i = tl.load(","-        C_ptr + b * sC_b + seq_i[:, None] * sC_l + nidx[None, :] * sC_n,","-        mask=imask[:, None], other=0.0,","-    )  # [BLOCK_M, N] bf16","     states_o = tl.load(","         states_out_ptr + b * so_b + c * so_c + h * so_h + pidx[:, None] * so_p + nidx[None, :] * so_n","     ).to(tl.bfloat16)  # [P, N]"]},{"oldStart":294,"oldLines":7,"newStart":248,"newLines":6,"lines":[" ","     acum = torch.empty((Bb, H, NC, Q), dtype=torch.float32, device=device)","     alast = torch.empty((Bb, H, NC), dtype=torch.float32, device=device)","-    Gmat = torch.empty((Bb, NC, Q, Q), dtype=torch.float32, device=device)","     states = torch.empty((Bb, NC, H, P, N), dtype=torch.float32, device=device)","     states_out = torch.empty((Bb, NC, H, P, N), dtype=torch.float32, device=device)","     final_state = torch.empty((Bb, H, P, N), dtype=torch.bfloat16, device=device)"]},{"oldStart":310,"oldLines":7,"newStart":263,"newLines":6,"lines":[" ","     sac_b, sac_h, sac_c, sac_q = acum.stride()","     sal_b, sal_h, sal_c = alast.stride()","-    sG_b, sG_c, sG_i, sG_j = Gmat.stride()","     sst_b, sst_c, sst_h, sst_p, sst_n = states.stride()","     so_b, so_c, so_h, so_p, so_n = states_out.stride()","     sf_b, sf_h, sf_p, sf_n = final_state.stride()"]},{"oldStart":326,"oldLines":16,"newStart":278,"newLines":6,"lines":["         Q=Q, num_warps=4,","     )"," ","-    # Kg: head-shared G = C·Bᵀ per (b, chunk)","-    _chunk_G_kernel[(Bb * NC, Q // BLOCK_M)](","-        C, B, Gmat,","-        sC_b, sC_l, sC_n,","-        sB_b, sB_l, sB_n,","-        sG_b, sG_c, sG_i, sG_j,","-        L, NC,","-        Q=Q, N=N, BLOCK_M=BLOCK_M, num_warps=4, num_stages=2,","-    )","-","     # K2: chunk_state","     _chunk_state_kernel[(Bb * NC * H, N // BLOCK_N)](","         hidden_states, B, acum, alast, states,"]},{"oldStart":362,"oldLines":10,"newStart":304,"newLines":10,"lines":[" ","     # K4: chunk_scan","     _chunk_scan_kernel[(Bb * NC * H, Q // BLOCK_M)](","-        C, hidden_states, Gmat, acum, states_out, D, output,","+        C, B, hidden_states, acum, states_out, D, output,","         sC_b, sC_l, sC_n,","+        sB_b, sB_l, sB_n,","         sX_b, sX_l, sX_h, sX_p,","-        sG_b, sG_c, sG_i, sG_j,","         sac_b, sac_h, sac_c, sac_q,","         so_b, so_c, so_h, so_p, so_n,","         sD_h,"]}],"originalFile":"\"\"\"L2/043 Mamba-2 chunk scan with segment sum — Triton solution.\n\nCandidate c003: head-shared G reuse (n_groups=1) — precompute G = C·Bᵀ once per\n(b, chunk) in a dedicated kernel and reuse it across all 16 heads in K4.\n\nMotivation (vs c002, which passes 5/5 at geomean 10.64x): a roofline check shows the\nc002 kernel runs ~7x above the A800 bf16 compute roofline and ~20x above the DRAM floor,\ni.e. it is compute-bound, not memory-bound. The G = C·Bᵀ matmul contracts over N=256 and\nis ~50% of the total matmul FLOPs, yet it is head-independent (B and C are shared across\nall H=16 heads because n_groups=1) and c002 recomputes it 16x redundantly inside K4. This\ncandidate computes G exactly once per (b,chunk) in kernel ``Kg`` and stores it to DRAM\n(fp32, to reproduce c002's exact diagonal numerics: G was fp32 before the elementwise L\nmultiply). K4 then loads the G tile instead of recomputing it, which also removes the\nper-head C/B loads that fed the G dot. Total matmul FLOPs drop ~2x; the extra G tensor is\ntiny (<=4 MB) and its read traffic stays far below the DRAM roofline.\n\nNumerics are preserved bit-for-bit relative to c002 for the diagonal term: G stored in\nfp32, multiplied by the fp32 lower-triangular decay L, then cast to bf16 for the M·X dot.\nAll decays / cumsum / exp / accumulators / D residual stay in fp32; bf16 only for\ntensor-core operands and the final output / final_state casts.\n\nStages (all working intermediates in fp32; only output / final_state cast to bf16):\n  K1 chunk_cumsum   : a[t] = cumsum_t A over each chunk, plus a_last = a[Q-1].\n  Kg chunk_G        : G[i,j] = sum_s C[i,s]*B[j,s]  (head-independent), fp32, lower blocks.\n  K2 chunk_state    : states[p,n] = sum_t exp(a_last - a[t]) * X[t,p] * B[t,n].\n  K3 state_passing  : sequential inter-chunk recurrence seeded by initial_states,\n                      new_states[c+1] = exp(a_last(c)) * new_states[c] + states[c];\n                      states_out[c] = new_states[c], final_state = new_states[NC].\n  K4 chunk_scan     : Y = (G∘L)·X  +  exp(a[t])·(C·states_out)  +  D[h]·X, G loaded from Kg.\n\nConstants for this task: H=16, P=64, N=256, n_groups=1, Q(chunk)=256.\nNo Torch/CPU/NumPy computational fallback anywhere: Triton is the only compute path.\n\"\"\"\n\nimport torch\nimport triton\nimport triton.language as tl\n\n\n# ---------------------------------------------------------------------------\n# K1: per-chunk inclusive cumsum of A, and per-chunk total (a_last).\n# ---------------------------------------------------------------------------\n@triton.jit\ndef _cumsum_kernel(\n    A_ptr, acum_ptr, alast_ptr,\n    sA_b, sA_h, sA_l,\n    sac_b, sac_h, sac_c, sac_q,\n    sal_b, sal_h, sal_c,\n    L,\n    Q: tl.constexpr,\n):\n    b = tl.program_id(0)\n    c = tl.program_id(1)\n    h = tl.program_id(2)\n\n    t = tl.arange(0, Q)\n    seq = c * Q + t\n    m = seq < L\n    a = tl.load(A_ptr + b * sA_b + h * sA_h + seq * sA_l, mask=m, other=0.0).to(tl.float32)\n    acum = tl.cumsum(a, axis=0)\n    tl.store(acum_ptr + b * sac_b + h * sac_h + c * sac_c + t * sac_q, acum)\n    last = tl.sum(a, axis=0)\n    tl.store(alast_ptr + b * sal_b + h * sal_h + c * sal_c, last)\n\n\n# ---------------------------------------------------------------------------\n# Kg: head-shared G = C·Bᵀ per (b, chunk). grid = (B*NC, Q // BLOCK_M).\n#     Stores only lower-triangular blocks (jblk <= iblk); upper blocks are\n#     never read by K4 so they are left untouched.\n# ---------------------------------------------------------------------------\n@triton.jit\ndef _chunk_G_kernel(\n    C_ptr, B_ptr, G_ptr,\n    sC_b, sC_l, sC_n,\n    sB_b, sB_l, sB_n,\n    sG_b, sG_c, sG_i, sG_j,\n    L, NC,\n    Q: tl.constexpr, N: tl.constexpr, BLOCK_M: tl.constexpr,\n):\n    bc = tl.program_id(0)\n    iblk = tl.program_id(1)\n    b = bc // NC\n    c = bc % NC\n\n    im = iblk * BLOCK_M + tl.arange(0, BLOCK_M)\n    seq_i = c * Q + im\n    imask = seq_i < L\n    nidx = tl.arange(0, N)\n\n    C_i = tl.load(\n        C_ptr + b * sC_b + seq_i[:, None] * sC_l + nidx[None, :] * sC_n,\n        mask=imask[:, None], other=0.0,\n    )  # [BLOCK_M, N] bf16\n\n    for jblk in range(0, iblk + 1):\n        jm = jblk * BLOCK_M + tl.arange(0, BLOCK_M)\n        seq_j = c * Q + jm\n        jmask = seq_j < L\n        B_j = tl.load(\n            B_ptr + b * sB_b + seq_j[:, None] * sB_l + nidx[None, :] * sB_n,\n            mask=jmask[:, None], other=0.0,\n        )  # [BLOCK_M, N] bf16\n        G = tl.dot(C_i, tl.trans(B_j))  # [BLOCK_M, BLOCK_M] fp32\n        tl.store(\n            G_ptr + b * sG_b + c * sG_c + im[:, None] * sG_i + jm[None, :] * sG_j,\n            G,\n        )\n\n\n# ---------------------------------------------------------------------------\n# K2: per-(b,chunk,head) state = sum_t decay_state[t] * X[t,:] outer B[t,:].\n#     grid = (B*NC*H, N // BLOCK_N)\n# ---------------------------------------------------------------------------\n@triton.jit\ndef _chunk_state_kernel(\n    X_ptr, B_ptr, acum_ptr, alast_ptr, states_ptr,\n    sX_b, sX_l, sX_h, sX_p,\n    sB_b, sB_l, sB_n,\n    sac_b, sac_h, sac_c, sac_q,\n    sal_b, sal_h, sal_c,\n    sst_b, sst_c, sst_h, sst_p, sst_n,\n    L, NC, H,\n    Q: tl.constexpr, P: tl.constexpr, N: tl.constexpr, BLOCK_N: tl.constexpr,\n):\n    bch = tl.program_id(0)\n    nblk = tl.program_id(1)\n    b = bch // (NC * H)\n    rem = bch % (NC * H)\n    c = rem // H\n    h = rem % H\n\n    t = tl.arange(0, Q)\n    seq = c * Q + t\n    tmask = seq < L\n    p = tl.arange(0, P)\n    n = nblk * BLOCK_N + tl.arange(0, BLOCK_N)\n\n    acum = tl.load(acum_ptr + b * sac_b + h * sac_h + c * sac_c + t * sac_q).to(tl.float32)\n    alast = tl.load(alast_ptr + b * sal_b + h * sal_h + c * sal_c).to(tl.float32)\n    decay = tl.exp(alast - acum)  # [Q]\n\n    X = tl.load(\n        X_ptr + b * sX_b + seq[:, None] * sX_l + h * sX_h + p[None, :] * sX_p,\n        mask=tmask[:, None], other=0.0,\n    ).to(tl.float32)  # [Q, P]\n    Xd = (X * decay[:, None]).to(tl.bfloat16)  # [Q, P] bf16 (decay applied in fp32)\n\n    Bt = tl.load(\n        B_ptr + b * sB_b + seq[:, None] * sB_l + n[None, :] * sB_n,\n        mask=tmask[:, None], other=0.0,\n    )  # [Q, BLOCK_N] bf16 (native)\n\n    states = tl.dot(tl.trans(Xd), Bt)  # [P, BLOCK_N] fp32 accumulate\n    tl.store(\n        states_ptr + b * sst_b + c * sst_c + h * sst_h + p[:, None] * sst_p + n[None, :] * sst_n,\n        states,\n    )\n\n\n# ---------------------------------------------------------------------------\n# K3: inter-chunk sequential recurrence. grid = (B, H, N // BLOCK_N).\n#     Elementwise in (p, n), so tiling over n is safe.\n# ---------------------------------------------------------------------------\n@triton.jit\ndef _state_passing_kernel(\n    states_ptr, init_ptr, states_out_ptr, final_ptr, alast_ptr,\n    sst_b, sst_c, sst_h, sst_p, sst_n,\n    si_b, si_h, si_p, si_n,\n    so_b, so_c, so_h, so_p, so_n,\n    sf_b, sf_h, sf_p, sf_n,\n    sal_b, sal_h, sal_c,\n    NC, H,\n    P: tl.constexpr, N: tl.constexpr, BLOCK_N: tl.constexpr,\n):\n    b = tl.program_id(0)\n    h = tl.program_id(1)\n    nblk = tl.program_id(2)\n\n    p = tl.arange(0, P)\n    n = nblk * BLOCK_N + tl.arange(0, BLOCK_N)\n\n    state = tl.load(\n        init_ptr + b * si_b + h * si_h + p[:, None] * si_p + n[None, :] * si_n\n    ).to(tl.float32)  # [P, BLOCK_N]\n\n    for c in range(0, NC):\n        tl.store(\n            states_out_ptr + b * so_b + c * so_c + h * so_h + p[:, None] * so_p + n[None, :] * so_n,\n            state,\n        )\n        alast = tl.load(alast_ptr + b * sal_b + h * sal_h + c * sal_c).to(tl.float32)\n        g = tl.exp(alast)\n        st = tl.load(\n            states_ptr + b * sst_b + c * sst_c + h * sst_h + p[:, None] * sst_p + n[None, :] * sst_n\n        ).to(tl.float32)\n        state = g * state + st\n\n    tl.store(\n        final_ptr + b * sf_b + h * sf_h + p[:, None] * sf_p + n[None, :] * sf_n,\n        state.to(tl.bfloat16),\n    )\n\n\n# ---------------------------------------------------------------------------\n# K4: chunk scan. grid = (B*NC*H, Q // BLOCK_M). Loads head-shared G from Kg.\n# ---------------------------------------------------------------------------\n@triton.jit\ndef _chunk_scan_kernel(\n    C_ptr, X_ptr, G_ptr, acum_ptr, states_out_ptr, D_ptr, out_ptr,\n    sC_b, sC_l, sC_n,\n    sX_b, sX_l, sX_h, sX_p,\n    sG_b, sG_c, sG_i, sG_j,\n    sac_b, sac_h, sac_c, sac_q,\n    so_b, so_c, so_h, so_p, so_n,\n    sD_h,\n    sout_b, sout_l, sout_hp,\n    L, NC, H,\n    Q: tl.constexpr, P: tl.constexpr, N: tl.constexpr, BLOCK_M: tl.constexpr,\n):\n    bch = tl.program_id(0)\n    iblk = tl.program_id(1)\n    b = bch // (NC * H)\n    rem = bch % (NC * H)\n    c = rem // H\n    h = rem % H\n\n    im = iblk * BLOCK_M + tl.arange(0, BLOCK_M)  # chunk-local query rows\n    seq_i = c * Q + im\n    imask = seq_i < L\n    nidx = tl.arange(0, N)\n    pidx = tl.arange(0, P)\n\n    a_i = tl.load(acum_ptr + b * sac_b + h * sac_h + c * sac_c + im * sac_q).to(tl.float32)  # [BLOCK_M]\n\n    acc = tl.zeros((BLOCK_M, P), dtype=tl.float32)\n\n    for jblk in range(0, iblk + 1):\n        jm = jblk * BLOCK_M + tl.arange(0, BLOCK_M)\n        seq_j = c * Q + jm\n        jmask = seq_j < L\n        a_j = tl.load(acum_ptr + b * sac_b + h * sac_h + c * sac_c + jm * sac_q).to(tl.float32)\n        G = tl.load(\n            G_ptr + b * sG_b + c * sG_c + im[:, None] * sG_i + jm[None, :] * sG_j\n        )  # [BLOCK_M, BLOCK_M] fp32 (head-shared, precomputed by Kg)\n        X_j = tl.load(\n            X_ptr + b * sX_b + seq_j[:, None] * sX_l + h * sX_h + pidx[None, :] * sX_p,\n            mask=jmask[:, None], other=0.0,\n        )  # [BLOCK_M, P] bf16\n\n        diff = a_i[:, None] - a_j[None, :]\n        cmask = im[:, None] >= jm[None, :]\n        Lm = tl.where(cmask, tl.exp(diff), 0.0)\n        M = (G * Lm).to(tl.bfloat16)\n        acc += tl.dot(M, X_j)\n\n    C_i = tl.load(\n        C_ptr + b * sC_b + seq_i[:, None] * sC_l + nidx[None, :] * sC_n,\n        mask=imask[:, None], other=0.0,\n    )  # [BLOCK_M, N] bf16\n    states_o = tl.load(\n        states_out_ptr + b * so_b + c * so_c + h * so_h + pidx[:, None] * so_p + nidx[None, :] * so_n\n    ).to(tl.bfloat16)  # [P, N]\n    Cstate = tl.dot(C_i, tl.trans(states_o))  # [BLOCK_M, P] fp32\n    a_i_exp = tl.exp(a_i)\n    Y = acc + a_i_exp[:, None] * Cstate\n\n    X_i = tl.load(\n        X_ptr + b * sX_b + seq_i[:, None] * sX_l + h * sX_h + pidx[None, :] * sX_p,\n        mask=imask[:, None], other=0.0,\n    ).to(tl.float32)\n    Dh = tl.load(D_ptr + h * sD_h).to(tl.float32)\n    Y = Y + Dh * X_i\n\n    out_off = out_ptr + b * sout_b + seq_i[:, None] * sout_l + (h * P + pidx[None, :]) * sout_hp\n    tl.store(out_off, Y.to(tl.bfloat16), mask=imask[:, None])\n\n\n# ---------------------------------------------------------------------------\n# Host entry point.\n# ---------------------------------------------------------------------------\n@torch.no_grad()\ndef run(hidden_states, A, B, C, D, initial_states):\n    Bb, L, H, P = hidden_states.shape\n    N = 256\n    Q = 256\n    device = hidden_states.device\n\n    pad = (Q - L % Q) % Q\n    L_pad = L + pad\n    NC = L_pad // Q\n\n    BLOCK_M = 64\n    BLOCK_N = 64\n\n    acum = torch.empty((Bb, H, NC, Q), dtype=torch.float32, device=device)\n    alast = torch.empty((Bb, H, NC), dtype=torch.float32, device=device)\n    Gmat = torch.empty((Bb, NC, Q, Q), dtype=torch.float32, device=device)\n    states = torch.empty((Bb, NC, H, P, N), dtype=torch.float32, device=device)\n    states_out = torch.empty((Bb, NC, H, P, N), dtype=torch.float32, device=device)\n    final_state = torch.empty((Bb, H, P, N), dtype=torch.bfloat16, device=device)\n    output = torch.empty((Bb, L, H * P), dtype=torch.bfloat16, device=device)\n\n    # strides\n    sA_b, sA_h, sA_l = A.stride(0), A.stride(1), A.stride(2)\n    sX_b, sX_l, sX_h, sX_p = hidden_states.stride()\n    sB_b, sB_l, sB_n = B.stride(0), B.stride(1), B.stride(3)\n    sC_b, sC_l, sC_n = C.stride(0), C.stride(1), C.stride(3)\n    sD_h = D.stride(0)\n    si_b, si_h, si_p, si_n = initial_states.stride()\n\n    sac_b, sac_h, sac_c, sac_q = acum.stride()\n    sal_b, sal_h, sal_c = alast.stride()\n    sG_b, sG_c, sG_i, sG_j = Gmat.stride()\n    sst_b, sst_c, sst_h, sst_p, sst_n = states.stride()\n    so_b, so_c, so_h, so_p, so_n = states_out.stride()\n    sf_b, sf_h, sf_p, sf_n = final_state.stride()\n    sout_b, sout_l, sout_hp = output.stride()\n\n    # K1: cumsum\n    _cumsum_kernel[(Bb, NC, H)](\n        A, acum, alast,\n        sA_b, sA_h, sA_l,\n        sac_b, sac_h, sac_c, sac_q,\n        sal_b, sal_h, sal_c,\n        L,\n        Q=Q, num_warps=4,\n    )\n\n    # Kg: head-shared G = C·Bᵀ per (b, chunk)\n    _chunk_G_kernel[(Bb * NC, Q // BLOCK_M)](\n        C, B, Gmat,\n        sC_b, sC_l, sC_n,\n        sB_b, sB_l, sB_n,\n        sG_b, sG_c, sG_i, sG_j,\n        L, NC,\n        Q=Q, N=N, BLOCK_M=BLOCK_M, num_warps=4, num_stages=2,\n    )\n\n    # K2: chunk_state\n    _chunk_state_kernel[(Bb * NC * H, N // BLOCK_N)](\n        hidden_states, B, acum, alast, states,\n        sX_b, sX_l, sX_h, sX_p,\n        sB_b, sB_l, sB_n,\n        sac_b, sac_h, sac_c, sac_q,\n        sal_b, sal_h, sal_c,\n        sst_b, sst_c, sst_h, sst_p, sst_n,\n        L, NC, H,\n        Q=Q, P=P, N=N, BLOCK_N=BLOCK_N, num_warps=4, num_stages=2,\n    )\n\n    # K3: state_passing\n    _state_passing_kernel[(Bb, H, N // BLOCK_N)](\n        states, initial_states, states_out, final_state, alast,\n        sst_b, sst_c, sst_h, sst_p, sst_n,\n        si_b, si_h, si_p, si_n,\n        so_b, so_c, so_h, so_p, so_n,\n        sf_b, sf_h, sf_p, sf_n,\n        sal_b, sal_h, sal_c,\n        NC, H,\n        P=P, N=N, BLOCK_N=BLOCK_N, num_warps=4,\n    )\n\n    # K4: chunk_scan\n    _chunk_scan_kernel[(Bb * NC * H, Q // BLOCK_M)](\n        C, hidden_states, Gmat, acum, states_out, D, output,\n        sC_b, sC_l, sC_n,\n        sX_b, sX_l, sX_h, sX_p,\n        sG_b, sG_c, sG_i, sG_j,\n        sac_b, sac_h, sac_c, sac_q,\n        so_b, so_c, so_h, so_p, so_n,\n        sD_h,\n        sout_b, sout_l, sout_hp,\n        L, NC, H,\n        Q=Q, P=P, N=N, BLOCK_M=BLOCK_M, num_warps=4, num_stages=2,\n    )\n\n    return output, final_state\n","userModified":false}}
