tride_wh\n72\t\n73\t    # SwiGLU: silu(gate) * up, computed in fp32.\n74\t    silu_g = acc_g * tl.sigmoid(acc_g)\n75\t    h = silu_g * acc_u\n76\t\n77\t    h_ptrs = h_ptr + pid_e * stride_he + offs_m[:, None] * stride_hm + offs_n[None, :] * stride_hi\n78\t    tl.store(h_ptrs, h.to(tl.bfloat16), mask=m_mask[:, None] & n_mask[None, :])\n79\t\n80\t\n81\t# ---------------------------------------------------------------------------\n82\t# Kernel B: down projection  ->  y[E, capacity, H]\n83\t# ---------------------------------------------------------------------------\n84\t@triton.jit"}]},"parent_tool_use_id":null,"session_id":"84708b82-1793-4117-b276-8f509c6ef623","uuid":"b63c7e28-a8d4-4b3d-b8b7-3b84ef453d7f","timestamp":"2026-09-16T18:02:55.807Z","tool_use_result":{"type":"text","file":{"filePath":"/data1/workspace/weihongren/kda-runs/formal-kda-20260916--sol_execbench--L2-012_moe_expert_batched_execution_with_capacity_factor/solution/solution.py","content":"    x_ptr,          # expert_inputs [E, CAP, H] bf16\n    wg_ptr,         # expert_gate_weights [E, H, I] bf16\n    wu_ptr,         # expert_up_weights   [E, H, I] bf16\n    h_ptr,          # out h [E, CAP, I] bf16\n    CAP, H, I,\n    stride_xe, stride_xm, stride_xh,\n    stride_we, stride_wh, stride_wi,\n    stride_he, stride_hm, stride_hi,\n    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\n):\n    pid_e = tl.program_id(0)\n    pid_m = tl.program_id(1)\n    pid_n = tl.program_id(2)\n\n    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\n    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\n    offs_k = tl.arange(0, BLOCK_K)\n\n    x_base = x_ptr + pid_e * stride_xe\n    wg_base = wg_ptr + pid_e * stride_we\n    wu_base = wu_ptr + pid_e * stride_we\n\n    x_ptrs = x_base + offs_m[:, None] * stride_xm + offs_k[None, :] * stride_xh\n    wg_ptrs = wg_base + offs_k[:, None] * stride_wh + offs_n[None, :] * stride_wi\n    wu_ptrs = wu_base + offs_k[:, None] * stride_wh + offs_n[None, :] * stride