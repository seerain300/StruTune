\n        },\n        \"conv1_weight\": {\n            \"shape\": [\n                \"channels\",\n                \"channels\",\n                \"kernel_size\",\n                \"kernel_size\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"First convolution weights\"\n        },\n        \"norm1_weight\": {\n            \"shape\": [\n                \"channels\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"First GroupNorm scale parameter\"\n        },\n        \"norm1_bias\": {\n            \"shape\": [\n                \"channels\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"First GroupNorm bias parameter\"\n        },\n        \"conv2_weight\": {\n            \"shape\": [\n                \"channels\",\n                \"channels\",\n                \"kernel_size\",\n                \"kernel_size\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Second convolution weights\"\n        },\n        \"norm2_weight\": {\n            \"shape\": [\n                \"channels\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Second GroupNorm scale parameter\"\n        },\n        \"norm2_bias\": {\n            \"shape\": [\n                \"channels\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Second GroupNorm bias parameter\"\n        },\n        \"eps\": {\n            \"shape\": null,\n            \"dtype\": \"float32\",\n            \"description\": \"Epsilon for numerical stability in GroupNorm\"\n        }\n    },\n    \"outputs\": {\n        \"output\": {\n            \"shape\": [\n                \"batch_size\",\n                \"channels\",\n                \"height\",\n                \"width\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Output feature map after residual block\"\n        }\n    },\n    \"reference\": \"import torch\\nimport torch.nn.functional as F\\n\\n@torch.no_grad()\\ndef run(\\n    x: torch.Tensor,\\n    conv1_weight: torch.Tensor,\\n    norm1_weight: torch.Tensor,\\n    norm1_bias: torch.Tensor,\\n    conv2_weight: torch.Tensor,\\n    norm2_weight: torch.Tensor,\\n    norm2_bias: torch.Tensor,\\n    eps: float,\\n):\\n    \\\"\\\"\\\"\\n    Fused residual block: Conv3x3 -> GroupNorm -> SiLU -> Conv3x3 -> GroupNorm -> SiLU -> Add\\n    \\n    Args:\\n        x: Input tensor of shape (B, C, H, W)\\n        conv1_weight: First conv weights (C, C, 3, 3)\\n        norm1_weight: First GroupNorm scale (C,)\\n        norm1_bias: First GroupNorm bias (C,)\\n        conv2_weight: Second conv weights (C, C, 3, 3)\\n        norm2_weight: Second GroupNorm scale (C,)\\n        norm2_bias: Second GroupNorm bias (C,)\\n        eps: Epsilon for GroupNorm numerical stability\\n        \\n    Returns:\\n        Output tensor of shape (B, C, H, W)\\n    \\\"\\\"\\\"\\n    num_groups = 32\\n    \\n    # Save residual\\n    residual = x\\n    \\n    # First path: Conv3x3 -> GroupNorm -> SiLU\\n    out = F.conv2d(x, conv1_weight, bias=None, stride=1, padding=1)\\n    out = F.group_norm(out, num_groups, weight=norm1_weight, bias=norm1_bias, eps=eps)\\n    out = F.silu(out)\\n    \\n    # Second path: Conv3x3 -> GroupNorm -> SiLU\\n    out = F.conv2d(out, conv2_weight, bias=None, stride=1, padding=1)\\n    out = F.group_norm(out, num_groups, weight=norm2_weight, bias=norm2_bias, eps=eps)\\n    out = F.silu(out)\\n    \\n    # Residual connection\\n    out = out + residual\\n    \\n    return out\\n\"\n}\n","numLines":114,"startLine":1,"totalLines":114}}}
