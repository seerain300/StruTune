{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FekhsmhxzdnyxqwShMBW5S","type":"tool_result","content":"200\t\n201\t# ============= K-D: linear + scale + positional-embedding add ================\n202\t@triton.jit\n203\tdef linear_kernel(\n204\t    A_ptr,          # [M, 3840] bf16\n205\t    w_ptr,          # conv_out_weight [1024, 3840] bf16\n206\t    pe_ptr,         # positional_embedding [1500, 1024] bf16\n207\t    out_ptr,        # [M, 1024] bf16   (M = B*T3)\n208\t    M, T3, embed_scale,\n209\t    K: tl.constexpr, N: tl.constexpr,\n210\t    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\n211\t):\n212\t    pid_m = tl.program_id(0)\n213\t    pid_n = tl.program_id(1)\n214\t    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\n215\t    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\n216\t    offs_k = tl.arange(0, BLOCK_K)\n217\t    m_valid = offs_m < M\n218\t    n_valid = offs_n < N\n219\t\n220\t    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n221\t    for k0 in tl.range(0, K, BLOCK_K):\n222\t        kk = k0 + offs_k\n223\t        k_ok = kk < K\n224\t        a = tl.load(A_ptr + offs_m[:, None] * K + kk[None, :],\n225\t                    mask=m_valid[:, None] & k_ok[None, :], other=0.0)\n226\t        w = tl.load(w_ptr + offs_n[None, :] * K + kk[:, None],\n227\t                    mask=k_ok[:, None] & n_valid[None, :], other=0.0)\n228\t        acc += tl.dot(a, w, out_dtype=tl.float32)\n229\t\n230\t    # round linear output to bf16 (as reference), scale (x*32 exact in bf16), add PE\n231\t    x = acc.to(tl.bfloat16).to(tl.float32) * embed_scale\n232\t    t = offs_m % T3\n233\t    pe = tl.load(pe_ptr + t[:, None] * N + offs_n[None, :],\n234\t                 mask=m_valid[:, None] & n_valid[None, :], other=0.0).to(tl.float32)\n235\t    out = (x + pe).to(tl.bfloat16)\n236\t    tl.store(out_ptr + offs_m[:, None] * N + offs_n[None, :],\n237\t             out, mask=m_valid[:, None] & n_valid[None, :])\n238\t\n239\t"