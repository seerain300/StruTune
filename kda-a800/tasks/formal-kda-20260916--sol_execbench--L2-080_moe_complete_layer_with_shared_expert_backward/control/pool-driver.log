e\": \"custom\"}, \"topk_weights\": {\"type\": \"custom\"}, \"score_mask\": {\"type\": \"custom\"}, \"shared_expert_gate_weight\": {\"type\": \"custom\"}, \"shared_expert_up_weight\": {\"type\": \"custom\"}, \"shared_expert_down_weight\": {\"type\": \"custom\"}, \"shared_gate_output\": {\"type\": \"custom\"}, \"shared_up_output\": {\"type\": \"custom\"}, \"shared_activated\": {\"type\": \"custom\"}}, \"tolerance\": {\"max_atol\": 0.18000000000000002, \"max_rtol\": 0.05, \"required_match_ratio\": 0.98}}\n{\"uuid\": \"43f3b0f2-344c-5778-ad7a-79c347ce2166\", \"axes\": {\"batch_seq_len\": 512}, \"inputs\": {\"grad_output\": {\"type\": \"custom\"}, \"hidden_states\": {\"type\": \"custom\"}, \"router_weight\": {\"type\": \"custom\"}, \"e_score_correction_bias\": {\"type\": \"custom\"}, \"router_logits\": {\"type\": \"custom\"}, \"scores\": {\"type\": \"custom\"}, \"topk_indices\": {\"type\": \"custom\"}, \"topk_weights\": {\"type\": \"custom\"}, \"score_mask\": {\"type\": \"custom\"}, \"shared_expert_gate_weight\": {\"type\": \"custom\"}, \"shared_expert_up_weight\": {\"type\": \"custom\"}, \"shared_expert_down_weight\": {\"type\": \"custom\"}, \"shared_gate_output\": {\"type\": \"custom\"}, \"shared_up_output\": {\"type\": \"custom\"}, \"shared_activated\": {\"type\": \"custom\"}}, \"tolerance\": {\"max_atol\": 0.2, \"max_rtol\": 0.05, \"required_match_ratio\": 0.98}}\n","numLines":6,"startLine":1,"totalLines":6}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H22KF2Jc9PW7T7PPaTmkvY","type":"tool_result","content":"1\t{\n2\t    \"name\": \"080_moe_complete_layer_with_shared_expert_backward\",\n3\t    \"hf_id\": \"zai-org/GLM-4.5-Air\",\n4\t    \"description\": \"Backward pass for complete MoE layer with shared expert. Computes gradients through router (sigmoid + top-k selection), 128 routed experts with SwiGLU, and shared expert with SwiGLU. Gradients flow back through scatter-gather routing pattern.\",\n5\t    \"axes\": {\n6\t        \"batch_seq_len\": {\n7\t            \"type\": \"var\",\n8\t            \"description\": \"Batch size times sequence length (flattened)\"\n9\t        },\n10\t        \"hidden_size\": {\n11\t            \"type\": \"const\",\n12\t            \"value\": 4096,\n13\t            \"description\": null\n14\t        },\n15\t        \"moe_intermediate_size\": {\n16\t            \"type\": \"const\",\n17\t            \"value\": 1408,\n18\t            \"description\": null\n19\t        },\n20\t        \"n_routed_experts\": {\n21\t            \"type\": \"const\",\n22\t            \"value\": 128,\n23\t            \"description\": null\n24\t        },\n25\t        \"num_experts_per_tok\": {\n26\t            \"type\": \"const\",\n27\t            \"value\": 8,\n28\t            \"description\": null\n29\t        }\n30\t    },\n31\t    \"custom_inputs_entrypoint\": \"get_inputs\",\n32\t    \"inputs\": {\n33\t        \"grad_output\": {\n34\t            \"shape\": [\n35\t                \"batch_seq_len\",\n36\t                \"hidden_size\"\n37\t            ],\n38\t            \"dtype\": \"bfloat16\",\n39\t            \"description\": \"Gradient from next layer\"\n40\t        },\n41\t        \"hidden_states\": {\n42\t            \"shape\": [\n43\t                \"batch_seq_len\",\n44\t                \"hidden_size\"\n45\t            ],\n46\t            \"dtype\": \"bfloat16\",\n47\t            \"description\": \"Original input hidden states (saved from forward)\"\n48\t        },\n49\t        \"router_weight\": {\n50\t            \"shape\": [\n51\t                \"n_routed_experts\",\n52\t                \"hidden_size\"\n53\t            ],\n54\t            \"dtype\": \"bfloat16\",\n55\t            \"description\": \"Router linear projection weights\"\n56\t        },\n57\t        \"e_score_correction_bias\": {\n58\t            \"shape\": [\n59\t                \"n_routed_experts\"\n60\t            ],\n61\t            \"dtype\": \"float32\",\n62\t            \"description\": \"Score correction bias for routing\"\n63\t        },\n64\t        \"router_logits\": {\n65\t            \"shape\": [\n66\t                \"batch_seq_len\",\n67\t                \"n_routed_experts\"\n68\t            ],\n69\t            \"dtype\": \"float32\",\n70\t            \"description\": \"Router logits (saved from forward)\"\n71\t        },\n72\t        \"scores\": {\n73\t            \"shape\": [\n74\t                \"batch_seq_len\",\n75\t                \"n_routed_experts\"\n76\t            ],\n77\t            \"dtype\": \"float32\",\n78\t            \"description\": \"Sigmoid scores (saved from forward)\"\n79\t        },\n80\t        \"topk_indices\": {\n81\t            \"shape\": [\n82\t                \"batch_seq_len\",\n83\t                \"num_experts_per_tok\"\n84\t            ],\n85\t            \"dtype\": \"int64\",\n86\t            \"description\": \"Top-k expert indices per token\"\n87\t        },\n88\t        \"topk_weights\": {\n89\t            \"shape\": [\n90\t                \"batch_seq_len\",\n91\t                \"num_experts_per_tok\"\n92\t            ],\n93\t            \"dtype\": \"float32\",\n94\t            \"description\": \"Top-k routing weights per token\"\n95\t        },\n96\t        \"score_mask\": {\n97\t            \"shape\": [\n98\t                \"batch_seq_len\",\n99\t                \"n_routed_experts\"\n100\t            ],\n101\t            \"dtype\": \"float32\",\n102\t            \"description\": \"Group selection mask\"\n103\t        },\n104\t        \"shared_expert_gate_weight\": {\n105\t            \"shape\": [\n106\t                \"moe_intermediate_size\",\n107\t                \"hidden_size\"\n108\t            ],\n109\t            \"dtype\": \"bfloat16\",\n110\t            \"description\": \"Shared expert gate projection\"\n111\t        },\n112\t        \"shared_expert_up_weight\": {\n113\t            \"shape\": [\n114\t                \"moe_intermediate_size\",\n115\t                \"hidden_size\"\n116\t            ],\n117\t            \"dtype\": \"bfloat16\",\n118\t            \"description\": \"Shared expert up projection\"\n119\t        },\n120\t        \"shared_expert_down_weight\": {\n121\t            \"shape\": [\n122\t                \"hidden_size\",\n123\t                \"moe_intermediate_size\"\n124\t            ],\n125\t            \"dtype\": \"bfloat16\",\n126\t            \"description\": \"Shared expert down projection\"\n127\t        },\n128\t        \"shared_gate_output\": {\n129\t            \"shape\": [\n130\t                \"batch_seq_len\",\n131\t                \"moe_intermediate_size\"\n132\t            ],\n133\t            \"dtype\": \"bfloat16\",\n134\t            \"description\": \"Shared expert gate output (saved from forward)\"\n135\t        },\n136\t        \"shared_up_output\": {\n137\t            \"shape\": [\n138\t                \"batch_seq_len\",\n139\t                \"moe_intermediate_size\"\n140\t            ],\n141\t            \"dtype\": \"bfloat16\",\n142\t            \"description\": \"Shared expert up output (saved from forward)\"\n143\t        },\n144\t        \"shared_activated\": {\n145\t            \"shape\": [\n146\t                \"batch_seq_len\",\n147\t                \"moe_intermediate_size\"\n148\t            ],\n149\t            \"dtype\": \"bfloat16\",\n150\t            \"description\": \"Shared expert activated output (saved from forward)\"\n151\t        }\n152\t    },\n153\t    \"outputs\": {\n154\t        \"grad_hidden_states\": {\n155\t            \"shape\": [\n156\t                \"batch_seq_len\",\n157\t                \"hidden_size\"\n158\t            ],\n159\t            \"dtype\": \"bfloat16\",\n160\t            \"description\": \"Gradient w.r.t. input hidden states\"\n161\t        },\n162\t        \"grad_router_weight\": {\n163\t            \"shape\": [\n164\t                \"n_routed_experts\",\n165\t                \"hidden_size\"\n166\t            ],\n167\t            \"dtype\": \"float32\",\n168\t            \"description\": \"Gradient w.r.t. router weights\"\n169\t        },\n170\t        \"grad_shared_expert_gate_weight\": {\n171\t            \"shape\": [\n172\t                \"moe_intermediate_size\",\n173\t                \"hidden_size\"\n174\t            ],\n175\t            \"dtype\": \"bfloat16\",\n176\t            \"description\": \"Gradient w.r.t. shared expert gate weights\"\n177\t        },\n178\t        \"grad_shared_expert_up_weight\": {\n179\t            \"shape\": [\n180\t                \"moe_intermediate_size\",\n181\t                \"hidden_size\"\n182\t            ],\n183\t            \"dtype\": \"bfloat16\",\n184\t            \"description\": \"Gradient w.r.t. shared expert up weights\"\n185\t        },\n186\t        \"grad_shared_expert_down_weight\": {\n187\t            \"shape\": [\n188\t                \"hidden_size\",\n189\t                \"moe_intermediate_size\"\n190\t            ],\n191\t            \"dtype\": \"bfloat16\",\n192\t            \"description\": \"Gradient w.r.t. shared expert down weights\"\n193\t        }\n194\t    },\n195\t    \"reference\": \"import torch\\nimport torch.nn.functional as F\\n\\n\\ndef get_inputs(axes_and_scalars: dict, device: torch.device) -> dict:\\n    \\\"\\\"\\\"Generate inputs for backward pass testing.\\\"\\\"\\\"\\n    batch_seq_len = axes_and_scalars[\\\"batch_seq_len\\\"]\\n    hidden_size = 4096\\n    moe_intermediate_size = 1408\\n    n_routed_experts = 128\\n    num_experts_per_tok = 8\\n    routed_scaling_factor = 1.0\\n    \\n    # Gradient from next layer\\n    grad_output = torch.randn(batch_seq_len, hidden_size, dtype=torch.bfloat16, device=device)\\n    \\n    # Original hidden states\\n    hidden_states = torch.randn(batch_seq_len, hidden_size, dtype=torch.bfloat16, device=device)\\n    \\n    # Router weights\\n    router_weight = torch.randn(n_routed_experts, hidden_size, dtype=torch.bfloat16, device=device) * 0.02\\n    \\n    # Score correction bias\\n    e_score_correction_bias = torch.zeros(n_routed_experts, dtype=torch.float32, device=device)\\n    \\n    # Compute router logits and scores for realistic saved tensors\\n    router_logits = F.linear(hidden_states.to(torch.float32), router_weight.to(torch.float32))\\n    scores = torch.sigmoid(router_logits)\\n    \\n    # Compute top-k selection\\n    scores_for_choice = scores + e_score_correction_bias.unsqueeze(0)\\n    topk_weights, topk_indices = torch.topk(scores_for_choice, k=num_experts_per_tok, dim=-1, sorted=False)\\n    \\n    # Normalize weights\\n    denominator = topk_weights.sum(dim=-1, keepdim=True) + 1e-20\\n    topk_weights = (topk_weights / denominator) * routed_scaling_factor\\n    \\n    # Score mask (all ones for n_group=1, topk_group=1)\\n    score_mask = torch.ones(batch_seq_len, n_routed_experts, dtype=torch.float32, device=device)\\n    \\n    # Shared expert weights\\n    shared_expert_gate_weight = torch.randn(moe_intermediate_size, hidden_size, dtype=torch.bfloat16, device=device) * 0.02\\n    shared_expert_up_weight = torch.randn(moe_intermediate_size, hidden_size, dtype=torch.bfloat16, device=device) * 0.02\\n    shared_expert_down_weight = torch.randn(hidden_size, moe_intermediate_size, dtype=torch.bfloat16, device=device) * 0.02\\n    \\n    # Compute shared expert forward pass for saved tensors\\n    shared_gate_output = F.linear(hidden_states, shared_expert_gate_weight)\\n    shared_up_output = F.linear(hidden_states, shared_expert_up_weight)\\n    shared_activated = F.silu(shared_gate_output) * shared_up_output\\n    \\n    return {\\n        \\\"grad_output\\\": grad_output,\\n        \\\"hidden_states\\\": hidden_states,\\n        \\\"router_weight\\\": router_weight,\\n        \\\"e_score_correction_bias\\\": e_score_correction_bias,\\n        \\\"router_logits\\\": router_logits,\\n        \\\"scores\\\": scores,\\n        \\\"topk_indices\\\": topk_indices,\\n        \\\"topk_weights\\\": topk_weights,\\n        \\\"score_mask\\\": score_mask,\\n        \\\"shared_expert_gate_weight\\\": shared_expert_gate_weight,\\n        \\\"shared_expert_up_weight\\\": shared_expert_up_weight,\\n        \\\"shared_expert_down_weight\\\": shared_expert_down_weight,\\n        \\\"shared_gate_output\\\": shared_gate_output,\\n        \\\"shared_up_output\\\": shared_up_output,\\n        \\\"shared_activated\\\": shared_activated,\\n    }\\n\\n\\n@torch.no_grad()\\ndef run(\\n    grad_output: torch.Tensor,\\n    hidden_states: torch.Tensor,\\n    router_weight: torch.Tensor,\\n    e_score_correction_bias: torch.Tensor,\\n    router_logits: torch.Tensor,\\n    scores: torch.Tensor,\\n    topk_indices: torch.Tensor,\\n    topk_weights: torch.Tensor,\\n    score_mask: torch.Tensor,\\n    shared_expert_gate_weight: torch.Tensor,\\n    shared_expert_up_weight: torch.Tensor,\\n    shared_expert_down_weight: torch.Tensor,\\n    shared_gate_output: torch.Tensor,\\n    shared_up_output: torch.Tensor,\\n    shared_activated: torch.Tensor,\\n):\\n    \\\"\\\"\\\"\\n    Backward pass for MoE layer with shared expert.\\n    \\n    Computes gradients for:\\n    - hidden_states (input)\\n    - router_weight\\n    - shared_expert_gate_weight, shared_expert_up_weight, shared_expert_down_weight\\n    \\n    Note: Routed expert weight gradients are omitted for simplicity as they would\\n    require passing all 128*3 weight tensors and their saved activations.\\n    \\\"\\\"\\\"\\n    batch_seq_len = hidden_states.shape[0]\\n    hidden_size = hidden_states.shape[1]\\n    n_routed_experts = 128\\n    norm_topk_prob = True\\n    routed_scaling_factor = 1.0\\n    \\n    # Initialize gradients\\n    grad_hidden_states = torch.zeros_like(hidden_states)\\n    \\n    # Gradient flows through addition: split to routed and shared paths\\n    grad_shared_output = grad_output.clone()\\n    \\n    # ===== Backward through shared expert =====\\n    # Gradient through shared_expert_down: output = down(activated)\\n    # down_weight shape: [hidden_size, moe_intermediate_size]\\n    # grad_shared_output shape: [batch_seq_len, hidden_size]\\n    # grad_shared_activated = grad_shared_output @ down_weight (need transpose for backward)\\n    grad_shared_activated = grad_shared_output @ shared_expert_down_weight\\n    \\n    # grad_shared_expert_down_weight = grad_shared_output.T @ shared_activated\\n    # Shape: [hidden_size, batch_seq_len] @ [batch_seq_len, moe_intermediate_size] = [hidden_size, moe_intermediate_size]\\n    grad_shared_expert_down_weight = grad_shared_output.t().to(torch.float32) @ shared_activated.to(torch.float32)\\n    grad_shared_expert_down_weight = grad_shared_expert_down_weight.to(torch.bfloat16)\\n    \\n    # Gradient through SwiGLU: activated = silu(gate) * up\\n    grad_shared_gate_silu = grad_shared_activated * shared_up_output\\n    grad_shared_up_output = grad_shared_activated * F.silu(shared_gate_output)\\n    \\n    # Gradient through silu: silu(x) = x * sigmoid(x)\\n    sigmoid_gate = torch.sigmoid(shared_gate_output.to(torch.float32))\\n    shared_gate_float = shared_gate_output.to(torch.float32)\\n    grad_shared_gate_output = grad_shared_gate_silu.to(torch.float32) * (\\n        sigmoid_gate * (1 + shared_gate_float * (1 - sigmoid_gate))\\n    )\\n    grad_shared_gate_output = grad_shared_gate_output.to(torch.bfloat16)\\n    \\n    # Gradient through shared_expert_up and shared_expert_gate\\n    # up_weight shape: [moe_intermediate_size, hidden_size]\\n    # grad_shared_up_output shape: [batch_seq_len, moe_intermediate_size]\\n    # grad_hidden_from_shared_up = grad_shared_up_output @ up_weight\\n    grad_hidden_from_shared_up = grad_shared_up_output @ shared_expert_up_weight\\n    grad_hidden_from_shared_gate = grad_shared_gate_output @ shared_expert_gate_weight\\n    \\n    # grad_shared_expert_up_weight = grad_shared_up_output.T @ hidden_states\\n    # Shape: [moe_intermediate_size, batch_seq_len] @ [batch_seq_len, hidden_size] = [moe_intermediate_size, hidden_size]\\n    grad_shared_expert_up_weight = grad_shared_up_output.t().to(torch.float32) @ hidden_states.to(torch.float32)\\n    grad_shared_expert_up_weight = grad_shared_expert_up_weight.to(torch.bfloat16)\\n    \\n    grad_shared_expert_gate_weight = grad_shared_gate_output.t().to(torch.float32) @ hidden_states.to(torch.float32)\\n    grad_shared_expert_gate_weight = grad_shared_expert_gate_weight.to(torch.bfloat16)\\n    \\n    grad_hidden_states = grad_hidden_states + grad_hidden_from_shared_up + grad_hidden_from_shared_gate\\n    \\n    # ===== Backward through routing =====\\n    # Routed expert output: y_routed = sum_k(w_norm_k * expert_k(x))\\n    # grad_topk_weights_norm[token, k] = dot(grad_output[token], expert_k_output[token])\\n    # Since routed expert outputs are not available as saved tensors (would require\\n    # 128*3 weight matrices and activations), we approximate using grad_output directly.\\n    # The routed contribution per token is: y_routed = sum_k(w_k * e_k), so\\n    # grad_w_k = <grad_output, e_k>. Without e_k, we use a straight-through estimator:\\n    # grad_w_k \\u2248 ||grad_output||^2 / num_experts_per_tok as an isotropic approximation.\\n    num_experts_per_tok = topk_weights.shape[-1]\\n\\n    # Approximate grad_topk_weights using the norm of grad_output as a proxy\\n    # This captures the magnitude of the gradient signal flowing through routing\\n    grad_output_f32 = grad_output.to(torch.float32)\\n    grad_norm_sq = (grad_output_f32 * grad_output_f32).sum(dim=-1, keepdim=True)  # [batch_seq_len, 1]\\n    grad_topk_weights = grad_norm_sq.expand_as(topk_weights) / num_experts_per_tok\\n\\n    # Gradient through routing weight normalization and scaling\\n    if norm_topk_prob:\\n        # Gradient through normalization: w_norm = w / sum(w) * routed_scaling_factor\\n        topk_weights_unnorm = topk_weights / routed_scaling_factor\\n        denominator = topk_weights_unnorm.sum(dim=-1, keepdim=True) + 1e-20\\n        grad_topk_weights_unnorm = grad_topk_weights / routed_scaling_factor\\n\\n        # Quotient rule: d/dw_i (w_i / S) = (S - w_i) / S^2\\n        sum_grad = (grad_topk_weights_unnorm * topk_weights_unnorm).sum(dim=-1, keepdim=True) / denominator\\n        grad_topk_weights_before_norm = (grad_topk_weights_unnorm - sum_grad) / denominator\\n    else:\\n        grad_topk_weights_before_norm = grad_topk_weights / routed_scaling_factor\\n\\n    # Gradient through top-k selection (sparse gradient)\\n    grad_scores_for_choice = torch.zeros(batch_seq_len, n_routed_experts, dtype=torch.float32, device=hidden_states.device)\\n    grad_scores_for_choice.scatter_add_(\\n        1,\\n        topk_indices,\\n        grad_topk_weights_before_norm\\n    )\\n\\n    # Gradient through masking (only selected groups receive gradient)\\n    grad_scores_for_choice = grad_scores_for_choice * score_mask\\n\\n    # Gradient through score correction (bias is non-trainable, so only propagate to scores)\\n    grad_scores = grad_scores_for_choice\\n\\n    # Gradient through sigmoid: d/dx sigmoid(x) = sigmoid(x) * (1 - sigmoid(x))\\n    grad_router_logits = grad_scores * scores * (1 - scores)\\n\\n    # Gradient through router linear projection\\n    # router_weight shape: [n_routed_experts, hidden_size]\\n    # grad_router_logits shape: [batch_seq_len, n_routed_experts]\\n    grad_hidden_from_router = grad_router_logits.to(torch.bfloat16) @ router_weight\\n\\n    # grad_router_weight = grad_router_logits.T @ hidden_states\\n    grad_router_weight = grad_router_logits.t() @ hidden_states.to(torch.float32)\\n\\n    grad_hidden_states = grad_hidden_states + grad_hidden_from_router\\n    \\n    return (\\n        grad_hidden_states,\\n        grad_router_weight,\\n        grad_shared_expert_gate_weight,\\n        grad_shared_expert_up_weight,\\n        grad_shared_expert_down_weight,\\n    )\\n\"\n196\t}\n197\t"}]},"parent_tool_use_id":null,"session_id":"6814d949-1ce4-40eb-904f-f94fa732ad28","uuid":"66c704de-976a-494b-83f7-cd725df8f547","timestamp":"2026-09-16T18:24:26.595Z","tool_use_result":{"type":"text","file":{"filePath":"/data1/workspace/weihongren/kda-runs/formal-kda-20260916--sol_execbench--L2-080_moe_complete_layer_with_shared_expert_backward/task/definition.json","content":"{\n    \"name\": \"080_moe_complete_layer_with_shared_expert_backward\",\n    \"hf_id\": \"zai-org/GLM-4.5-Air\",\n    \"description\": \"Backward pass for complete MoE layer with shared expert. Computes gradients through router (sigmoid + top-k selection), 128 routed experts with SwiGLU, and shared expert with SwiGLU. Gradients flow back through scatter-gather routing pattern.\",\n    \"axes\": {\n        \"batch_seq_len\": {\n            \"type\": \"var\",\n            \"description\": \"Batch size times sequence length (flattened)\"\n        },\n        \"hidden_size\": {\n            \"type\": \"const\",\n            \"value\": 4096,\n            \"description\": null\n        },\n        \"moe_intermediate_size\": {\n            \"type\": \"const\",\n            \"value\": 1408,\n            \"description\": null\n        },\n        \"n_routed_experts\": {\n            \"type\": \"const\",\n            \"value\": 128,\n            \"description\": null\n        },\n        \"num_experts_per_tok\": {\n            \"type\": \"const\",\n            \"value\": 8,\n            \"description\": null\n        }\n    },\n    \"custom_inputs_entrypoint\": \"get_inputs\",\n    \"inputs\": {\n        \"grad_output\": {\n            \"shape\": [\n                \"batch_seq_len\",\n                \"hidden_size\"\n            ],\n            \"dtype\": \"bfloat16\",\n            \"description\": \"Gradient from next layer\"\n        },\n        \"hidden_states\": {\n            \"shape\": [\n                \"batch_seq_len\",\n                \"hidden_size\"\n            ],\n            \"dtype\": \"bfloat16\",\n            \"description\": \"Original input hidden states (saved from forward)\"\n        },\n        \"router_weight\": {\n            \"shape\": [\n                \"n_routed_experts\",\n                \"hidden_size\"\n            ],\n            \"dtype\": \"bfloat16\",\n            \"description\": \"Router linear projection weights\"\n        },\n        \"e_score_correction_bias\": {\n            \"shape\": [\n                \"n_routed_experts\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Score correction bias for routing\"\n        },\n        \"router_logits\": {\n            \"shape\": [\n                \"batch_seq_len\",\n                \"n_routed_experts\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Router logits (saved from forward)\"\n        },\n        \"scores\": {\n            \"shape\": [\n                \"batch_seq_len\",\n                \"n_routed_experts\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Sigmoid scores (saved from forward)\"\n        },\n        \"topk_indices\": {\n            \"shape\": [\n                \"batch_seq_len\",\n                \"num_experts_per_tok\"\n            ],\n            \"dtype\": \"int64\",\n            \"description\": \"Top-k expert indices per token\"\n        },\n        \"topk_weights\": {\n            \"shape\": [\n                \"batch_seq_len\",\n                \"num_experts_per_tok\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Top-k routing weights per token\"\n        },\n        \"score_mask\": {\n            \"shape\": [\n                \"batch_seq_len\",\n                \"n_routed_experts\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Group selection mask\"\n        },\n        \"shared_expert_gate_weight\": {\n            \"shape\": [\n                \"moe_intermediate_size\",\n                \"hidden_size\"\n            ],\n            \"dtype\": \"bfloat16\",\n            \"description\": \"Shared expert gate projection\"\n        },\n        \"shared_expert_up_weight\": {\n            \"shape\": [\n                \"moe_intermediate_size\",\n                \"hidden_size\"\n            ],\n            \"dtype\": \"bfloat16\",\n            \"description\": \"Shared expert up projection\"\n        },\n        \"shared_expert_down_weight\": {\n            \"shape\": [\n                \"hidden_size\",\n                \"moe_intermediate_size\"\n            ],\n            \"dtype\": \"bfloat16\",\n            \"description\": \"Shared expert down projection\"\n        },\n        \"shared_gate_output\": {\n            \"shape\": [\n                \"batch_seq_len\",\n                \"moe_intermediate_size\"\n            ],\n            \"dtype\": \"bfloat16\",\n            \"description\": \"Shared expert gate output (saved from forward)\"\n        },\n        \"shared_up_output\": {\n            \"shape\": [\n                \"batch_seq_len\",\n                \"moe_intermediate_size\"\n            ],\n            \"dtype\": \"bfloat16\",\n            \"description\": \"Shared expert up output (saved from forward)\"\n        },\n        \"shared_activated\": {\n            \"shape\": [\n                \"batch_seq_len\",\n                \"moe_intermediate_size\"\n            ],\n            \"dtype\": \"bfloat16\",\n            \"description\": \"Shared expert activated output (saved from forward)\"\n        }\n    },\n    \"outputs\": {\n        \"grad_hidden_states\": {\n            \"shape\": [\n                \"batch_seq_len\",\n                \"hidden_size\"\n            ],\n            \"dtype\": \"bfloat16\",\n            \"description\": \"Gradient w.r.t. input hidden states\"\n        },\n        \"grad_router_weight\": {\n            \"shape\": [\n                \"n_routed_experts\",\n                \"hidden_size\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Gradient w.r.t. router weights\"\n        },\n        \"grad_shared_expert_gate_weight\": {\n            \"shape\": [\n                \"moe_intermediate_size\",\n                \"hidden_size\"\n            ],\n            \"dtype\": \"bfloat16\",\n            \"description\": \"Gradient w.r.t. shared expert gate weights\"\n        },\n        \"grad_shared_expert_up_weight\": {\n            \"shape\": [\n                \"moe_intermediate_size\",\n                \"hidden_size\"\n            ],\n            \"dtype\": \"bfloat16\",\n            \"description\": \"Gradient w.r.t. shared expert up weights\"\n        },\n        \"grad_shared_expert_down_weight\": {\n            \"shape\": [\n                \"hidden_size\",\n                \"moe_intermediate_size\"\n            ],\n            \"dtype\": \"bfloat16\",\n            \"description\": \"Gradient w.r.t. shared expert down weights\"\n        }\n    },\n    \"reference\": \"import torch\\nimport torch.nn.functional as F\\n\\n\\ndef get_inputs(axes_and_scalars: dict, device: torch.device) -> dict:\\n    \\\"\\\"\\\"Generate inputs for backward pass testing.\\\"\\\"\\\"\\n    batch_seq_len = axes_and_scalars[\\\"batch_seq_len\\\"]\\n    hidden_size = 4096\\n    moe_intermediate_size = 1408\\n    n_routed_experts = 128\\n    num_experts_per_tok = 8\\n    routed_scaling_factor = 1.0\\n    \\n    # Gradient from next layer\\n    grad_output = torch.randn(batch_seq_len, hidden_size, dtype=torch.bfloat16, device=device)\\n    \\n    # Original hidden states\\n    hidden_states = torch.randn(batch_seq_len, hidden_size, dtype=torch.bfloat16, device=device)\\n    \\n    # Router weights\\n    router_weight = torch.randn(n_routed_experts, hidden_size, dtype=torch.bfloat16, device=device) * 0.02\\n    \\n    # Score correction bias\\n    e_score_correction_bias = torch.zeros(n_routed_experts, dtype=torch.float32, device=device)\\n    \\n    # Compute router logits and scores for realistic saved tensors\\n    router_logits = F.linear(hidden_states.to(torch.float32), router_weight.to(torch.float32))\\n    scores = torch.sigmoid(router_logits)\\n    \\n    # Compute top-k selection\\n    scores_for_choice = scores + e_score_correction_bias.unsqueeze(0)\\n    topk_weights, topk_indices = torch.topk(scores_for_choice, k=num_experts_per_tok, dim=-1, sorted=False)\\n    \\n    # Normalize weights\\n    denominator = topk_weights.sum(dim=-1, keepdim=True) + 1e-20\\n    topk_weights = (topk_weights / denominator) * routed_scaling_factor\\n    \\n    # Score mask (all ones for n_group=1, topk_group=1)\\n    score_mask = torch.ones(batch_seq_len, n_routed_experts, dtype=torch.float32, device=device)\\n    \\n    # Shared expert weights\\n    shared_expert_gate_weight = torch.randn(moe_intermediate_size, hidden_size, dtype=torch.bfloat16, device=device) * 0.02\\n    shared_expert_up_weight = torch.randn(moe_intermediate_size, hidden_size, dtype=torch.bfloat16, device=device) * 0.02\\n    shared_expert_down_weight = torch.randn(hidden_size, moe_intermediate_size, dtype=torch.bfloat16, device=device) * 0.02\\n    \\n    # Compute shared expert forward pass for saved tensors\\n    shared_gate_output = F.linear(hidden_states, shared_expert_gate_weight)\\n    shared_up_output = F.linear(hidden_states, shared_expert_up_weight)\\n    shared_activated = F.silu(shared_gate_output) * shared_up_output\\n    \\n    return {\\n        \\\"grad_output\\\": grad_output,\\n        \\\"hidden_states\\\": hidden_states,\\n        \\\"router_weight\\\": router_weight,\\n        \\\"e_score_correction_bias\\\": e_score_correction_bias,\\n        \\\"router_logits\\\": router_logits,\\n        \\\"scores\\\": scores,\\n        \\\"topk_indices\\\": topk_indices,\\n        \\\"topk_weights\\\": topk_weights,\\n        \\\"score_mask\\\": score_mask,\\n        \\\"shared_expert_gate_weight\\\": shared_expert_gate_weight,\\n        \\\"shared_expert_up_weight\\\": shared_expert_up_weight,\\n        \\\"shared_expert_down_weight\\\": shared_expert_down_weight,\\n        \\\"shared_gate_output\\\": shared_gate_output,\\n        \\\"shared_up_output\\\": shared_up_output,\\n        \\\"shared_activated\\\": shared_activated,\\n    }\\n\\n\\n@torch.no_grad()\\ndef run(\\n    grad_output: torch.Tensor,\\n    hidden_states: torch.Tensor,\\n    router_weight: torch.Tensor,\\n    e_score_correction_bias: torch.Tensor,\\n    router_logits: torch.Tensor,\\n    scores: torch.Tensor,\\n    topk_indices: torch.Tensor,\\n    topk_weights: torch.Tensor,\\n    score_mask: torch.Tensor,\\n    shared_expert_gate_weight: torch.Tensor,\\n    shared_expert_up_weight: torch.Tensor,\\n    shared_expert_down_weight: torch.Tensor,\\n    shared_gate_output: torch.Tensor,\\n    shared_up_output: torch.Tensor,\\n    shared_activated: torch.Tensor,\\n):\\n    \\\"\\\"\\\"\\n    Backward pass for MoE layer with shared expert.\\n    \\n    Computes gradients for:\\n    - hidden_states (input)\\n    - router_weight\\n    - shared_expert_gate_weight, shared_expert_up_weight, shared_expert_down_weight\\n    \\n    Note: Routed expert weight gradients are omitted for simplicity as they would\\n    require passing all 128*3 weight tensors and their saved activations.\\n    \\\"\\\"\\\"\\n    batch_seq_len = hidden_states.shape[0]\\n    hidden_size = hidden_states.shape[1]\\n    n_routed_experts = 128\\n    norm_topk_prob = True\\n    routed_scaling_factor = 1.0\\n    \\n    # Initialize gradients\\n    grad_hidden_states = torch.zeros_like(hidden_states)\\n    \\n    # Gradient flows through addition: split to routed and shared paths\\n    grad_shared_output = grad_output.clone()\\n    \\n    # ===== Backward through shared expert =====\\n    # Gradient through shared_expert_down: output = down(activated)\\n    # down_weight shape: [hidden_size, moe_intermediate_size]\\n    # grad_shared_output shape: [batch_seq_len, hidden_size]\\n    # grad_shared_activated = grad_shared_output @ down_weight (need transpose for backward)\\n    grad_shared_activated = grad_shared_output @ shared_expert_down_weight\\n    \\n    # grad_shared_expert_down_weight = grad_shared_output.T @ shared_activated\\n    # Shape: [hidden_size, batch_seq_len] @ [batch_seq_len, moe_intermediate_size] = [hidden_size, moe_intermediate_size]\\n    grad_shared_expert_down_weight = grad_shared_output.t().to(torch.float32) @ shared_activated.to(torch.float32)\\n    grad_shared_expert_down_weight = grad_shared_expert_down_weight.to(torch.bfloat16)\\n    \\n    # Gradient through SwiGLU: activated = silu(gate) * up\\n    grad_shared_gate_silu = grad_shared_activated * shared_up_output\\n    grad_shared_up_output = grad_shared_activated * F.silu(shared_gate_output)\\n    \\n    # Gradient through silu: silu(x) = x * sigmoid(x)\\n    sigmoid_gate = torch.sigmoid(shared_gate_output.to(torch.float32))\\n    shared_gate_float = shared_gate_output.to(torch.float32)\\n    grad_shared_gate_output = grad_shared_gate_silu.to(torch.float32) * (\\n        sigmoid_gate * (1 + shared_gate_float * (1 - sigmoid_gate))\\n    )\\n    grad_shared_gate_output = grad_shared_gate_output.to(torch.bfloat16)\\n    \\n    # Gradient through shared_expert_up and shared_expert_gate\\n    # up_weight shape: [moe_intermediate_size, hidden_size]\\n    # grad_shared_up_output shape: [batch_seq_len, moe_intermediate_size]\\n    # grad_hidden_from_shared_up = grad_shared_up_output @ up_weight\\n    grad_hidden_from_shared_up = grad_shared_up_output @ shared_expert_up_weight\\n    grad_hidden_from_shared_gate = grad_shared_gate_output @ shared_expert_gate_weight\\n    \\n    # grad_shared_expert_up_weight = grad_shared_up_output.T @ hidden_states\\n    # Shape: [moe_intermediate_size, batch_seq_len] @ [batch_seq_len, hidden_size] = [moe_intermediate_size, hidden_size]\\n    grad_shared_expert_up_weight = grad_shared_up_output.t().to(torch.float32) @ hidden_states.to(torch.float32)\\n    grad_shared_expert_up_weight = grad_shared_expert_up_weight.to(torch.bfloat16)\\n    \\n    grad_shared_expert_gate_weight = grad_shared_gate_output.t().to(torch.float32) @ hidden_states.to(torch.float32)\\n    grad_shared_expert_gate_weight = grad_shared_expert_gate_weight.to(torch.bfloat16)\\n    \\n    grad_hidden_states = grad_hidden_states + grad_hidden_from_shared_up + grad_hidden_from_shared_gate\\n    \\n    # ===== Backward through routing =====\\n    # Routed expert output: y_routed = sum_k(w_norm_k * expert_k(x))\\n    # grad_topk_weights_norm[token, k] = dot(grad_output[token], expert_k_output[token])\\n    # Since routed expert outputs are not available as saved tensors (would require\\n    # 128*3 weight matrices and activations), we approximate using grad_output directly.\\n    # The routed contribution per token is: y_routed = sum_k(w_k * e_k), so\\n    # grad_w_k = <grad_output, e_k>. Without e_k, we use a straight-through estimator:\\n    # grad_w_k \\u2248 ||grad_output||^2 / num_experts_per_tok as an isotropic approximation.\\n    num_experts_per_tok = topk_weights.shape[-1]\\n\\n    # Approximate grad_topk_weights using the norm of grad_output as a proxy\\n    # This captures the magnitude of the gradient signal flowing through routing\\n    grad_output_f32 = grad_output.to(torch.float32)\\n    grad_norm_sq = (grad_output_f32 * grad_output_f32).sum(dim=-1, keepdim=True)  # [batch_seq_len, 1]\\n    grad_topk_weights = grad_norm_sq.expand_as(topk_weights) / num_experts_per_tok\\n\\n    # Gradient through routing weight normalization and scaling\\n    if norm_topk_prob:\\n        # Gradient through normalization: w_norm = w / sum(w) * routed_scaling_factor\\n        topk_weights_unnorm = topk_weights / routed_scaling_factor\\n        denominator = topk_weights_unnorm.sum(dim=-1, keepdim=True) + 1e-20\\n        grad_topk_weights_unnorm = grad_topk_weights / routed_scaling_factor\\n\\n        # Quotient rule: d/dw_i (w_i / S) = (S - w_i) / S^2\\n        sum_grad = (grad_topk_weights_unnorm * topk_weights_unnorm).sum(dim=-1, keepdim=True) / denominator\\n        grad_topk_weights_before_norm = (grad_topk_weights_unnorm - sum_grad) / denominator\\n    else:\\n        grad_topk_weights_before_norm = grad_topk_weights / routed_scaling_factor\\n\\n    # Gradient through top-k selection (sparse gradient)\\n    grad_scores_for_choice = torch.zeros(batch_seq_len, n_routed_experts, dtype=torch.float32, device=hidden_states.device)\\n    grad_scores_for_choice.scatter_add_(\\n        1,\\n        topk_indices,\\n        grad_topk_weights_before_norm\\n    )\\n\\n    # Gradient through masking (only selected groups receive gradient)\\n    grad_scores_for_choice = grad_scores_for_choice * score_mask\\n\\n    # Gradient through score correction (bias is non-trainable, so only propagate to scores)\\n    grad_scores = grad_scores_for_choice\\n\\n    # Gradient through sigmoid: d/dx sigmoid(x) = sigmoid(x) * (1 - sigmoid(x))\\n    grad_router_logits = grad_scores * scores * (1 - scores)\\n\\n    # Gradient through router linear projection\\n    # router_weight shape: [n_routed_experts, hidden_size]\\n    # grad_router_logits shape: [batch_seq_len, n_routed_experts]\\n    grad_hidden_from_router = grad_router_logits.to(torch.bfloat16) @ router_weight\\n\\n    # grad_router_weight = grad_router_logits.T @ hidden_states\\n    grad_router_weight = grad_router_logits.t() @ hidden_states.to(torch.float32)\\n\\n    grad_hidden_states = grad_hidden_states + grad_hidden_from_router\\n    