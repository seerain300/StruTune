{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DNKhTXZ8kkQWjoB3WQ6oxu","type":"tool_result","content":"1\t{\n2\t    \"name\": \"058_moe_expert_token_radix_sort_with_prefix_sum\",\n3\t    \"hf_id\": \"inclusionAI/Ling-mini-2.0\",\n4\t    \"description\": \"MoE token sorting and bucketing using radix sort with prefix sum. Performs O(N) counting sort on bounded expert indices (0-255), computes prefix sum for cumulative offsets, and returns sorted token indices and expert boundaries. Critical for efficient MoE token-to-expert routing.\",\n5\t    \"axes\": {\n6\t        \"batch_size\": {\n7\t            \"type\": \"var\",\n8\t            \"description\": \"Batch size\"\n9\t        },\n10\t        \"seq_len\": {\n11\t            \"type\": \"var\",\n12\t            \"description\": \"Sequence length\"\n13\t        },\n14\t        \"num_experts\": {\n15\t            \"type\": \"const\",\n16\t            \"value\": 256,\n17\t            \"description\": \"Total number of experts\"\n18\t        },\n19\t        \"num_experts_per_tok\": {\n20\t            \"type\": \"const\",\n21\t            \"value\": 8,\n22\t            \"description\": \"Number of experts selected per token\"\n23\t        },\n24\t        \"num_tokens\": {\n25\t            \"type\": \"expr\",\n26\t            \"expression\": \"batch_size * seq_len * num_experts_per_tok\",\n27\t            \"description\": \"Total number of token-expert assignments\"\n28\t        },\n29\t        \"num_experts_plus_one\": {\n30\t            \"type\": \"expr\",\n31\t            \"expression\": \"num_experts + 1\",\n32\t            \"description\": \"Size of expert offsets array\"\n33\t        }\n34\t    },\n35\t    \"custom_inputs_entrypoint\": \"get_inputs\",\n36\t    \"inputs\": {\n37\t        \"topk_idx\": {\n38\t            \"shape\": [\n39\t                \"batch_size\",\n40\t                \"seq_len\",\n41\t                \"num_experts_per_tok\"\n42\t            ],\n43\t            \"dtype\": \"int32\",\n44\t            \"description\": \"Expert indices for each token, values in [0, num_experts-1]\"\n45\t        }\n46\t    },\n47\t    \"outputs\": {\n48\t        \"sorted_token_indices\": {\n49\t            \"shape\": [\n50\t                \"num_tokens\"\n51\t            ],\n52\t            \"dtype\": \"int32\",\n53\t            \"description\": \"Token indices sorted by expert assignment\"\n54\t        },\n55\t        \"expert_offsets\": {\n56\t            \"shape\": [\n57\t                \"num_experts_plus_one\"\n58\t            ],\n59\t            \"dtype\": \"int32\",\n60\t            \"description\": \"Cumulative offsets for expert boundaries, expert_offsets[i]:expert_offsets[i+1] gives token range for expert i\"\n61\t        }\n62\t    },\n63\t    \"reference\": \"import torch\\n\\n\\ndef get_inputs(\\n    axes_and_scalars: dict[str, ...], device: torch.device\\n) -> dict[str, torch.Tensor]:\\n    \\\"\\\"\\\"Generate inputs with valid expert indices in range [0, num_experts-1].\\\"\\\"\\\"\\n    batch_size = axes_and_scalars[\\\"batch_size\\\"]\\n    seq_len = axes_and_scalars[\\\"seq_len\\\"]\\n    num_experts = axes_and_scalars[\\\"num_experts\\\"]\\n    num_experts_per_tok = axes_and_scalars[\\\"num_experts_per_tok\\\"]\\n    \\n    # Generate random expert indices in valid range [0, num_experts-1]\\n    topk_idx = torch.randint(\\n        0, num_experts,\\n        (batch_size, seq_len, num_experts_per_tok),\\n        dtype=torch.int32,\\n        device=device\\n    )\\n    \\n    return {\\\"topk_idx\\\": topk_idx}\\n\\n\\n@torch.no_grad()\\ndef run(topk_idx: torch.Tensor):\\n    \\\"\\\"\\\"\\n    MoE token sorting using counting sort with prefix sum.\\n    \\n    Args:\\n        topk_idx: Expert indices (batch_size, seq_len, num_experts_per_tok)\\n                 with values in [0, num_experts-1]\\n    \\n    Returns:\\n        sorted_token_indices: Token indices sorted by expert (num_tokens,)\\n        expert_offsets: Cumulative offsets (num_experts+1,)\\n    \\\"\\\"\\\"\\n    num_experts = 256\\n    flat = topk_idx.reshape(-1)\\n\\n    # Stable sort on expert IDs = counting sort permutation\\n    _, sorted_token_indices = flat.sort(stable=True)\\n\\n    # Expert offsets via histogram + prefix sum\\n    expert_offsets = torch.zeros(num_experts + 1, dtype=torch.int32, device=flat.device)\\n    expert_offsets[1:] = torch.bincount(flat.long(), minlength=num_experts).cumsum(0).to(torch.int32)\\n\\n    return sorted_token_indices.to(torch.int32), expert_offsets\\n\"\n64\t}\n65\t"}]},"parent_tool_use_id":null,"session_id":"7604146c-ed96-4f13-996e-fef77b8439f9","uuid":"eec2e6bf-1013-49f5-bc05-2e536536ad31","timestamp":"2026-09-16T17:43:50.531Z","tool_use_result":{"type":"text","file":{"filePath":"/data1/workspace/weihongren/kda-runs/formal-kda-20260916--sol_execbench--L1-058_moe_expert_token_radix_sort_with_prefix_sum/task/definition.json","content":"{\n    \"name\": \"058_moe_expert_token_radix_sort_with_prefix_sum\",\n    \"hf_id\": \"inclusionAI/Ling-mini-2.0\",\n    \"description\": \"MoE token sorting and bucketing using radix sort with prefix sum. Performs O(N) counting sort on bounded expert indices (0-255), computes prefix sum for cumulative offsets, and returns sorted token indices and expert boundaries. Critical for efficient MoE token-to-expert routing.\",\n    \"axes\": {\n        \"batch_size\": {\n            \"type\": \"var\",\n            \"description\": \"Batch size\"\n        },\n        \"seq_len\": {\n            \"type\": \"var\",\n            \"description\": \"Sequence length\"\n        },\n        \"num_experts\": {\n            \"type\": \"const\",\n            \"value\": 256,\n            \"description\": \"Total number of experts\"\n        },\n        \"num_experts_per_tok\": {\n            \"type\": \"const\",\n            \"value\": 8,\n            \"description\": \"Number of experts selected per token\"\n        },\n        \"num_tokens\": {\n            \"type\": \"expr\",\n            \"expression\": \"batch_size * seq_len * num_experts_per_tok\",\n            \"description\": \"Total number of token-expert assignments\"\n        },\n        \"num_experts_plus_one\": {\n            \"type\": \"expr\",\n            \"expression\": \"num_experts + 1\",\n            \"description\": \"Size of expert offsets array\"\n        }\n    },\n    \"custom_inputs_entrypoint\": \"get_inputs\",\n    \"inputs\": {\n        \"topk_idx\": {\n            \"shape\": [\n                \"batch_size\",\n                \"seq_len\",\n                \"num_experts_per_tok\"\n            ],\n            \"dtype\": \"int32\",\n            \"description\": \"Expert indices for each token, values in [0, num_experts-1]\"\n        }\n    },\n    \"outputs\": {\n        \"sorted_token_indices\": {\n            \"shape\": [\n                \"num_tokens\"\n            ],\n            \"dtype\": \"int32\",\n            \"description\": \"Token indices sorted by expert assignment\"\n        },\n        \"expert_offsets\": {\n            \"shape\": [\n                \"num_experts_plus_one\"\n            ],\n            \"dtype\": \"int32\",\n            \"description\": \"Cumulative offsets for expert boundaries, expert_offsets[i]:expert_offsets[i+1] gives token range for expert i\"\n        }\n    },\n    \"reference\": \"import torch\\n\\n\\ndef get_inputs(\\n    axes_and_scalars: dict[str, ...], device: torch.device\\n) -> dict[str, torch.Tensor]:\\n    \\\"\\\"\\\"Generate inputs with valid expert indices in range [0, num_experts-1].\\\"\\\"\\\"\\n    batch_size = axes_and_scalars[\\\"batch_size\\\"]\\n    seq_len = axes_and_scalars[\\\"seq_len\\\"]\\n    num_experts = axes_and_scalars[\\\"num_experts\\\"]\\n    num_experts_per_tok = axes_and_scalars[\\\"num_experts_per_tok\\\"]\\n    \\n    # Generate random expert indices in valid range [0, num_experts-1]\\n    topk_idx = torch.randint(\\n        0, num_experts,\\n        (batch_size, seq_len, num_experts_per_tok),\\n        dtype=torch.int32,\\n        device=device\\n    )\\n    \\n    return {\\\"topk_idx\\\": topk_idx}\\n\\n\\n@torch.no_grad()\\ndef run(topk_idx: torch.Tensor):\\n    \\\"\\\"\\\"\\n    MoE token sorting using counting sort with prefix sum.\\n    \\n    Args:\\n        topk_idx: Expert indices (batch_size, seq_len, num_experts_per_tok)\\n                 with values in [0, num_experts-1]\\n    \\n    Returns:\\n        sorted_token_indices: Token indices sorted by expert (num_tokens,)\\n        expert_offsets: Cumulative offsets (num_experts+1,)\\n    \\\"\\\"\\\"\\n    num_experts = 256\\n    flat = topk_idx.reshape(-1)\\n\\n    # Stable sort on expert IDs = counting sort permutation\\n    _, sorted_token_indices = flat.sort(stable=True)\\n\\n    # Expert offsets via histogram + prefix sum\\n    expert_offsets = torch.zeros(num_experts + 1, dtype=torch.int32, device=flat.device)\\n    expert_offsets[1:] = torch.bincount(flat.long(), minlength=num_experts).cumsum(0).to(torch.int32)\\n\\n    return sorted_token_indices.to(torch.int32), expert_offsets\\n\"\n}\n","numLines":65,"startLine":1,"totalLines":65}}}
