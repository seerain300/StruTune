{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LqTwYcCwJKWbT6QT9QnomE","type":"tool_result","content":"1\t\"\"\"\n2\tSolution for L1/058 MoE Expert Token Radix Sort with Prefix Sum.\n3\t\n4\tTarget: NVIDIA A800 (sm_80, Ampere). Implementation is Triton; PyTorch is used\n5\tonly for tensor allocation / metadata / launch plumbing (no computational fallback).\n6\t\n7\tReference semantics reproduced EXACTLY (integer, exact-match):\n8\t    flat = topk_idx.reshape(-1)                      # C-order, length N, values in [0,255]\n9\t    _, sorted_token_indices = flat.sort(stable=True) # stable argsort by expert id\n10\t    expert_offsets[0]   = 0\n11\t    expert_offsets[e+1] = sum_{j<=e} count[j]        # inclusive prefix of the histogram\n12\t\n13\tPipeline (candidate c001):\n14\t    K1  hist_kernel    : atomic 256-bin histogram of flat            (grid = ceil(N/BLOCK))\n15\t    K2  prefix_kernel  : inclusive prefix sum -> expert_offsets[1:]  (grid = 1)\n16\t    K3  scatter_kernel : expert-parallel stable scatter (Scheme S1)  (grid = 256)\n17\t\n18\tStability (decisive): in K3 each program owns one expert e and scans `flat` in\n19\tascending tile order; within a tile the exclusive cumsum of the (v==e) mask gives\n20\teach matched lane its rank, and lanes carry ascending flat indices. So matched\n21\tindices are written in strictly ascending order -> matches torch.sort(stable=True).\n22\tEach program writes only into its disjoint slice [base, base+count) -> no output\n23\tatomics, no write races, fully deterministic.\n24\t\"\"\"\n25\t\n26\timport torch\n27\timport triton\n28\timport triton.language as tl\n29\t\n30\tNUM_EXPERTS = 256\n31\t\n32\t\n33\t@triton.jit\n34\tdef hist_kernel(flat_ptr, counts_ptr, N, BLOCK: tl.constexpr):\n35\t    pid = tl.program_id(0)\n36\t    off = pid * BLOCK + tl.arange(0, BLOCK)\n37\t    mask = off < N\n38\t    v = tl.load(flat_ptr + off, mask=mask, other=0)\n39\t    # Commutative counting -> order-independent -> stability-safe.\n40\t    tl.atomic_add(counts_ptr + v, 1, mask=mask)\n41\t\n42\t\n43\t@triton.jit\n44\tdef prefix_kernel(counts_ptr, offsets_ptr, E: tl.constexpr):\n45\t    e = tl.arange(0, E)\n46\t    c = tl.load(counts_ptr + e)\n47\t    inc = tl.cumsum(c, axis=0)            # inclusive prefix, inc[e] = sum_{j<=e} c[j]\n48\t    tl.store(offsets_ptr + 1 + e, inc)    # offsets[0] left as 0 (pre-zeroed alloc)\n49\t\n50\t\n51\t@triton.jit\n52\tdef scatter_kernel(flat_ptr, offsets_ptr, out_ptr, N, BLOCK: tl.constexpr):\n53\t    e = tl.program_id(0)                  # this program owns expert e\n54\t    base = tl.load(offsets_ptr + e)       # exclusive prefix = write base for expert e\n55\t    running = tl.zeros((), dtype=tl.int32)\n56\t    num_tiles = tl.cdiv(N, BLOCK)\n57\t    for t in range(0, num_tiles):\n58\t        off = t * BLOCK + tl.arange(0, BLOCK)\n59\t        mask = off < N\n60\t        v = tl.load(flat_ptr + off, mask=mask, other=-1)\n61\t        m = (v == e) & mask               # masked/tail lanes never match (other=-1)\n62\t        mi = m.to(tl.int32)\n63\t        excl = tl.cumsum(mi, axis=0) - mi  # exclusive within-tile rank of matches\n64\t        pos = base + running + excl\n65\t        tl.store(out_ptr + pos, off.to(tl.int32), mask=m)\n66\t        running += tl.sum(mi)\n67\t\n68\t\n69\t@torch.no_grad()\n70\tdef run(topk_idx: torch.Tensor):\n71\t    # Plumbing only: C-contiguous flatten to match reshape(-1).\n72\t    flat = topk_idx.reshape(-1).contiguous()\n73\t    if flat.dtype != torch.int32:\n74\t        flat = flat.to(torch.int32)\n75\t    N = flat.numel()\n76\t    device = flat.device\n77\t\n78\t    counts = torch.zeros(NUM_EXPERTS, dtype=torch.int32, device=device)\n79\t    expert_offsets = torch.zeros(NUM_EXPERTS + 1, dtype=torch.int32, device=device)\n80\t    sorted_token_indices = torch.empty(N, dtype=torch.int32, device=device)\n81\t\n82\t    BLOCK_H = 1024\n83\t    BLOCK_S = 1024\n84\t\n85\t    hist_kernel[(triton.cdiv(N, BLOCK_H),)](\n86\t        flat, counts, N, BLOCK=BLOCK_H, num_warps=4\n87\t    )\n88\t    prefix_kernel[(1,)](\n89\t        counts, expert_offsets, E=NUM_EXPERTS, num_warps=4\n90\t    )\n91\t    scatter_kernel[(NUM_EXPERTS,)](\n92\t        flat, expert_offsets, sorted_token_indices, N, BLOCK=BLOCK_S, num_warps=4\n93\t    )\n94\t\n95\t    return sorted_token_indices, expert_offsets\n96\t"}]},"parent_tool_use_id":null,"session_id":"7604146c-ed96-4f13-996e-fef77b8439f9","uuid":"e9a14999-37e4-4dae-949b-c39b0829271b","timestamp":"2026-09-16T17:54:04.146Z","tool_use_result":{"type":"text","file":{"filePath":"/data1/workspace/weihongren/kda-runs/formal-kda-20260916--sol_execbench--L1-058_moe_expert_token_radix_sort_with_prefix_sum/solution/solution.py","content":"\"\"\"\nSolution for L1/058 MoE Expert Token Radix Sort with Prefix Sum.\n\nTarget: NVIDIA A800 (sm_80, Ampere). Implementation is Triton; PyTorch is used\nonly for tensor allocation / metadata / launch plumbing (no computational fallback).\n\nReference semantics reproduced EXACTLY (integer, exact-match):\n    flat = topk_idx.reshape(-1)                      # C-order, length N, values in [0,255]\n    _, sorted_token_indices = flat.sort(stable=True) # stable argsort by expert id\n    expert_offsets[0]   = 0\n    expert_offsets[e+1] = sum_{j<=e} count[j]        # inclusive prefix of the histogram\n\nPipeline (candidate c001):\n    K1  hist_kernel    : atomic 256-bin histogram of flat            (grid = ceil(N/BLOCK))\n    K2  prefix_kernel  : inclusive prefix sum -> expert_offsets[1:]  (grid = 1)\n    K3  scatter_kernel : expert-parallel stable scatter (Scheme S1)  (grid = 256)\n\nStability (decisive): in K3 each program owns one expert e and scans `flat` in\nascending tile order; within a tile the exclusive cumsum of the (v==e) mask gives\neach matched lane its rank, and lanes carry ascending flat indices. So matched\nindices are written in strictly ascending order -> matches torch.sort(stable=True).\nEach program writes only into its disjoint slice [base, base+count) -> no output\natomics, no write races, fully deterministic.\n\"\"\"\n\nimport torch\nimport triton\nimport triton.language as tl\n\nNUM_EXPERTS = 256\n\n\n@triton.jit\ndef hist_kernel(flat_ptr, counts_ptr, N, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    off = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = off < N\n    v = tl.load(flat_ptr + off, mask=mask, other=0)\n    # Commutative counting -> order-independent -> stability-safe.\n    tl.atomic_add(counts_ptr + v, 1, mask=mask)\n\n\n@triton.jit\ndef prefix_kernel(counts_ptr, offsets_ptr, E: tl.constexpr):\n    e = tl.arange(0, E)\n    c = tl.load(counts_ptr + e)\n    inc = tl.cumsum(c, axis=0)            # inclusive prefix, inc[e] = sum_{j<=e} c[j]\n    tl.store(offsets_ptr + 1 + e, inc)    # offsets[0] left as 0 (pre-zeroed alloc)\n\n\n@triton.jit\ndef scatter_kernel(flat_ptr, offsets_ptr, out_ptr, N, BLOCK: tl.constexpr):\n    e = tl.program_id(0)                  # this program owns expert e\n    base = tl.load(offsets_ptr + e)       # exclusive prefix = write base for expert e\n    running = tl.zeros((), dtype=tl.int32)\n    num_tiles = tl.cdiv(N, BLOCK)\n    for t in range(0, num_tiles):\n        off = t * BLOCK + tl.arange(0, BLOCK)\n        mask = off < N\n        v = tl.load(flat_ptr + off, mask=mask, other=-1)\n        m = (v == e) & mask               # masked/tail lanes never match (other=-1)\n        mi = m.to(tl.int32)\n        excl = tl.cumsum(mi, axis=0) - mi  # exclusive within-tile rank of matches\n        pos = base + running + excl\n        tl.store(out_ptr + pos, off.to(tl.int32), mask=m)\n        running += tl.sum(mi)\n\n\n@torch.no_grad()\ndef run(topk_idx: torch.Tensor):\n    # Plumbing only: C-contiguous flatten to match reshape(-1).\n    flat = topk_idx.reshape(-1).contiguous()\n    if flat.dtype != torch.int32:\n        flat = flat.to(torch.int32)\n    N = flat.numel()\n    device = flat.device\n\n    counts = torch.zeros(NUM_EXPERTS, dtype=torch.int32, device=device)\n    expert_offsets = torch.zeros(NUM_EXPERTS + 1, dtype=torch.int32, device=device)\n    sorted_token_indices = torch.empty(N, dtype=torch.int32, device=device)\n\n    BLOCK_H = 1024\n    BLOCK_S = 1024\n\n    hist_kernel[(triton.cdiv(N, BLOCK_H),)](\n        flat, counts, N, BLOCK=BLOCK_H, num_warps=4\n    )\n    prefix_kernel[(1,)](\n        counts, expert_offsets, E=NUM_EXPERTS, num_warps=4\n    )\n    scatter_kernel[(NUM_EXPERTS,)](\n        flat, expert_offsets, sorted_token_indices, N, BLOCK=BLOCK_S, num_warps=4\n    )\n\n    return sorted_token_indices, expert_offsets\n","numLines":96,"startLine":1,"totalLines":96}}}
