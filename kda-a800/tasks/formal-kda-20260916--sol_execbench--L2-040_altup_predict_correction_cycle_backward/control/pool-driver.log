ility\"\n        }\n    },\n    \"outputs\": {\n        \"grad_hidden_states\": {\n            \"shape\": [\n                \"altup_num_inputs\",\n                \"batch_size\",\n                \"seq_len\",\n                \"hidden_size\"\n            ],\n            \"dtype\": \"bfloat16\",\n            \"description\": \"Gradient w.r.t. hidden states\"\n        },\n        \"grad_activated\": {\n            \"shape\": [\n                \"batch_size\",\n                \"seq_len\",\n                \"hidden_size\"\n            ],\n            \"dtype\": \"bfloat16\",\n            \"description\": \"Gradient w.r.t. activated output\"\n        },\n        \"grad_prediction_coef_weight\": {\n            \"shape\": [\n                \"altup_num_inputs_sq\",\n                \"altup_num_inputs\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Gradient w.r.t. prediction coefficient weight\"\n        },\n        \"grad_correction_coef_weight\": {\n            \"shape\": [\n                \"altup_num_inputs\",\n                \"altup_num_inputs\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Gradient w.r.t. correction coefficient weight\"\n        },\n        \"grad_router_weight\": {\n            \"shape\": [\n                \"altup_num_inputs\",\n                \"hidden_size\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Gradient w.r.t. router weight\"\n        },\n        \"grad_norm_weight\": {\n            \"shape\": [\n                \"hidden_size\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Gradient w.r.t. norm weight\"\n        }\n    },\n    \"reference\": \"import torch\\nimport torch.nn.functional as F\\n\\n\\n@torch.no_grad()\\ndef run(\\n    grad_corrected: torch.Tensor,\\n    hidden_states: torch.Tensor,\\n    activated: torch.Tensor,\\n    prediction_coef_weight: torch.Tensor,\\n    correctio