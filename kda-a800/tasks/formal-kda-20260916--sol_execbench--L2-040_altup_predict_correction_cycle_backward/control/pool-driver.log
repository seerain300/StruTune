ent\": \"c012\", \"source_hash\": \"16f98479565970611294b476dca5c3ca542ebf24d558fb45db93b544214cc9b2\", \"design\": \"Design B row-blocking, identical kernel/math to c012; BLOCK_ROWS 16 -> 8 at the winning num_warps=8 (BLOCK_H=4096). Tests BRxnum_warps interaction (BR knee was measured at num_warps=16).\", \"hypothesis\": \"At num_warps=8 the BR knee may shift lower; BR=8 gives more programs (better small-B occupancy) and may beat c012's BR=16\", \"change_from_parent\": \"BLOCK_ROWS 16 -> 8 (pure config; num_warps=8 as c012; math identical)\", \"validation\": {\"analytic_checks\": \"kernel math identical to c012 (verified); config-only\", \"shape_dtype_audit\": \"unchanged; PASSED on evaluator\"}, \"per_workload\": [{\"uuid\": \"fcd64c92-9a71-592e-ab33-71843be9270f\", \"B\": 64, \"S\": 613, \"status\": \"PASSED\", \"pass\": true, \"speedup\": 12.2431, \"ref_ms\": 88.068676, \"sol_ms\": 7.193343, \"max_abs\": 0.03125, \"max_rel\": 0.0078125}, {\"uuid\": \"5834489e-1f51-5995-b499-8765bd31a705\", \"B\": 64, \"S\": 128, \"status\": \"PASSED\", \"pass\": true, \"speedup\": 11.8038, \"ref_ms\": 18.9612455, \"sol_ms\": 1.606362, \"max_abs\": 0.03125, \"max_rel\": 0.0078125}, {\"uuid\": \"f2508211-757f-5c74-a08a-621ce070f77d\", \"B\": 4, \"S\": 256, \"status\": \"PASSED\", \"pass\": true, \"speedup\": 7.4576, \"ref_ms\": 2.890779, \"sol_ms\": 0.387627, \"max_abs\": 0.03125, \"max_rel\": 0.007751937955617905}, {\"uuid\": \"e9c4303d-4391-5cb3-a6e1-674c1d19bbfd\", \"B\": 64, \"S\": 256, \"status\": \"PASSED\", \"pass\": true, \"speedup\": 12.0375, \"ref_ms\": 37.1535635, \"sol_ms\": 3.086487, \"max_abs\": 0.03125, \"max_rel\": 0.0078125}, {\"uuid\": \"a6c812e5-eb06-5abe-a527-84583b7e08ba\", \"B\": 8, \"S\": 373, \"status\": \"PASSED\", \"pass\": true, \"speedup\": 10.0723, \"ref_ms\": 7.2327855, \"sol_ms\": 0.718087, \"max_abs\": 0.03125, \"max_rel\": 0.0078125}], \"geomean_speedup\": 10.549597332314857, \"all_pass\": true, \"decision\": \"revert\", \"reason\": \"REGRESSION vs