{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KqRinc4jK6yTTQ7RmiNu5W","type":"tool_result","content":"1\timport torch\n2\timport triton\n3\timport triton.language as tl\n4\t\n5\t\n6\t# ---------------------------------------------------------------------------\n7\t# L1/008 expert_output_weighted_index_add_accumulation\n8\t#\n9\t# Semantics (reference):\n10\t#   output = final_hidden_states.clone()\n11\t#   output.index_add_(0, token_indices, expert_outputs)   # output[idx[i]] += src[i]\n12\t#\n13\t# Candidate c001 = Option B0 (docs/plan.md §3):\n14\t#   1. init:     fp32 scratch buf[M,H] <- base (cast bf16 -> fp32)\n15\t#   2. scatter:  buf[idx[i]] += expert_outputs[i].to(fp32)   via native fp32 atomics\n16\t#   3. finalize: output[M,H] (bf16) <- buf   (cast fp32 -> bf16, round once)\n17\t#\n18\t# All compute is in Triton. PyTorch is used only for tensor allocation/metadata.\n19\t# fp32 accumulation + single final rounding is >= as accurate as the reference's\n20\t# repeatedly-rounded bf16 CAS accumulation, so it stays within tolerance.\n21\t# ---------------------------------------------------------------------------\n22\t\n23\t\n24\t@triton.jit\n25\tdef _init_copy_kernel(\n26\t    src_ptr,          # bf16 [M, H]  (final_hidden_states)\n27\t    dst_ptr,          # fp32 [M, H]  (buf)\n28\t    M, H,\n29\t    BLOCK_H: tl.constexpr,\n30\t):\n31\t    pid_m = tl.program_id(0)\n32\t    pid_h = tl.program_id(1)\n33\t    offs_h = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)\n34\t    mask = offs_h < H\n35\t    row = pid_m.to(tl.int64) * H\n36\t    x = tl.load(src_ptr + row + offs_h, mask=mask, other=0.0)\n37\t    tl.store(dst_ptr + row + offs_h, x.to(tl.float32), mask=mask)\n38\t\n39\t\n40\t@triton.jit\n41\tdef _scatter_add_kernel(\n42\t    src_ptr,          # bf16 [N, H]  (expert_outputs)\n43\t    idx_ptr,          # int64 [N]    (token_indices)\n44\t    buf_ptr,          # fp32 [M, H]  (accumulation scratch)\n45\t    N, H,\n46\t    BLOCK_H: tl.const