{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014ptbhkvJvrFViKqrqCxhHf","type":"tool_result","content":"1\t{\n2\t    \"name\": \"049_group_limited_topk_routing\",\n3\t    \"hf_id\": \"inclusionAI/Ring-flash-2.0\",\n4\t    \"description\": \"Group-limited top-k expert routing for Mixture of Experts. Implements a two-stage selection: first organizes 256 experts into 8 groups, computes group scores by summing top-2 expert scores within each group, selects top-4 groups, then picks top-8 experts from selected groups. Returns selected expert indices and normalized routing weights scaled by routed_scaling_factor.\",\n5\t    \"axes\": {\n6\t        \"num_tokens\": {\n7\t            \"type\": \"var\",\n8\t            \"description\": \"Number of tokens (batch_size * seq_len)\"\n9\t        },\n10\t        \"num_experts\": {\n11\t            \"type\": \"const\",\n12\t            \"value\": 256,\n13\t            \"description\": \"Total number of experts\"\n14\t        },\n15\t        \"num_experts_per_tok\": {\n16\t            \"type\": \"const\",\n17\t            \"value\": 8,\n18\t            \"description\": \"Number of experts selected per token (top_k)\"\n19\t        },\n20\t        \"n_group\": {\n21\t            \"type\": \"const\",\n22\t            \"value\": 8,\n23\t            \"description\": \"Number of expert groups\"\n24\t        },\n25\t        \"topk_group\": {\n26\t            \"type\": \"const\",\n27\t            \"value\": 4,\n28\t            \"description\": \"Number of groups to select\"\n29\t        },\n30\t        \"gating_dim\": {\n31\t            \"type\": \"const\",\n32\t            \"value\": 4096,\n33\t            \"description\": \"Hidden dimension for gating\"\n34\t        },\n35\t        \"experts_per_group\": {\n36\t            \"type\": \"expr\",\n37\t            \"expression\": \"num_experts // n_group\",\n38\t            \"description\": \"Number of experts per group (32)\"\n39\t        }\n40\t    },\n41\t    \"custom_inputs_entrypoint\": null,\n42\t    \"inputs\": {\n43\t        \"hidden_states\": {\n44\t            \"shape\": [\n45\t                \"num_tokens\",\n46\t                \"gating_dim\"\n47\t            ],\n48\t            \"dtype\": \"bfloat16\",\n49\t            \"description\": \"Input token representations\"\n50\t        },\n51\t        \"weight\": {\n52\t            \"shape\": [\n53\t                \"num_experts\",\n54\t                \"gating_dim\"\n55\t            ],\n56\t            \"dtype\": \"bfloat16\",\n57\t            \"description\": \"Routing weight matrix\"\n58\t        },\n59\t        \"expert_bias\": {\n60\t            \"shape\": [\n61\t                \"num_experts\"\n62\t            ],\n63\t            \"dtype\": \"bfloat16\",\n64\t            \"description\": \"Expert bias for routing adjustment\"\n65\t        },\n66\t        \"routed_scaling_factor\": {\n67\t            \"shape\": null,\n68\t            \"dtype\": \"float32\",\n69\t            \"description\": \"Scaling factor for routing weights\"\n70\t        }\n71\t    },\n72\t    \"outputs\": {\n73\t        \"topk_idx\": {\n74\t            \"shape\": [\n75\t                \"num_tokens\",\n76\t                \"num_experts_per_tok\"\n77\t            ],\n78\t            \"dtype\": \"int64\",\n79\t            \"description\": \"Selected expert indices\"\n80\t        },\n81\t        \"topk_weight\": {\n82\t            \"shape\": [\n83\t                \"num_tokens\",\n84\t                \"num_experts_per_tok\"\n85\t            ],\n86\t            \"dtype\": \"float32\",\n87\t            \"description\": \"Normalized and scaled routing weights\"\n88\t        }\n89\t    },\n90\t    \"reference\": \"import torch\\nimport torch.nn.functional as F\\n\\n@torch.no_grad()\\ndef run(\\n    hidden_states: torch.Tensor,\\n    weight: torch.Tensor,\\n    expert_bias: torch.Tensor,\\n    routed_scaling_factor: float,\\n):\\n    \\\"\\\"\\\"\\n    Group-limited top-k expert routing.\\n    \\n    Two-stage selection:\\n    1. Organize 256 experts into 8 groups of 32\\n    2. Compute group scores by summing top-2 expert scores within each group\\n    3. Select top-4 groups based on group scores\\n    4. Mask out experts from non-selected groups\\n    5. Select top-8 experts from remaining candidates\\n    6. Normalize weights and apply scaling factor\\n    \\\"\\\"\\\"\\n    # Constants\\n    num_experts = 256\\n    top_k = 8\\n    n_group = 8\\n    topk_group = 4\\n    experts_per_group = num_experts // n_group  # 32\\n    \\n    num_tokens = hidden_states.shape[0]\\n    \\n    # Compute routing logits: [num_tokens, 256]\\n    logits = F.linear(\\n        hidden_states.to(torch.float32),\\n        weight.to(torch.float32)\\n    )\\n    \\n    # Apply sigmoid activation to get routing scores\\n    scores = torch.sigmoid(logits)  # [num_tokens, 256]\\n    \\n    # Add learned expert bias for routing adjustment\\n    scores_for_routing = scores + expert_bias.to(torch.float32)\\n    \\n    # Step 1: Reshape scores into groups [num_tokens, 8, 32]\\n    group_scores_reshaped = scores_for_routing.view(num_tokens, n_group, experts_per_group)\\n    \\n    # Step 2: Get top-2 scores within each group and sum them\\n    # [num_tokens, 8, 2] -> [num_tokens, 8]\\n    top2_vals, _ = torch.topk(group_scores_reshaped, k=2, dim=-1, largest=True, sorted=False)\\n    group_scores = top2_vals.sum(dim=-1)  # [num_tokens, 8]\\n    \\n    # Step 3: Select top-4 groups based on aggregated scores\\n    # [num_tokens, 4]\\n    _, group_idx = torch.topk(group_scores, k=topk_group, dim=-1, sorted=False)\\n    \\n    # Step 4: Create group mask [num_tokens, 8]\\n    group_mask = torch.zeros_like(group_scores)\\n    group_mask.scatter_(1, group_idx, 1.0)\\n    \\n    # Step 5: Expand mask to expert level [num_tokens, 256]\\n    score_mask = (\\n        group_mask.unsqueeze(-1)\\n        .expand(num_tokens, n_group, experts_per_group)\\n        .reshape(num_tokens, num_experts)\\n    )\\n    \\n    # Step 6: Mask out experts from non-selected groups\\n    neg_inf = torch.finfo(torch.float32).min\\n    masked_scores = scores_for_routing.masked_fill(score_mask == 0, neg_inf)\\n    \\n    # Step 7: Select top-8 experts from masked scores\\n    _, topk_idx = torch.topk(masked_scores, k=top_k, dim=-1, sorted=False)\\n    \\n    # Gather selected expert scores (use original scores without bias)\\n    selected_scores = torch.gather(scores, dim=1, index=topk_idx)\\n    \\n    # Normalize routing weights\\n    topk_weight = selected_scores / (selected_scores.sum(dim=-1, keepdim=True) + 1e-20)\\n    \\n    # Apply routing scaling factor\\n    topk_weight = topk_weight * routed_scaling_factor\\n    \\n    return topk_idx, topk_weight\\n\"\n91\t}\n92\t"}]},"parent_tool_use_id":null,"session_id":"a1f92ccf-4f21-4b34-84a4-e4e371081372","uuid":"428110b9-b2b4-4d9e-9634-35c98b4f05e9","timestamp":"2026-09-16T18:10:54.406Z","tool_use_result":{"type":"text","file":{"filePath":"/data1/workspace/weihongren/kda-runs/formal-kda-20260916--sol_execbench--L2-049_group_limited_topk_routing/task/definition.json","content":"{\n    \"name\": \"049_group_limited_topk_routing\",\n    \"hf_id\": \"inclusionAI/Ring-flash-2.0\",\n    \"description\": \"Group-limited top-k expert routing for Mixture of Experts. Implements a two-stage selection: first organizes 256 experts into 8 groups, computes group scores by summing top-2 expert scores within each group, selects top-4 groups, then picks top-8 experts from selected groups. Returns selected expert indices and normalized routing weights scaled by routed_scaling_factor.\",\n    \"axes\": {\n        \"num_tokens\": {\n            \"type\": \"var\",\n            \"description\": \"Number of tokens (batch_size * seq_len)\"\n        },\n        \"num_experts\": {\n            \"type\": \"const\",\n            \"value\": 256,\n            \"description\": \"Total number of experts\"\n        },\n        \"num_experts_per_tok\": {\n            \"type\": \"const\",\n            \"value\": 8,\n            \"description\": \"Number of experts selected per token (top_k)\"\n        },\n        \"n_group\": {\n            \"type\": \"const\",\n            \"value\": 8,\n            \"description\": \"Number of expert groups\"\n        },\n        \"topk_group\": {\n            \"type\": \"const\",\n            \"value\": 4,\n            \"description\": \"Number of groups to select\"\n        },\n        \"gating_dim\": {\n            \"type\": \"const\",\n            \"value\": 4096,\n            \"description\": \"Hidden dimension for gating\"\n        },\n        \"experts_per_group\": {\n            \"type\": \"expr\",\n            \"expression\": \"num_experts // n_group\",\n            \"description\": \"Number of experts per group (32)\"\n        }\n    },\n    \"custom_inputs_entrypoint\": null,\n    \"inputs\": {\n        \"hidden_states\": {\n            \"shape\": [\n                \"num_tokens\",\n                \"gating_dim\"\n            ],\n            \"dtype\": \"bfloat16\",\n            \"description\": \"Input token representations\"\n        },\n        \"weight\": {\n            \"shape\": [\n                \"num_experts\",\n                \"gating_dim\"\n            ],\n            \"dtype\": \"bfloat16\",\n            \"description\": \"Routing weight matrix\"\n        },\n        \"expert_bias\": {\n            \"shape\": [\n                \"num_experts\"\n            ],\n            \"dtype\": \"bfloat16\",\n            \"description\": \"Expert bias for routing adjustment\"\n        },\n        \"routed_scaling_factor\": {\n            \"shape\": null,\n            \"dtype\": \"float32\",\n            \"description\": \"Scaling factor for routing weights\"\n        }\n    },\n    \"outputs\": {\n        \"topk_idx\": {\n            \"shape\": [\n                \"num_tokens\",\n                \"num_experts_per_tok\"\n            ],\n            \"dtype\": \"int64\",\n            \"description\": \"Selected expert indices\"\n        },\n        \"topk_weight\": {\n            \"shape\": [\n                \"num_tokens\",\n                \"num_experts_per_tok\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Normalized and scaled routing weights\"\n        }\n    },\n    \"reference\": \"import torch\\nimport torch.nn.functional as F\\n\\n@torch.no_grad()\\ndef run(\\n    hidden_states: torch.Tensor,\\n    weight: torch.Tensor,\\n    expert_bias: torch.Tensor,\\n    routed_scaling_factor: float,\\n):\\n    \\\"\\\"\\\"\\n    Group-limited top-k expert routing.\\n    \\n    Two-stage selection:\\n    1. Organize 256 experts into 8 groups of 32\\n    2. Compute group scores by summing top-2 expert scores within each group\\n    3. Select top-4 groups based on group scores\\n    4. Mask out experts from non-selected groups\\n    5. Select top-8 experts from remaining candidates\\n    6. Normalize weights and apply scaling factor\\n    \\\"\\\"\\\"\\n    # Constants\\n    num_experts = 256\\n    top_k = 8\\n    n_group = 8\\n    topk_group = 4\\n    experts_per_group = num_experts // n_group  # 32\\n    \\n    num_tokens = hidden_states.shape[0]\\n    \\n    # Compute routing logits: [num_tokens, 256]\\n    logits = F.linear(\\n        hidden_states.to(torch.float32),\\n        weight.to(torch.float32)\\n    )\\n    \\n    # Apply sigmoid activation to get routing scores\\n    scores = torch.sigmoid(logits)  # [num_tokens, 256]\\n    \\n    # Add learned expert bias for routing adjustment\\n    scores_for_routing = scores + expert_bias.to(torch.float32)\\n    \\n    # Step 1: Reshape scores into groups [num_tokens, 8, 32]\\n    group_scores_reshaped = scores_for_routing.view(num_tokens, n_group, experts_per_group)\\n    \\n    # Step 2: Get top-2 scores within each group and sum them\\n    # [num_tokens, 8, 2] -> [num_tokens, 8]\\n    top2_vals, _ = torch.topk(group_scores_reshaped, k=2, dim=-1, largest=True, sorted=False)\\n    group_scores = top2_vals.sum(dim=-1)  # [num_tokens, 8]\\n    \\n    # Step 3: Select top-4 groups based on aggregated scores\\n    # [num_tokens, 4]\\n    _, group_idx = torch.topk(group_scores, k=topk_group, dim=-1, sorted=False)\\n    \\n    # Step 4: Create group mask [num_tokens, 8]\\n    group_mask = torch.zeros_like(group_scores)\\n    group_mask.scatter_(1, group_idx, 1.0)\\n    \\n    # Step 5: Expand mask to expert level [num_tokens, 256]\\n    score_mask = (\\n        group_mask.unsqueeze(-1)\\n        .expand(num_tokens, n_group, experts_per_group)\\n        .reshape(num_tokens, num_experts)\\n    )\\n    \\n    # Step 6: Mask out experts from non-selected groups\\n    neg_inf = torch.finfo(torch.float32).min\\n    masked_scores = scores_for_routing.masked_fill(score_mask == 0, neg_inf)\\n    \\n    # Step 7: Select top-8 experts from masked scores\\n    _, topk_idx = torch.topk(masked_scores, k=top_k, dim=-1, sorted=False)\\n    \\n    # Gather selected expert scores (use original scores without bias)\\n    selected_scores = torch.gather(scores, dim=1, index=topk_idx)\\n    \\n    # Normalize routing weights\\n    topk_weight = selected_scores / (selected_scores.sum(dim=-1, keepdim=True) + 1e-20)\\n    \\n    # Apply routing scaling factor\\n    topk_weight = topk_weight * routed_scaling_factor\\n    \\n    return topk_idx, topk_weight\\n\"\n}\n","numLines":92,"startLine":1,"totalLines":92}}}
