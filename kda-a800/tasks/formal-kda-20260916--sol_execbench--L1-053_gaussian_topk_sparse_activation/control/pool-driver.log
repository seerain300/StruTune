{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YFjNkBJCruHGod8GepBMAA","type":"tool_result","content":"1\t{\n2\t    \"name\": \"053_gaussian_topk_sparse_activation\",\n3\t    \"hf_id\": \"google/gemma-3n-E2B\",\n4\t    \"description\": \"Gaussian-based top-k sparse activation mechanism. Computes adaptive sparsity by calculating a threshold based on input's mean and standard deviation, scaled by the inverse CDF of a normal distribution at the target sparsity level. Applies ReLU with this dynamic cutoff to create learned sparse activations.\",\n5\t    \"axes\": {\n6\t        \"batch_size\": {\n7\t            \"type\": \"var\",\n8\t            \"description\": \"Batch size\"\n9\t        },\n10\t        \"seq_len\": {\n11\t            \"type\": \"var\",\n12\t            \"description\": \"Sequence length\"\n13\t        },\n14\t        \"intermediate_size\": {\n15\t            \"type\": \"var\",\n16\t            \"description\": \"Intermediate/hidden dimension for the activation\"\n17\t        }\n18\t    },\n19\t    \"custom_inputs_entrypoint\": null,\n20\t    \"inputs\": {\n21\t        \"inputs\": {\n22\t            \"shape\": [\n23\t                \"batch_size\",\n24\t                \"seq_len\",\n25\t                \"intermediate_size\"\n26\t            ],\n27\t            \"dtype\": \"bfloat16\",\n28\t            \"description\": \"Input tensor, typically output of gate_proj in MLP\"\n29\t        },\n30\t        \"target_sparsity\": {\n31\t            \"shape\": null,\n32\t            \"dtype\": \"float32\",\n33\t            \"description\": \"Target sparsity level in [0, 1]. 0.0 means no sparsity, higher values mean more aggressive sparsity.\"\n34\t        }\n35\t    },\n36\t    \"outputs\": {\n37\t        \"output\": {\n38\t            \"shape\": [\n39\t                \"batch_size\",\n40\t                \"seq_len\",\n41\t                \"intermediate_size\"\n42\t            ],\n43\t            \"dtype\": \"bfloat16\",\n44\t            \"description\": \"Sparsified tensor with values below adaptive threshold set to zero\"\n45\t        }\n46\t    },\n47\t    \"reference\": \"import torch\\nimport torch.nn.functional as F\\nimport math\\n\\n\\ndef _ndtri(p: torch.Tensor) -> torch.Tensor:\\n    \\\"\\\"\\\"Inverse of the standard normal CDF (quantile function).\\n    \\n    Uses Abramowitz and Stegun approximation (formula 26.2.23).\\n    This is a rational approximation that works well for p in (0, 1).\\n    \\\"\\\"\\\"\\n    # Constants for the approximation\\n    a1 = -3.969683028665376e+01\\n    a2 = 2.209460984245205e+02\\n    a3 = -2.759285104469687e+02\\n    a4 = 1.383577518672690e+02\\n    a5 = -3.066479806614716e+01\\n    a6 = 2.506628277459239e+00\\n    \\n    b1 = -5.447609879822406e+01\\n    b2 = 1.615858368580409e+02\\n    b3 = -1.556989798598866e+02\\n    b4 = 6.680131188771972e+01\\n    b5 = -1.328068155288572e+01\\n    \\n    c1 = -7.784894002430293e-03\\n    c2 = -3.223964580411365e-01\\n    c3 = -2.400758277161838e+00\\n    c4 = -2.549732539343734e+00\\n    c5 = 4.374664141464968e+00\\n    c6 = 2.938163982698783e+00\\n    \\n    d1 = 7.784695709041462e-03\\n    d2 = 3.224671290700398e-01\\n    d3 = 2.445134137142996e+00\\n    d4 = 3.754408661907416e+00\\n    \\n    p_low = 0.02425\\n    p_high = 1.0 - p_low\\n    \\n    result = torch.zeros_like(p)\\n    \\n    # Lower region\\n    mask_low = p < p_low\\n    if mask_low.any():\\n        q = torch.sqrt(-2.0 * torch.log(p[mask_low]))\\n        result[mask_low] = (((((c1*q + c2)*q + c3)*q + c4)*q + c5)*q + c6) / \\\\\\n                           ((((d1*q + d2)*q + d3)*q + d4)*q + 1.0)\\n    \\n    # Central region\\n    mask_mid = (p >= p_low) & (p <= p_high)\\n    if mask_mid.any():\\n        q = p[mask_mid] - 0.5\\n        r = q * q\\n        result[mask_mid] = (((((a1*r + a2)*r + a3)*r + a4)*r + a5)*r + a6)*q / \\\\\\n                           (((((b1*r + b2)*r + b3)*r + b4)*r + b5)*r + 1.0)\\n    \\n    # Upper region\\n    mask_high = p > p_high\\n    if mask_high.any():\\n        q = torch.sqrt(-2.0 * torch.log(1.0 - p[mask_high]))\\n        result[mask_high] = -(((((c1*q + c2)*q + c3)*q + c4)*q + c5)*q + c6) / \\\\\\n                            ((((d1*q + d2)*q + d3)*q + d4)*q + 1.0)\\n    \\n    return result\\n\\n\\n@torch.no_grad()\\ndef run(inputs: torch.Tensor, target_sparsity: float) -> torch.Tensor:\\n    \\\"\\\"\\\"\\n    Gaussian-based top-k sparse activation.\\n    \\n    Computes adaptive sparsity threshold based on input statistics:\\n    1. Compute mean and std of input across feature dimension\\n    2. Calculate threshold = mean + std * norm.icdf(target_sparsity)\\n    3. Apply ReLU(input - threshold) to create sparse activations\\n    \\n    Args:\\n        inputs: Input tensor of shape [batch_size, seq_len, intermediate_size]\\n        target_sparsity: Float in [0, 1] indicating target sparsity level.\\n                        0.0 means no sparsity (all activations pass through).\\n    \\n    Returns:\\n        Sparsified tensor of same shape as input.\\n    \\\"\\\"\\\"\\n    # Early return if no sparsity requested\\n    if target_sparsity == 0.0:\\n        return inputs\\n    \\n    # Convert to float32 for numerical stability in statistics computation\\n    inputs_f32 = inputs.to(torch.float32)\\n    \\n    # Compute statistics along the feature dimension (last dim)\\n    # Shape: [batch_size, seq_len, 1]\\n    inputs_mean = torch.mean(inputs_f32, dim=-1, keepdim=True)\\n    inputs_std = torch.std(inputs_f32, dim=-1, keepdim=True, unbiased=False)\\n    \\n    # Compute the standard deviation multiplier using inverse CDF\\n    # This maps the target sparsity to a z-score in the normal distribution\\n    target_sparsity_tensor = torch.tensor(target_sparsity, dtype=torch.float32, device=inputs.device)\\n    std_multiplier = _ndtri(target_sparsity_tensor)\\n    \\n    # Compute the adaptive cutoff threshold\\n    # Values below this threshold will be zeroed out\\n    # Shape: [batch_size, seq_len, 1]\\n    cutoff_threshold = inputs_mean + inputs_std * std_multiplier\\n    \\n    # Apply ReLU with the adaptive threshold\\n    # This is equivalent to: max(0, inputs - cutoff_threshold)\\n    sparse_output = F.relu(inputs_f32 - cutoff_threshold)\\n    \\n    return sparse_output.to(torch.bfloat16)\\n\"\n48\t}\n49\t"}]},"parent_tool_use_id":null,"session_id":"ee2f23f6-f29f-4aaf-be0f-7ac7867a0bbc","uuid":"5e19759f-ce44-4040-9acf-0771300ea0d6","timestamp":"2026-09-16T17:11:28.346Z","tool_use_result":{"type":"text","file":{"filePath":"/data1/workspace/weihongren/kda-runs/formal-kda-20260916--sol_execbench--L1-053_gaussian_topk_sparse_activation/task/definition.json","content":"{\n    \"name\": \"053_gaussian_topk_sparse_activation\",\n    \"hf_id\": \"google/gemma-3n-E2B\",\n    \"description\": \"Gaussian-based top-k sparse activation mechanism. Computes adaptive sparsity by calculating a threshold based on input's mean and standard deviation, scaled by the inverse CDF of a normal distribution at the target sparsity level. Applies ReLU with this dynamic cutoff to create learned sparse activations.\",\n    \"axes\": {\n        \"batch_size\": {\n            \"type\": \"var\",\n            \"description\": \"Batch size\"\n        },\n        \"seq_len\": {\n            \"type\": \"var\",\n            \"description\": \"Sequence length\"\n        },\n        \"intermediate_size\": {\n            \"type\": \"var\",\n            \"description\": \"Intermediate/hidden dimension for the activation\"\n        }\n    },\n    \"custom_inputs_entrypoint\": null,\n    \"inputs\": {\n        \"inputs\": {\n            \"shape\": [\n                \"batch_size\",\n                \"seq_len\",\n                \"intermediate_size\"\n            ],\n            \"dtype\": \"bfloat16\",\n            \"description\": \"Input tensor, typically output of gate_proj in MLP\"\n        },\n        \"target_sparsity\": {\n            \"shape\": null,\n            \"dtype\": \"float32\",\n            \"description\": \"Target sparsity level in [0, 1]. 0.0 means no sparsity, higher values mean more aggressive sparsity.\"\n        }\n    },\n    \"outputs\": {\n        \"output\": {\n            \"shape\": [\n                \"batch_size\",\n                \"seq_len\",\n                \"intermediate_size\"\n            ],\n            \"dtype\": \"bfloat16\",\n            \"description\": \"Sparsified tensor with values below adaptive threshold set to zero\"\n        }\n    },\n    \"reference\": \"import torch\\nimport torch.nn.functional as F\\nimport math\\n\\n\\ndef _ndtri(p: torch.Tensor) -> torch.Tensor:\\n    \\\"\\\"\\\"Inverse of the standard normal CDF (quantile function).\\n    \\n    Uses Abramowitz and Stegun approximation (formula 26.2.23).\\n    This is a rational approximation that works well for p in (0, 1).\\n    \\\"\\\"\\\"\\n    # Constants for the approximation\\n    a1 = -3.969683028665376e+01\\n    a2 = 2.209460984245205e+02\\n    a3 = -2.759285104469687e+02\\n    a4 = 1.383577518672690e+02\\n    a5 = -3.066479806614716e+01\\n    a6 = 2.506628277459239e+00\\n    \\n    b1 = -5.447609879822406e+01\\n    b2 = 1.615858368580409e+02\\n    b3 = -1.556989798598866e+02\\n    b4 = 6.680131188771972e+01\\n    b5 = -1.328068155288572e+01\\n    \\n    c1 = -7.784894002430293e-03\\n    c2 = -3.223964580411365e-01\\n    c3 = -2.400758277161838e+00\\n    c4 = -2.549732539343734e+00\\n    c5 = 4.374664141464968e+00\\n    c6 = 2.938163982698783e+00\\n    \\n    d1 = 7.784695709041462e-03\\n    d2 = 3.224671290700398e-01\\n    d3 = 2.445134137142996e+00\\n    d4 = 3.754408661907416e+00\\n    \\n    p_low = 0.02425\\n    p_high = 1.0 - p_low\\n    \\n    result = torch.zeros_like(p)\\n    \\n    # Lower region\\n    mask_low = p < p_low\\n    if mask_low.any():\\n        q = torch.sqrt(-2.0 * torch.log(p[mask_low]))\\n        result[mask_low] = (((((c1*q + c2)*q + c3)*q + c4)*q + c5)*q + c6) / \\\\\\n                           ((((d1*q + d2)*q + d3)*q + d4)*q + 1.0)\\n    \\n    # Central region\\n    mask_mid = (p >= p_low) & (p <= p_high)\\n    if mask_mid.any():\\n        q = p[mask_mid] - 0.5\\n        r = q * q\\n        result[mask_mid] = (((((a1*r + a2)*r + a3)*r + a4)*r + a5)*r + a6)*q / \\\\\\n                           (((((b1*r + b2)*r + b3)*r + b4)*r + b5)*r + 1.0)\\n    \\n    # Upper region\\n    mask_high = p > p_high\\n    if mask_high.any():\\n        q = torch.sqrt(-2.0 * torch.log(1.0 - p[mask_high]))\\n        result[mask_high] = -(((((c1*q + c2)*q + c3)*q + c4)*q + c5)*q + c6) / \\\\\\n                            ((((d1*q + d2)*q + d3)*q + d4)*q + 1.0)\\n    \\n    return result\\n\\n\\n@torch.no_grad()\\ndef run(inputs: torch.Tensor, target_sparsity: float) -> torch.Tensor:\\n    \\\"\\\"\\\"\\n    Gaussian-based top-k sparse activation.\\n    \\n    Computes adaptive sparsity threshold based on input statistics:\\n    1. Compute mean and std of input across feature dimension\\n    2. Calculate threshold = mean + std * norm.icdf(target_sparsity)\\n    3. Apply ReLU(input - threshold) to create sparse activations\\n    \\n    Args:\\n        inputs: Input tensor of shape [batch_size, seq_len, intermediate_size]\\n        target_sparsity: Float in [0, 1] indicating target sparsity level.\\n                        0.0 means no sparsity (all activations pass through).\\n    \\n    Returns:\\n        Sparsified tensor of same shape as input.\\n    \\\"\\\"\\\"\\n    # Early return if no sparsity requested\\n    if target_sparsity == 0.0:\\n        return inputs\\n    \\n    # Convert to float32 for numerical stability in statistics computation\\n    inputs_f32 = inputs.to(torch.float32)\\n    \\n    # Compute statistics along the feature dimension (last dim)\\n    # Shape: [batch_size, seq_len, 1]\\n    inputs_mean = torch.mean(inputs_f32, dim=-1, keepdim=True)\\n    inputs_std = torch.std(inputs_f32, dim=-1, keepdim=True, unbiased=False)\\n    \\n    # Compute the standard deviation multiplier using inverse CDF\\n    # This maps the target sparsity to a z-score in the normal distribution\\n    target_sparsity_tensor = torch.tensor(target_sparsity, dtype=torch.float32, device=inputs.device)\\n    std_multiplier = _ndtri(target_sparsity_tensor)\\n    \\n    # Compute the adaptive cutoff threshold\\n    # Values below this threshold will be zeroed out\\n    # Shape: [batch_size, seq_len, 1]\\n    cutoff_threshold = inputs_mean + inputs_std * std_multiplier\\n    \\n    # Apply ReLU with the adaptive threshold\\n    # This is equivalent to: max(0, inputs - cutoff_threshold)\\n    sparse_output = F.relu(inputs_f32 - cutoff_threshold)\\n    \\n    return sparse_output.to(torch.bfloat16)\\n\"\n}\n","numLines":49,"startLine":1,"totalLines":49}}}
