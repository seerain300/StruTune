\n111\t        },\n112\t        \"short_conv_bias\": {\n113\t            \"shape\": [\n114\t                \"inner_width\"\n115\t            ],\n116\t            \"dtype\": \"float32\",\n117\t            \"description\": \"Short conv bias\"\n118\t        },\n119\t        \"filter_linear1_weight\": {\n120\t            \"shape\": [\n121\t                \"filter_order\",\n122\t                \"emb_dim\"\n123\t            ],\n124\t            \"dtype\": \"float32\",\n125\t            \"description\": \"Filter MLP layer 1 weight\"\n126\t        },\n127\t        \"filter_linear1_bias\": {\n128\t            \"shape\": [\n129\t                \"filter_order\"\n130\t            ],\n131\t            \"dtype\": \"float32\",\n132\t            \"description\": \"Filter MLP layer 1 bias\"\n133\t        },\n134\t        \"sin_freq\": {\n135\t            \"shape\": [\n136\t                \"1\",\n137\t                \"filter_order\"\n138\t            ],\n139\t            \"dtype\": \"float32\",\n140\t            \"description\": \"Sinusoidal activation frequency\"\n141\t        },\n142\t        \"filter_linear2_weight\": {\n143\t            \"shape\": [\n144\t                \"filter_order\",\n145\t                \"filter_order\"\n146\t            ],\n147\t            \"dtype\": \"float32\",\n148\t            \"description\": \"Filter MLP layer 2 weight\"\n149\t        },\n150\t        \"filter_linear2_bias\": {\n151\t            \"shape\": [\n152\t                \"filter_order\"\n153\t            ],\n154\t            \"dtype\": \"float32\",\n155\t            \"description\": \"Filter MLP layer 2 bias\"\n156\t        },\n157\t        \"filter_linear3_weight\": {\n158\t            \"shape\": [\n159\t                \"filter_order\",\n160\t                \"filter_order\"\n161\t            ],\n162\t            \"dtype\": \"float32\",\n163\t            \"description\": \"Filter MLP layer 3 weight\"\n164\t        },\n165\t        \"filter_linear3_bias\": {\n166\t            \"shape\": [\n167\t                \"filter_order\"\n168\t            ],\n169\t            \"dtype\": \"float32\",\n170\t            \"description\": \"Filter MLP layer 3 bias\"\n171\t        },\n172\t        \"filter_linear_final_weight\": {\n173\t            \"shape\": [\n174\t                \"d_model\",\n175\t                \"filter_order\"\n176\t            ],\n177\t            \"dtype\": \"float32\",\n178\t            \"description\": \"Filter final projection weight\"\n179\t        },\n180\t        \"filter_bias\": {\n181\t            \"shape\": [\n182\t                \"d_model\"\n183\t            ],\n184\t            \"dtype\": \"float32\",\n185\t            \"description\": \"Filter bias for FFT convolution\"\n186\t        },\n187\t        \"exp_mod_deltas\": {\n188\t            \"shape\": [\n189\t                \"1\",\n190\t                \"1\",\n191\t                \"d_model\"\n192\t            ],\n193\t            \"dtype\": \"float32\",\n194\t            \"description\": \"Exponential modulation deltas\"\n195\t        },\n196\t        \"out_proj_weight\": {\n197\t            \"shape\": [\n198\t                \"d_model\",\n199\t                \"d_model\"\n200\t            ],\n201\t            \"dtype\": \"float32\",\n202\t            \"description\": \"Output projection weight\"\n203\t        },\n204\t        \"out_proj_bias\": {\n205\t            \"shape\": [\n206\t                \"d_model\"\n207\t            ],\n208\t            \"dtype\": \"float32\",\n209\t            \"description\": \"Output projection bias\"\n210\t        },\n211\t        \"mlp_fc1_weight\": {\n212\t            \"shape\": [\n213\t                \"d_inner\",\n214\t                \"d_model\"\n215\t            ],\n216\t            \"dtype\": \"float32\",\n217\t            \"description\": \"MLP fc1 weight\"\n218\t        },\n219\t        \"mlp_fc1_bias\": {\n220\t            \"shape\": [\n221\t                \"d_inner\"\n222\t            ],\n223\t            \"dtype\": \"float32\",\n224\t            \"description\": \"MLP fc1 bias\"\n225\t        },\n226\t        \"mlp_fc2_weight\": {\n227\t            \"shape\": [\n228\t                \"d_model\",\n229\t                \"d_inner\"\n230\t            ],\n231\t            \"dtype\": \"float32\",\n232\t            \"description\": \"MLP fc2 weight\"\n233\t        },\n234\t        \"mlp_fc2_bias\": {\n235\t            \"shape\": [\n236\t                \"d_model\"\n237\t            ],\n238\t            \"dtype\": \"float32\",\n239\t            \"description\": \"MLP fc2 bias\"\n240\t        },\n241\t        \"layer_norm_eps\": {\n242\t            \"shape\": null,\n243\t            \"dtype\": \"float32\",\n244\t            \"description\": \"LayerNorm epsilon\"\n245\t        },\n246\t        \"exp_mod_shift\": {\n247\t            \"shape\": null,\n248\t            \"dtype\": \"float32\",\n249\t            \"description\": \"Exponential modulation shift\"\n250\t        }\n251\t    },\n252\t    \"outputs\": {\n253\t        \"output\": {\n254\t            \"shape\": [\n255\t                \"batch_size\",\n256\t                \"seq_len\",\n257\t                \"d_model\"\n258\t            ],\n259\t            \"dtype\": \"float32\",\n260\t            \"description\": \"Output hidden states\"\n261\t        }\n262\t    },\n263\t    \"reference\": \"import torch\\nimport torch.nn.functional as F\\nimport math\\n\\n\\ndef get_inputs(axes_and_scalars: dict, device: torch.device) -> dict:\\n    batch_size = axes_and_scalars[\\\"batch_size\\\"]\\n    seq_len = axes_and_scalars[\\\"seq_len\\\"]\\n    d_model = 256\\n    d_inner = 1024\\n    order = 2\\n    l_max = 32768\\n    short_filter_order = 3\\n    filter_order = 64\\n    emb_dim = 5\\n    inner_width = d_model * (order + 1)\\n    \\n    hidden_states = torch.randn(batch_size, seq_len, d_model, dtype=torch.float32, device=device)\\n    norm1_weight = torch.ones(d_model, dtype=torch.float32, device=device)\\n    norm1_bias = torch.zeros(d_model, dtype=torch.float32, device=device)\\n    norm2_weight = torch.ones(d_model, dtype=torch.float32, device=device)\\n    norm2_bias = torch.zeros(d_model, dtype=torch.float32, device=device)\\n    in_proj_weight = torch.randn(inner_width, d_model, dtype=torch.float32, device=device) * 0.02\\n    in_proj_bias = torch.randn(inner_width, dtype=torch.float32, device=device) * 0.02\\n    short_conv_weight = torch.randn(inner_width, 1, short_filter_order, dtype=torch.float32, device=device) * 0.02\\n    short_conv_bias = torch.randn(inner_width, dtype=torch.float32, device=device) * 0.02\\n    filter_linear1_weight = torch.randn(filter_order, emb_dim, dtype=torch.float32, device=device) * 0.02\\n    filter_linear1_bias = torch.randn(filter_order, dtype=torch.float32, device=device) * 0.02\\n    sin_freq = torch.ones(1, filter_order, dtype=torch.float32, device=device)\\n    filter_linear2_weight = torch.randn(filter_order, filter_order, dtype=torch.float32, device=device) * 0.02\\n    filter_linear2_bias = torch.randn(filter_order, dtype=torch.float32, device=device) * 0.02\\n    filter_linear3_weight = torch.randn(filter_order, filter_order, dtype=torch.float32, device=device) * 0.02\\n    filter_linear3_bias = torch.randn(filter_order, dtype=torch.float32, device=device) * 0.02\\n    filter_linear_final_weight = torch.randn(d_model, filter_order, dtype=torch.float32, device=device) * 0.02\\n    filter_bias = torch.randn(d_model, dtype=torch.float32, device=device) * 0.02\\n    max_decay = math.log(0.01) / 0.3\\n    min_decay = math.log(0.01) / 1.5\\n    deltas = torch.linspace(min_decay, max_decay, d_model, device=device)[None, None, :]\\n    exp_mod_deltas = deltas.to(torch.float32)\\n    out_proj_weight = torch.randn(d_model, d_model, dtype=torch.float32, device=device) * 0.02\\n    out_proj_bias = torch.randn(d_model, dtype=torch.float32, device=device) * 0.02\\n    mlp_fc1_weight = torch.randn(d_inner, d_model, dtype=torch.float32, device=device) * 0.02\\n    mlp_fc1_bias = torch.randn(d_inner, dtype=torch.float32, device=device) * 0.02\\n    mlp_fc2_weight = torch.randn(d_model, d_inner, dtype=torch.float32, device=device) * 0.02\\n    mlp_fc2_bias = torch.randn(d_model, dtype=torch.float32, device=device) * 0.02\\n    \\n    return {\\n        \\\"hidden_states\\\": hidden_states,\\n        \\\"norm1_weight\\\": norm1_weight,\\n        \\\"norm1_bias\\\": norm1_bias,\\n        \\\"norm2_weight\\\": norm2_weight,\\n        \\\"norm2_bias\\\": norm2_bias,\\n        \\\"in_proj_weight\\\": in_proj_weight,\\n        \\\"in_proj_bias\\\": in_proj_bias,\\n        \\\"short_conv_weight\\\": short_conv_weight,\\n        \\\"short_conv_bias\\\": short_conv_bias,\\n        \\\"filter_linear1_weight\\\": filter_linear1_weight,\\n        \\\"filter_linear1_bias\\\": filter_linear1_bias,\\n        \\\"sin_freq\\\": sin_freq,\\n        \\\"filter_linear2_weight\\\": filter_linear2_weight,\\n        \\\"filter_linear2_bias\\\": filter_linear2_bias,\\n        \\\"filter_linear3_weight\\\": filter_linear3_weight,\\n        \\\"filter_linear3_bias\\\": filter_linear3_bias,\\n        \\\"filter_linear_final_weight\\\": filter_linear_final_weight,\\n        \\\"filter_bias\\\": filter_bias,\\n        \\\"exp_mod_deltas\\\": exp_mod_deltas,\\n        \\\"out_proj_weight\\\": out_proj_weight,\\n        \\\"out_proj_bias\\\": out_proj_bias,\\n        \\\"mlp_fc1_weight\\\": mlp_fc1_weight,\\n        \\\"mlp_fc1_bias\\\": mlp_fc1_bias,\\n        \\\"mlp_fc2_weight\\\": mlp_fc2_weight,\\n        \\\"mlp_fc2_bias\\\": mlp_fc2_bias,\\n        \\\"layer_norm_eps\\\": 1e-5,\\n        \\\"exp_mod_shift\\\": 0.05\\n    }\\n\\n\\n@torch.no_grad()\\ndef run(\\n    hidden_states: torch.Tensor,\\n    norm1_weight: torch.Tensor,\\n    norm1_bias: torch.Tensor,\\n    norm2_weight: torch.Tensor,\\n    norm2_bias: torch.Tensor,\\n    in_proj_weight: torch.Tensor,\\n    in_proj_bias: torch.Tensor,\\n    short_conv_weight: torch.Tensor,\\n    short_conv_bias: torch.Tensor,\\n    filter_linear1_weight: torch.Tensor,\\n    filter_linear1_bias: torch.Tensor,\\n    sin_freq: torch.Tensor,\\n    filter_linear2_weight: torch.Tensor,\\n    filter_linear2_bias: torch.Tensor,\\n    filter_linear3_weight: torch.Tensor,\\n    filter_linear3_bias: torch.Tensor,\\n    filter_linear_final_weight: torch.Tensor,\\n    filter_bias: torch.Tensor,\\n    exp_mod_deltas: torch.Tensor,\\n    out_proj_weight: torch.Tensor,\\n    out_proj_bias: torch.Tensor,\\n    mlp_fc1_weight: torch.Tensor,\\n    mlp_fc1_bias: torch.Tensor,\\n    mlp_fc2_weight: torch.Tensor,\\n    mlp_fc2_bias: torch.Tensor,\\n    layer_norm_eps: float,\\n    exp_mod_shift: float,\\n):\\n    d_model = 256\\n    order = 2\\n    l_max = 32768\\n    inner_width = d_model * (order + 1)\\n    \\n    batch_size, seq_len, _ = hidden_states.shape\\n    l_filter = min(seq_len, l_max)\\n    device = hidden_states.device\\n    \\n    # First Residual + LayerNorm\\n    residual = hidden_states.to(torch.float32)\\n    mean = residual.mean(dim=-1, keepdim=True)\\n    var = residual.var(dim=-1, keepdim=True, unbiased=False)\\n    normed = (residual - mean) / torch.sqrt(var + layer_norm_eps)\\n    normed = normed * norm1_weight + norm1_bias\\n    \\n    # Hyena Operator - Input projection\\n    u = F.linear(normed, in_proj_weight, in_proj_bias)\\n    u = u.transpose(1, 2)\\n    \\n    # Short depthwise convolution\\n    u_padded = F.pad(u, (2, 2))\\n    uc = F.conv1d(u_padded, short_conv_weight, short_conv_bias, groups=inner_width)\\n    uc = uc[..., :l_filter]\\n    \\n    # Split into x and v\\n    splits = uc.split(d_model, dim=1)\\n    x = splits[:-1]\\n    v = splits[-1]\\n    \\n    # Implicit Filter Generation - Positional embeddings\\n    t = torch.linspace(0, 1, l_filter, device=device)[None, :, None]\\n    bands = 2\\n    t_rescaled = torch.linspace(0, l_filter - 1, l_filter, device=device)[None, :, None]\\n    w = 2 * math.pi * t_rescaled / l_filter\\n    f = torch.linspace(1e-4, bands - 1, bands, device=device)[None, None]\\n    z = torch.cat([t, torch.cos(-f * w), torch.sin(-f * w)], dim=-1)\\n    \\n    # Filter MLP\\n    h = F.linear(z, filter_linear1_weight, filter_linear1_bias)\\n    h = torch.sin(sin_freq * h)\\n    h = F.linear(h, filter_linear2_weight, filter_linear2_bias)\\n    h = torch.sin(sin_freq * h)\\n    h = F.linear(h, filter_linear3_weight, filter_linear3_bias)\\n    h = torch.sin(sin_freq * h)\\n    h = F.linear(h, filter_linear_final_weight, None)\\n    \\n    # Exponential modulation\\n    decay = torch.exp(-t * exp_mod_deltas.abs())\\n    h = h * (decay + exp_mod_shift)\\n    \\n    # Add bias and reshape for FFT convolution\\n    h = h + filter_bias.view(1, 1, d_model)\\n    k = h.transpose(0, 1).reshape(1, d_model, l_filter)\\n    bias_reshaped = filter_bias.reshape(1, d_model)\\n    \\n    # Gating and FFT Convolution (order=2, one iteration)\\n    for o, x_i in enumerate(reversed(x[1:])):\\n        v = v * x_i\\n        fft_size = 2 * l_filter\\n        k_f = torch.fft.rfft(k[o].to(torch.float32), n=fft_size) / fft_size\\n        v_f = torch.fft.rfft(v.to(torch.float32), n=fft_size)\\n        y = torch.fft.irfft(v_f * k_f, n=fft_size, norm='forward')[..., :l_filter]\\n        v = y + v * bias_reshaped[o].unsqueeze(-1)\\n    \\n    # Final gating with x[0]\\n    y = (v * x[0]).transpose(1, 2)\\n    \\n    # Pad back to original seq_len if needed\\n    if l_filter < seq_len:\\n        y = F.pad(y, (0, 0, 0, seq_len - l_filter))\\n    \\n    # Output projection\\n    hyena_out = F.linear(y, out_proj_weight, out_proj_bias)\\n    \\n    # First Residual Addition\\n    residual = hyena_out + residual\\n    \\n    # Second LayerNorm\\n    residual_float = residual.to(torch.float32)\\n    mean = residual_float.mean(dim=-1, keepdim=True)\\n    var = residual_float.var(dim=-1, keepdim=True, unbiased=False)\\n    normed = (residual_float - mean) / torch.sqrt(var + layer_norm_eps)\\n    normed = normed * norm2_weight + norm2_bias\\n    \\n    # MLP\\n    mlp_out = F.linear(normed, mlp_fc1_weight, mlp_fc1_bias)\\n    mlp_out = F.gelu(mlp_out, approximate=\\\"tanh\\\")\\n    mlp_out = F.linear(mlp_out, mlp_fc2_weight, mlp_fc2_bias)\\n    \\n    # Final Residual Addition\\n    output = mlp_out + residual_float\\n    \\n    return output\\n\"\n264\t}\n265\t"}]},"parent_tool_use_id":null,"session_id":"a81266f5-d225-45ef-aa50-166cef24183e","uuid":"b919f728-c61a-4fd4-9be7-b14abdbcd97f","timestamp":"2026-09-17T11:57:58.855Z","tool_use_result":{"type":"text","file":{"filePath":"/data1/workspace/weihongren/kda-runs/formal-kda-20260916--sol_execbench--L2-051_seqlen-finetuned-reconstructed_hyena_complete_forward_block/task/definition.json","content":"{\n    \"name\": \"051_seqlen-finetuned-reconstructed_hyena_complete_forward_block\",\n    \"hf_id\": \"magicslabnu/Hyena-small-32k\",\n    \"description\": \"Complete end-to-end HyenaBlock forward pass that fuses all operations from input to output: residual management, layer normalizations with dtype conversions, the full Hyena operator (input projection, short conv, filter generation, FFT convolution, gating), MLP with GELU activation, and final residual addition.\",\n    \"axes\": {\n        \"batch_size\": {\n            \"type\": \"var\"\n        },\n        \"seq_len\": {\n            \"type\": \"var\"\n        },\n        \"d_model\": {\n            \"type\": \"const\",\n            \"value\": 256\n        },\n        \"d_inner\": {\n            \"type\": \"const\",\n            \"value\": 1024\n        },\n        \"order\": {\n            \"type\": \"const\",\n            \"value\": 2\n        },\n        \"l_max\": {\n            \"type\": \"const\",\n            \"value\": 32768\n        },\n        \"short_filter_order\": {\n            \"type\": \"const\",\n            \"value\": 3\n        },\n        \"filter_order\": {\n            \"type\": \"const\",\n            \"value\": 64\n        },\n        \"emb_dim\": {\n            \"type\": \"const\",\n            \"value\": 5\n        },\n        \"inner_width\": {\n            \"type\": \"expr\",\n            \"expression\": \"d_model * (order + 1)\"\n        },\n        \"order_minus_1\": {\n            \"type\": \"expr\",\n            \"expression\": \"order - 1\"\n        }\n    },\n    \"custom_inputs_entrypoint\": \"get_inputs\",\n    \"inputs\": {\n        \"hidden_states\": {\n            \"shape\": [\n                \"batch_size\",\n                \"seq_len\",\n                \"d_model\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Input hidden states\"\n        },\n        \"norm1_weight\": {\n            \"shape\": [\n                \"d_model\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"LayerNorm 1 weight\"\n        },\n        \"norm1_bias\": {\n            \"shape\": [\n                \"d_model\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"LayerNorm 1 bias\"\n        },\n        \"norm2_weight\": {\n            \"shape\": [\n                \"d_model\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"LayerNorm 2 weight\"\n        },\n        \"norm2_bias\": {\n            \"shape\": [\n                \"d_model\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"LayerNorm 2 bias\"\n        },\n        \"in_proj_weight\": {\n            \"shape\": [\n                \"inner_width\",\n                \"d_model\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Input projection weight\"\n        },\n        \"in_proj_bias\": {\n            \"shape\": [\n                \"inner_width\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Input projection bias\"\n        },\n        \"short_conv_weight\": {\n            \"shape\": [\n                \"inner_width\",\n                \"1\",\n                \"short_filter_order\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Short conv weight\"\n        },\n        \"short_conv_bias\": {\n            \"shape\": [\n                \"inner_width\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Short conv bias\"\n        },\n        \"filter_linear1_weight\": {\n            \"shape\": [\n                \"filter_order\",\n                \"emb_dim\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Filter MLP layer 1 weight\"\n        },\n        \"filter_linear1_bias\": {\n            \"shape\": [\n                \"filter_order\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Filter MLP layer 1 bias\"\n        },\n        \"sin_freq\": {\n            \"shape\": [\n                \"1\",\n                \"filter_order\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Sinusoidal activation frequency\"\n        },\n        \"filter_linear2_weight\": {\n            \"shape\": [\n                \"filter_order\",\n                \"filter_order\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Filter MLP layer 2 weight\"\n        },\n        \"filter_linear2_bias\": {\n            \"shape\": [\n                \"filter_order\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Filter MLP layer 2 bias\"\n        },\n        \"filter_linear3_weight\": {\n            \"shape\": [\n                \"filter_order\",\n                \"filter_order\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Filter MLP layer 3 weight\"\n        },\n        \"filter_linear3_bias\": {\n            \"shape\": [\n                \"filter_order\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Filter MLP layer 3 bias\"\n        },\n        \"filter_linear_final_weight\": {\n            \"shape\": [\n                \"d_model\",\n                \"filter_order\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Filter final projection weight\"\n        },\n        \"filter_bias\": {\n            \"shape\": [\n                \"d_model\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Filter bias for FFT convolution\"\n        },\n        \"exp_mod_deltas\": {\n            \"shape\": [\n                \"1\",\n                \"1\",\n                \"d_model\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Exponential modulation deltas\"\n        },\n        \"out_proj_weight\": {\n            \"shape\": [\n                \"d_model\",\n                \"d_model\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Output projection weight\"\n        },\n        \"out_proj_bias\": {\n            \"shape\": [\n                \"d_model\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Output projection bias\"\n        },\n        \"mlp_fc1_weight\": {\n            \"shape\": [\n                \"d_inner\",\n                \"d_model\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"MLP fc1 weight\"\n        },\n        \"mlp_fc1_bias\": {\n            \"shape\": [\n                \"d_inner\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"MLP fc1 bias\"\n        },\n        \"mlp_fc2_weight\": {\n            \"shape\": [\n                \"d_model\",\n                \"d_inner\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"MLP fc2 weight\"\n        },\n        \"mlp_fc2_bias\": {\n            \"shape\": [\n                \"d_model\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"MLP fc2 bias\"\n        },\n        \"layer_norm_eps\": {\n            \"shape\": null,\n            \"dtype\": \"float32\",\n            \"description\": \"LayerNorm epsilon\"\n        },\n        \"exp_mod_shift\": {\n            \"shape\": null,\n            \"dtype\": \"float32\",\n            \"description\": \"Exponential modulation shift\"\n        }\n    },\n    \"outputs\": {\n        \"output\": {\n            \"shape\": [\n                \"batch_size\",\n                \"seq_len\",\n                \"d_model\"\n            ],\n            \"dtype\": \"float32\",\n            \"description\": \"Output hidden states\"\n        }\n    },\n    \"reference\": \"import torch\\nimport torch.nn.functional as F\\nimport math\\n\\n\\ndef get_inputs(axes_and_scalars: dict, device: torch.device) -> dict:\\n    batch_size = axes_and_scalars[\\\"batch_size\\\"]\\n    seq_len = axes_and_scalars[\\\"seq_len\\\"]\\n    d_model = 256\\n    d_inner = 1024\\n    order = 2\\n    l_max = 32768\\n    short_filter_order = 3\\n    filter_order = 64\\n    emb_dim = 5\\n    inner_width = d_model * (order + 1)\\n    \\n    hidden_states = torch.randn(batch_size, seq_len, d_model, dtype=torch.float32, device=device)\\n    norm1_weight = torch.ones(d_model, dtype=torch.float32, device=device)\\n    norm1_bias = torch.zeros(d_model, dtype=torch.float32, device=device)\\n    norm2_weight = torch.ones(d_model, dtype=torch.float32, device=device)\\n    norm2_bias = torch.zeros(d_model, dtype=torch.float32, device=device)\\n    in_proj_weight = torch.randn(inner_width, d_model, dtype=torch.float32, device=device) * 0.02\\n    in_proj_bias = torch.randn(inner_width, dtype=torch.float32, device=device) * 0.02\\n    short_conv_weight = torch.randn(inner_width, 1, short_filter_order, dtype=torch.float32, device=device) * 0.02\\n    short_conv_bias = torch.randn(inner_width, dtype=torch.float32, device=device) * 0.02\\n    filter_linear1_weight = torch.randn(filter_order, emb_dim, dtype=torch.float32, device=device) * 0.02\\n    filter_linear1_bias = torch.randn(filter_order, dtype=torch.float32, device=device) * 0.02\\n    sin_freq = torch.ones(1, filter_order, dtype=torch.float32, device=device)\\n    filter_linear2_weight = torch.randn(filter_order, filter_order, dtype=torch.float32, device=device) * 0.02\\n    filter_linear2_bias = torch.randn(filter_order, dtype=torch.float32, device=device) * 0.02\\n    filter_linear3_weight = torch.randn(filter_order, filter_order, dtype=torch.float32, device=device) * 0.02\\n    filter_linear3_bias = torch.randn(filter_order, dtype=torch.float32, device=device) * 0.02\\n    filter_linear_final_weight = torch.randn(d_model, filter_order, dtype=torch.float32, device=device) * 0.02\\n    filter_bias = torch.randn(d_model, dtype=torch.float32, device=device) * 0.02\\n    max_decay = math.log(0.01) / 0.3\\n    min_decay = math.log(0.01) / 1.5\\n    deltas = torch.linspace(min_decay, max_decay, d_model, device=device)[None, None, :]\\n    exp_mod_deltas = deltas.to(torch.float32)\\n    out_proj_weight = torch.randn(d_model, d_model, dtype=torch.float32, device=device) * 0.02\\n    out_proj_bias = torch.randn(d_model, dtype=torch.float32, device=device) * 0.02\\n    mlp_fc1_weight = torch.randn(d_inner, d_model, dtype=torch.float32, device=device) * 0.02\\n    mlp_fc1_bias = torch.randn(d_inner, dtype=torch.float32, device=device) * 0.02\\n    mlp_fc2_weight = torch.randn(d_model, d_inner, dtype=torch.float32, device=device) * 0.02\\n    mlp_fc2_bias = torch.randn(d_model, dtype=torch.float32, device=device) * 0.02\\n    \\n    return {\\n        \\\"hidden_states\\\": hidden_states,\\n        \\\"norm1_weight\\\": norm1_weight,\\n        \\\"norm1_bias\\\": norm1_bias,\\n        \\\"norm2_weight\\\": norm2_weight,\\n        \\\"norm2_bias\\\": norm2_bias,\\n        \\\"in_proj_weight\\\": in_proj_weight,\\n        \\\"in_proj_bias\\\": in_proj_bias,\\n        \\\"short_conv_weight\\\": short_conv_weight,\\n        \\\"short_conv_bias\\\": short_conv_bias,\\n        \\\"filter_linear1_weight\\\": filter_linear1_weight,\\n        \\\"filter_linear1_bias\\\": filter_linear1_bias,\\n        \\\"sin_freq\\\": sin_freq,\\n        \\\"filter_linear2_weight\\\": filter_linear2_weight,\\n        \\\"filter_linear2_bias\\\": filter_linear2_bias,\\n        \\\"filter_linear3_weight\\\": filter_linear3_weight,\\n        \\\"filter_linear3_bias\\\": filter_linear3_bias,\\n        \\\"filter_linear_final_weight\\\": filter_linear_final_weight,\\n        \\\"filter_bias\\\": filter_bias,\\n        \\\"exp_mod_deltas\\\": exp_mod_deltas,\\n        \\\"out_proj_weight\\\": out_proj_weight,\\n        \\\"out_proj_bias\\\": out_proj_bias,\\n        \\\"mlp_fc1_weight\\\": mlp_fc1_weight,\\n        \\\"mlp_fc1_bias\\\": mlp_fc1_bias,\\n        \\\"mlp_fc2_weight\\\": mlp_fc2_weight,\\n        \\\"mlp_fc2_bias\\\": mlp_fc2_bias,\\n        \\\"layer_norm_eps\\\": 1e-5,\\n        \\\"exp_mod_shift\\\": 0.05\\n    }\\n\\n\\n@torch.no_grad()\\ndef run(\\n    hidden_states: torch.Tensor,\\n    norm1_weight: torch.Tensor,\\n    norm1_bias: torch.Tensor,\\n    norm2_weight: torch.Tensor,\\n    norm2_bias: torch.Tensor,\\n    in_proj_weight: torch.Tensor,\\n    in_proj_bias: torch.Tensor,\\n    short_conv_weight: torch.Tensor,\\n    short_conv_bias: torch.Tensor,\\n    filter_linear1_weight: torch.Tensor,\\n    filter_linear1_bias: torch.Tensor,\\n    sin_freq: torch.Tensor,\\n    filter_linear2_weight: torch.Tensor,\\n    filter_linear2_bias: torch.Tensor,\\n    filter_linear3_weight: torch.Tensor,\\n    filter_linear3_bias: torch.Tensor,\\n    filter_linear_final_weight: torch.Tensor,\\n    filter_bias: torch.Tensor,\\n    exp_mod_deltas: torch.Tensor,\\n    out_proj_weight: torch.Tensor,\\n    out_proj_bias: torch.Tensor,\\n    mlp_fc1_weight: torch.Tensor,\\n    mlp_fc1_bias: torch.Tensor,\\n    mlp_fc2_weight: torch.Tensor,\\n    mlp_fc2_bias: torch.Tensor,\\n    layer_norm_eps: float,\\n    exp_mod_shift: float,\\n):\\n    d_model = 256\\n    order = 2\\n    l_max = 32768\\n    inner_width = d_model * (order + 1)\\n    \\n    batch_size, seq_len, _ = hidden_states.shape\\n    l_filter = min(seq_len, l_max)\\n    device = hidden_states.device\\n    \\n    # First Residual + LayerNorm\\n    residual = hidden_states.to(torch.float32)\\n    mean = residual.mean(dim=-1, keepdim=True)\\n    var = residual.var(dim=-1, keepdim=True, unbiased=False)\\n    normed = (residual - mean) / torch.sqrt(var + layer_norm_eps)\\n    normed = normed * norm1_weight + norm1_bias\\n    \\n    # Hyena Operator - Input projection\\n    u = F.linear(normed, in_proj_weight, in_proj_bias)\\n    u = u.transpose(1, 2)\\n    \\n    # Short depthwise convolution\\n    u_padded = F.pad(u, (2, 2))\\n    uc = F.conv1d(u_padded, short_conv_weight, short_conv_bias, groups=inner_width)\\n    uc = uc[..., :l_filter]\\n    \\n    # Split into x and v\\n    splits = uc.split(d_model, dim=1)\\n    x = splits[:-1]\\n    v = splits[-1]\\n    \\n    # Implicit Filter Generation - Positional embeddings\\n    t = torch.linspace(0, 1, l_filter, device=device)[None, :, None]\\n    bands = 2\\n    t_rescaled = torch.linspace(0, l_filter - 1, l_filter, device=device)[None, :, None]\\n    w = 2 * math.pi * t_rescaled / l_filter\\n    f = torch.linspace(1e-4, bands - 1, bands, device=device)[None, None]\\n    z = torch.cat([t, torch.cos(-f * w), torch.sin(-f * w)], dim=-1)\\n    \\n    # Filter MLP\\n    h = F.linear(z, filter_linear1_weight, filter_linear1_bias)\\n    h = torch.sin(sin_freq * h)\\n    h = F.linear(h, filter_linear2_weight, filter_linear2_bias)\\n    h = torch.sin(sin_freq * h)\\n    h = F.linear(h, filter_linear3_weight, filter_linear3_bias)\\n    h = torch.sin(sin_freq * h)\\n    h = F.linear(h, filter_linear_final_weight, None)\\n    \\n    # Exponential modulation\\n    decay = torch.exp(-t * exp_mod_deltas.abs())\\n    h = h * (decay + exp_mod_shift)\\n    \\n    # Add bias and reshape for FFT convolution\\n    h = h + filter_bias.view(1, 1, d_model)\\n    k = h.transpose(0, 1).reshape(1, d_model, l_filter)\\n    bias_reshaped = filter_bias.reshape(1, d_model)\\n    \\n    # Gating and FFT Convolution (order=2, one iteration)\\n    for o, x_i in enumerate(reversed(x[1:])):\\n        v = v * x_i\\n        fft_size = 2 * l_filter\\n        k_f = torch.fft.rfft(k[o].to(torch.float32), n=fft_size) / fft_size\\n        v_f = torch.fft.rfft(v.to(torch.float32), n=fft_size)\\n        y = torch.fft.irfft(v_f * k_f, n=fft_size, norm='forward')[..., :l_filter]\\n        v = y + v * bias_reshaped[o].unsqueeze(-1)\\n    \\n    # Final gating with x[0]\\n    y = (v * x[0]).transpose(1, 2)\\n    \\n    # Pad back to original seq_len if needed\\n    if l_filter < seq_len:\\n        y = F.pad(y, (0, 0, 0, seq_len - l_filter))\\n    \\n    # Output projection\\n    hyena_out = F.linear(y, out_proj_weight, out_proj_bias)\\n    \\n    # First Residual Addition\\n    residual = hyena_out + residual\\n    \\n    # Second LayerNorm\\n    residual_float = residual.to(torch.float32)\\n    mean = residual_float.mean(dim=-1, keepdim=True)\\n    var = residual_float.var(dim=-1, keepdim=True, unbiased=False)\\n    normed = (residual_float - mean) / torch.sqrt(var + layer_norm_eps)\\n    normed = normed * norm2_weight + norm2_bias\\n    \\n    # MLP\\n    mlp_out = F.linear(normed, mlp_fc1_weight, mlp_fc1_bias)\\n    mlp_out = F.gelu(mlp_out, approximate=\\\"tanh\\\")\\n    mlp_out = F.linear(mlp_out, mlp_fc2_weight, mlp_fc2_bias)\\n    \\n    # Final Residual Addition\\n    output = mlp_out + residual_float\\n    \\n    return output\\n\"\n}\n","numLines":265,"startLine":1,"totalLines":265}}}
