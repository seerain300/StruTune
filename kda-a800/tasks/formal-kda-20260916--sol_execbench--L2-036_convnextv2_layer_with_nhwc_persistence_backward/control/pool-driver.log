\"B\",\n114\t                \"H\",\n115\t                \"W\",\n116\t                \"C4\"\n117\t            ],\n118\t            \"dtype\": \"float32\",\n119\t            \"description\": \"Output of pwconv1 linear expansion\"\n120\t        },\n121\t        \"x_gelu\": {\n122\t            \"shape\": [\n123\t                \"B\",\n124\t                \"H\",\n125\t                \"W\",\n126\t                \"C4\"\n127\t            ],\n128\t            \"dtype\": \"float32\",\n129\t            \"description\": \"Output of GELU activation\"\n130\t        },\n131\t        \"global_features\": {\n132\t            \"shape\": [\n133\t                \"B\",\n134\t                \"1\",\n135\t                \"1\",\n136\t                \"C4\"\n137\t            ],\n138\t            \"dtype\": \"float32\",\n139\t            \"description\": \"L2 norm of x_gelu over spatial dims\"\n140\t        },\n141\t        \"gf_mean\": {\n142\t            \"shape\": [\n143\t                \"B\",\n144\t                \"1\",\n145\t                \"1\",\n146\t                \"1\"\n147\t            ],\n148\t            \"dtype\": \"float32\",\n149\t            \"description\": \"Channel mean of global_features\"\n150\t        },\n151\t        \"norm_features\": {\n152\t            \"shape\": [\n153\t                \"B\",\n154\t                \"1\",\n155\t                \"1\",\n156\t                \"C4\"\n157\t            ],\n158\t            \"dtype\": \"float32\",\n159\t            \"description\": \"Normalized global features\"\n160\t        },\n161\t        \"x_grn_scaled\": {\n162\t            \"shape\": [\n163\t                \"B\",\n164\t                \"H\",\n165\t                \"W\",\n166\t                \"C4\"\n167\t            ],\n168\t            \"dtype\": \"float32\",\n169\t            \"description\": \"x_gelu * norm_features\"\n170\t        },\n171\t        \"x_grn\": {\n172\t            \"shape\": [\n173\t                \"B\",\n174\t                \"H\",\