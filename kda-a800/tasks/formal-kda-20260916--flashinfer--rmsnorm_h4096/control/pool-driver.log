ch_size\": 15}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}}}, \"evaluation\": null}\n{\"definition\": \"rmsnorm_h4096\", \"solution\": null, \"workload\": {\"uuid\": \"14531e96-f6e6-4515-abb4-10855f72c80e\", \"axes\": {\"batch_size\": 64}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}}}, \"evaluation\": null}\n{\"definition\": \"rmsnorm_h4096\", \"solution\": null, \"workload\": {\"uuid\": \"841b0afa-80fa-449a-9e1d-f294da92d02f\", \"axes\": {\"batch_size\": 14509}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}}}, \"evaluation\": null}\n{\"definition\": \"rmsnorm_h4096\", \"solution\": null, \"workload\": {\"uuid\": \"33bf737d-3b37-4e38-be80-ea39b4b46ae6\", \"axes\": {\"batch_size\": 7}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}}}, \"evaluation\": null}\n{\"definition\": \"rmsnorm_h4096\", \"solution\": null, \"workload\": {\"uuid\": \"f0f508c3-e880-4ec8-b8be-1062db313d36\", \"axes\": {\"batch_size\": 14418}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}}}, \"evaluation\": null}\n","numLines":6,"startLine":1,"totalLines":6}}}
