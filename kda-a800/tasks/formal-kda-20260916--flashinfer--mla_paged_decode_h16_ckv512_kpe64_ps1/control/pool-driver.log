\n44\t    BLOCK_N: tl.constexpr,\n45\t):\n46\t    b = tl.program_id(0)\n47\t\n48\t    beg = tl.load(kv_indptr_ptr + b)\n49\t    end = tl.load(kv_indptr_ptr + b + 1)\n50\t    L = end - beg\n51\t\n52\t    offs_h = tl.arange(0, H)\n53\t    offs_ckv = tl.arange(0, DCKV)\n54\t    offs_kpe = tl.arange(0, DKPE)\n55\t\n56\t    out_row_ptr = (out_ptr + b * stride_o_b\n57\t                   + offs_h[:, None] * stride_o_h\n58\t                   + offs_ckv[None, :] * stride_o_d)\n59\t    lse_row_ptr = lse_ptr + b * stride_lse_b + offs_h * stride_lse_h\n60\t\n61\t    # Empty sequence: reproduce reference (zeros + -inf).\n62\t    if L <= 0:\n63\t        tl.store(out_row_ptr, tl.zeros([H, DCKV], dtype=tl.bfloat16))\n64\t        tl.store(lse_row_ptr, tl.full([H], float(\"-inf\"), dtype=tl.float32))\n65\t        return\n66\t\n67\t    # Load queries for all heads (reused across the whole KV loop).\n68\t    qn = tl.load(q_nope_ptr + b * stride_qn_b\n69\t                 + offs_h[:, None] * stride_qn_h\n70\t                 + offs_ckv[None, :] * stride_qn_d)          # [H, DCKV] bf16\n71\t    qp = tl.load(q_pe_ptr + b * stride_qp_b\n72\t                 + offs_h[:, None] * stride_qp_h\n73\t                 + offs_kpe[None, :] * stride_qp_d)          # [H, DKPE] bf16\n74\t\n75\t    m_i = tl.full([H], float(\"-inf\"), dtype=tl.float32)\n76\t    l_i = tl.zeros([H], dtype=tl.float32)\n77\t    acc = tl.zeros([H, DCKV], dtype=tl.float32)\n78\t\n79\t    for n in range(0, L, BLOCK_N):\n80\t        offs_n = n + tl.arange(0, BLOCK_N)\n81\t        col_mask = offs_n < L\n82\t        idx = tl.load(kv_indices_ptr + beg + offs_n, mask=col_mask, other=0).to(tl.int64)\n83\t\n84\t        Kc = tl.load(ckv_ptr + idx[:, None] * stride_ckv_p\n85\t                     + offs_ckv[None, :] * stride_ckv_d,\n86\t                     mask=col_mask[:, None], other=0.0)       # [BLOCK_N, DCKV] bf16\n87\t        Kp = tl.load(kpe_ptr + idx[:, None] * stride_kpe_p\n88\t                     + offs_kpe[None, :] * stride_kpe_d,\n89\t                     mask=col_mask[:, None], other=0.0)       # [BLOCK_N, DKPE] bf16\n90\t\n91\t        # Scores over the 576-dim key: qn @ Kc^T + qp @ Kp^T  -> [H, BLOCK_N] fp32\n92\t        qk = tl.dot(qn, tl.trans(Kc))\n93\t        qk += tl.dot(qp, tl.trans(Kp))\n94\t        qk = qk * sm_scale\n95\t        qk = tl.where(col_mask[None, :], qk, float(\"-inf\"))\n96\t\n97\t        m_new = tl.maximum(m_i, tl.max(qk, axis=1))\n98\t        alpha = tl.exp(m_i - m_new)\n99\t        p = tl.exp(qk - m_new[:, None])                       # [H, BLOCK_N] fp32\n100\t        l_i = l_i * alpha + tl.sum(p, axis=1)\n101\t        # PV over the 512-dim latent (value == Kc). bf16 tensor-core dot, fp32 acc.\n102\t        acc = acc * alpha[:, None] + tl.dot(p.to(tl.bfloat16), Kc)\n103\t        m_i = m_new\n104\t\n105\t    out = acc / l_i[:, None]\n106\t    tl.store(out_row_ptr, out.to(tl.bfloat16))\n107\t    # base-2 log-sum-exp: (m + ln l) / ln 2 = (m + ln l) * log2(e)\n108\t    # log2(e) inlined as a literal (module globals are not accessible from @jit).\n109\t    lse = (m_i + tl.log(l_i)) * 1.4426950408889634\n110\t    tl.store(lse_row_ptr, lse)\n111\t\n112\t\n113\t@torch.no_grad()\n114\tdef run(q_nope, q_pe, ckv_cache, kpe_cache, kv_indptr, kv_indices, sm_scale):\n115\t    batch_size, num_qo_heads, head_dim_ckv = q_nope.shape\n116\t    head_dim_kpe = q_pe.shape[-1]\n117\t    page_size = ckv_cache.shape[1]\n118\t\n119\t    assert num_qo_heads == _H\n120\t    assert head_dim_ckv == _DCKV\n121\t    assert head_dim_kpe == _DKPE\n122\t    assert page_size == 1\n123\t\n124\t    device = q_nope.device\n125\t    kv_indptr = kv_indptr.to(device=device, dtype=torch.int32)\n126\t    kv_indices = kv_indices.to(device=device, dtype=torch.int32)\n127\t\n128\t    output = torch.empty((batch_size, num_qo_heads, head_dim_ckv),\n129\t                         dtype=torch.bfloat16, device=device)\n130\t    lse = torch.empty((batch_size, num_qo_heads), dtype=torch.float32, device=device)