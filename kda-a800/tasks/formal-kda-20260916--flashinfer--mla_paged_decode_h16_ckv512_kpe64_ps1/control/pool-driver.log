{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Gq1xLVhC4DzPfGkcSAfLp2","type":"tool_result","content":"1\t\"\"\"Triton MLA paged decode — candidate c001.\n2\t\n3\tTask: mla_paged_decode_h16_ckv512_kpe64_ps1 (DeepSeek-V3 MLA decode, weight-absorbed).\n4\tTarget: NVIDIA A800 (sm_80).\n5\t\n6\tc001 = correctness baseline:\n7\t  * single fused Triton kernel, grid = (batch_size,)\n8\t  * all 16 query heads processed together (KV read once, reused for score + value)\n9\t  * online softmax in fp32 (natural base internally), fp32 accumulator\n10\t  * bf16 tensor-core QK and PV dots\n11\t  * empty-sequence guard -> output 0, lse -inf\n12\t  * base-2 LSE emitted as (m + ln l) * log2(e)\n13\t\n14\tPrimary implementation is Triton. PyTorch is used only for output allocation and\n15\tlaunch plumbing. No Torch/CPU/NumPy/CUDA-extension computational fallback.\n16\t\"\"\"\n17\t\n18\timport torch\n19\timport triton\n20\timport triton.language as tl\n21\t\n22\t# Constants for this definition (asserted at runtime to catch plumbing mistakes).\n23\t_H = 16       # num_qo_heads\n24\t_DCKV = 512   # head_dim_ckv (also the value dim, since V == compressed latent)\n25\t_DKPE = 64    # head_dim_kpe\n26\t_LOG2E = 1.4426950408889634\n27\t\n28\t\n29\t@triton.jit\n30\tdef _mla_decode_kernel(\n31\t    q_nope_ptr, q_pe_ptr, ckv_ptr, kpe_ptr,\n32\t    kv_indptr_ptr, kv_indices_ptr,\n33\t    out_ptr, lse_ptr,\n34\t    sm_scale,\n35\t    stride_qn_b, stride_qn_h, stride_qn_d,\n36\t    stride_qp_b, stride_qp_h, stride_qp_d,\n37\t    stride_ckv_p, stride_ckv_d,\n38\t    stride_kpe_p, stride_kpe_d,\n39\t    stride_o_b, stride_o_h, stride_o_d,\n40\t    stride_lse_b, stride_lse_h,\n41\t    H: tl.constexpr, DCKV: tl.constexpr, DKPE: tl.constexpr,\n42\t    BLOCK_N: tl.constexpr,\n43\t):\n44\t    b = tl.program_id(0)\n45\t\n46\t    beg = tl.load(kv_indptr_ptr + b)\n47\t    end = tl.load(kv_indptr_ptr + b + 1)\n48\t    L = end - beg\n49\t\n50\t    offs_h = tl.arange(0, H)\n51\t    offs_ckv = tl.arange(0, DCKV)\n52\t    offs_kpe = tl.arange(0, DKPE)\n53\t\n54\t    out_row_ptr = (out_ptr + b * stride_o_b\n55\t                   + offs_h[:, None] * stride_o_h\n56\t                   + offs_ckv[None, :] * stride_o_d)\n57\t    lse_row_ptr = lse_ptr + b * stride_lse_b + offs_h * stride_lse_h\n58\t\n59\t    # Empty sequence: reproduce reference (zeros + -inf).\n60\t    if L <= 0:\n61\t        tl.store(out_row_ptr, tl.zeros([H, DCKV], dtype=tl.bfloat16))\n62\t        tl.store(lse_row_ptr, tl.full([H], float(\"-inf\"), dtype=tl.float32))\n63\t        return\n64\t\n65\t    # Load queries for all heads (reused across the whole KV loop).\n66\t    qn = tl.load(q_nope_ptr + b * stride_qn_b\n67\t                 + offs_h[:, None] * stride_qn_h\n68\t                 + offs_ckv[None, :] * stride_qn_d)          # [H, DCKV] bf16\n69\t    qp = tl.load(q_pe_ptr + b * stride_qp_b\n70\t                 + offs_h[:, None] * stride_qp_h\n71\t                 + offs_kpe[None, :] * stride_qp_d)          # [H, DKPE] bf16\n72\t\n73\t    m_i = tl.full([H], float(\"-inf\"), dtype=tl.float32)\n74\t    l_i = tl.zeros([H], dtype=tl.float32)\n75\t    acc = tl.zeros([H, DCKV], dtype=tl.float32)\n76\t\n77\t    for n in range(0, L, BLOCK_N):\n78\t        offs_n = n + tl.arange(0, BLOCK_N)\n79\t        col_mask = offs_n < L\n80\t        idx = tl.load(kv_indices_ptr + beg + offs_n, mask=col_mask, other=0).to(tl.int64)\n81\t\n82\t        Kc = tl.load(ckv_ptr + idx[:, None] * stride_ckv_p\n83\t                     + offs_ckv[None, :] * stride_ckv_d,\n84\t                     mask=col_mask[:, None], other=0.0)       # [BLOCK_N, DCKV] bf16\n85\t        Kp = tl.load(kpe_ptr + idx[:, None] * stride_kpe_p\n86\t                     + offs_kpe[None, :] * stride_kpe_d,\n87\t                     mask=col_mask[:, None], other=0.0)       # [BLOCK_N, DKPE] bf16\n88\t\n89\t        # Scores over the 576-dim key: qn @ Kc^T + qp @ Kp^T  -> [H, BLOCK_N] fp32\n90\t        qk = tl.dot(qn, tl.trans(Kc))\n91\t        qk += tl.dot(qp, tl.trans(Kp))\n92\t        qk = qk * sm_scale\n93\t        qk = tl.where(col_mask[None, :], qk, float(\"-inf\"))\n94\t\n95\t        m_new = tl.maximum(m_i, tl.max(qk, axis=1))\n96\t        alpha = tl.exp(m_i - m_new)\n97\t        p = tl.exp(qk - m_new[:, None])                       # [H, BLOCK_N] fp32\n98\t        l_i = l_i * alpha + tl.sum(p, axis=1)\n99\t        # PV over the 512-dim latent (value == Kc). bf16 tensor-core dot, fp32 acc.\n100\t        acc = acc * alpha[:, None] + tl.dot(p.to(tl.bfloat16), Kc)\n101\t        m_i = m_new\n102\t\n103\t    out = acc / l_i[:, None]\n104\t    tl.store(out_row_ptr, out.to(tl.bfloat16))\n105\t    # base-2 log-sum-exp: (m + ln l) / ln 2 = (m + ln l) * log2(e)\n106\t    lse = (m_i + tl.log(l_i)) * _LOG2E\n107\t    tl.store(lse_row_ptr, lse)\n108\t\n109\t\n110\t@torch.no_grad()\n111\tdef run(q_nope, q_pe, ckv_cache, kpe_cache, kv_indptr, kv_indices, sm_scale):\n112\t    batch_size, num_qo_heads, head_dim_ckv = q_nope.shape\n113\t    head_dim_kpe = q_pe.shape[-1]\n114\t    page_size = ckv_cache.shape[1]\n115\t\n116\t    assert num_qo_heads == _H\n117\t    assert head_dim_ckv == _DCKV\n118\t    assert head_dim_kpe == _DKPE\n119\t    assert page_size == 1\n120\t\n121\t    device = q_nope.device\n122\t    kv_indptr = kv_indptr.to(device=device, dtype=torch.int32)\n123\t    kv_indices = kv_indices.to(device=device, dtype=torch.int32)\n124\t\n125\t    output = torch.empty((batch_size, num_qo_heads, head_dim_ckv),\n126\t                         dtype=torch.bfloat16, device=device)\n127\t    lse = torch.empty((batch_size, num_qo_heads), dtype=torch.float32, device=device)\n128\t\n129\t    # ckv_cache / kpe_cache: [num_pages, 1, D]; page stride is stride(0), feature stride is stride(2).\n130\t    grid = (batch_size,)\n131\t    _mla_decode_kernel[grid](\n132\t        q_nope, q_pe, ckv_cache, kpe_cache,\n133\t        kv_indptr, kv_indices,\n134\t        output, lse,\n135\t        float(sm_scale),\n136\t        q_nope.stride(0), q_nope.stride(1), q_nope.stride(2),\n137\t        q_pe.stride(0), q_pe.stride(1), q_pe.stride(2),\n138\t        ckv_cache.stride(0), ckv_cache.stride(2),\n139\t        kpe_cache.stride(0), kpe_cache.stride(2),\n140\t        output.stride(0), output.stride(1), output.stride(2),\n141\t        lse.stride(0), lse.stride(1),\n142\t        H=_H, DCKV=_DCKV, DKPE=_DKPE,\n143\t        BLOCK_N=64,\n144\t        num_warps=4,\n145\t        num_stages=2,\n146\t    )\n147\t    return output, lse\n148\t"}]},"parent_tool_use_id":null,"session_id":"2085aa4c-845e-4589-9a88-17ee5e1df184","uuid":"e4b6038a-a2da-44e1-89de-e3a6e35cc801","timestamp":"2026-09-16T17:16:31.019Z","tool_use_result":{"type":"text","file":{"filePath":"/data1/workspace/weihongren/kda-runs/formal-kda-20260916--flashinfer--mla_paged_decode_h16_ckv512_kpe64_ps1/solution/solution.py","content":"\"\"\"Triton MLA paged decode — candidate c001.\n\nTask: mla_paged_decode_h16_ckv512_kpe64_ps1 (DeepSeek-V3 MLA decode, weight-absorbed).\nTarget: NVIDIA A800 (sm_80).\n\nc001 = correctness baseline:\n  * single fused Triton kernel, grid = (batch_size,)\n  * all 16 query heads processed together (KV read once, reused for score + value)\n  * online softmax in fp32 (natural base internally), fp32 accumulator\n  * bf16 tensor-core QK and PV dots\n  * empty-sequence guard -> output 0, lse -inf\n  * base-2 LSE emitted as (m + ln l) * log2(e)\n\nPrimary implementation is Triton. PyTorch is used only for output allocation and\nlaunch plumbing. No Torch/CPU/NumPy/CUDA-extension computational fallback.\n\"\"\"\n\nimport torch\nimport triton\nimport triton.language as tl\n\n# Constants for this definition (asserted at runtime to catch plumbing mistakes).\n_H = 16       # num_qo_heads\n_DCKV = 512   # head_dim_ckv (also the value dim, since V == compressed latent)\n_DKPE = 64    # head_dim_kpe\n_LOG2E = 1.4426950408889634\n\n\n@triton.jit\ndef _mla_decode_kernel(\n    q_nope_ptr, q_pe_ptr, ckv_ptr, kpe_ptr,\n    kv_indptr_ptr, kv_indices_ptr,\n    out_ptr, lse_ptr,\n    sm_scale,\n    stride_qn_b, stride_qn_h, stride_qn_d,\n    stride_qp_b, stride_qp_h, stride_qp_d,\n    stride_ckv_p, stride_ckv_d,\n    stride_kpe_p, stride_kpe_d,\n    stride_o_b, stride_o_h, stride_o_d,\n    stride_lse_b, stride_lse_h,\n    H: tl.constexpr, DCKV: tl.constexpr, DKPE: tl.constexpr,\n    BLOCK_N: tl.constexpr,\n):\n    b = tl.program_id(0)\n\n    beg = tl.load(kv_indptr_ptr + b)\n    end = tl.load(kv_indptr_ptr + b + 1)\n    L = end - beg\n\n    offs_h = tl.arange(0, H)\n    offs_ckv = tl.arange(0, DCKV)\n    offs_kpe = tl.arange(0, DKPE)\n\n    out_row_ptr = (out_ptr + b * stride_o_b\n                   + offs_h[:, None] * stride_o_h\n                   + offs_ckv[None, :] * stride_o_d)\n    lse_row_ptr = lse_ptr + b * stride_lse_b + offs_h * stride_lse_h\n\n    # Empty sequence: reproduce reference (zeros + -inf).\n    if L <= 0:\n        tl.store(out_row_ptr, tl.zeros([H, DCKV], dtype=tl.bfloat16))\n        tl.store(lse_row_ptr, tl.full([H], float(\"-inf\"), dtype=tl.float32))\n        return\n\n    # Load queries for all heads (reused across the whole KV loop).\n    qn = tl.load(q_nope_ptr + b * stride_qn_b\n                 + offs_h[:, None] * stride_qn_h\n                 + offs_ckv[None, :] * stride_qn_d)          # [H, DCKV] bf16\n    qp = tl.load(q_pe_ptr + b * stride_qp_b\n                 + offs_h[:, None] * stride_qp_h\n                 + offs_kpe[None, :] * stride_qp_d)          # [H, DKPE] bf16\n\n    m_i = tl.full([H], float(\"-inf\"), dtype=tl.float32)\n    l_i = tl.zeros([H], dtype=tl.float32)\n    acc = tl.zeros([H, DCKV], dtype=tl.float32)\n\n    for n in range(0, L, BLOCK_N):\n        offs_n = n + tl.arange(0, BLOCK_N)\n        col_mask = offs_n < L\n        idx = tl.load(kv_indices_ptr + beg + offs_n, mask=col_mask, other=0).to(tl.int64)\n\n        Kc = tl.load(ckv_ptr + idx[:, None] * stride_ckv_p\n                     + offs_ckv[None, :] * stride_ckv_d,\n                     mask=col_mask[:, None], other=0.0)       # [BLOCK_N, DCKV] bf16\n        Kp = tl.load(kpe_ptr + idx[:, None] * stride_kpe_p\n                     + offs_kpe[None, :] * stride_kpe_d,\n                     mask=col_mask[:, None], other=0.0)       # [BLOCK_N, DKPE] bf16\n\n        # Scores over the 576-dim key: qn @ Kc^T + qp @ Kp^T  -> [H, BLOCK_N] fp32\n        qk = tl.dot(qn, tl.trans(Kc))\n        qk += tl.dot(qp, tl.trans(Kp))\n        qk = qk * sm_scale\n        qk = tl.where(col_mask[None, :], qk, float(\"-inf\"))\n\n        m_new = tl.maximum(m_i, tl.max(qk, axis=1))\n        alpha = tl.exp(m_i - m_new)\n        p = tl.exp(qk - m_new[:, None])                       # [H, BLOCK_N] fp32\n        l_i = l_i * alpha + tl.sum(p, axis=1)\n        # PV over the 512-dim latent (value == Kc). bf16 tensor-core dot, fp32 acc.\n        acc = acc * alpha[:, None] + tl.dot(p.to(tl.bfloat16), Kc)\n        m_i = m_new\n\n    out = acc / l_i[:, None]\n    tl.store(out_row_ptr, out.to(tl.bfloat16))\n    # base-2 log-sum-exp: (m + ln l) / ln 2 = (m + ln l) * log2(e)\n    lse = (m_i + tl.log(l_i)) * _LOG2E\n    tl.store(lse_row_ptr, lse)\n\n\n@torch.no_grad()\ndef run(q_nope, q_pe, ckv_cache, kpe_cache, kv_indptr, kv_indices, sm_scale):\n    batch_size, num_qo_heads, head_dim_ckv = q_nope.shape\n    head_dim_kpe = q_pe.shape[-1]\n    page_size = ckv_cache.shape[1]\n\n    assert num_qo_heads == _H\n    assert head_dim_ckv == _DCKV\n    assert head_dim_kpe == _DKPE\n    assert page_size == 1\n\n    device = q_nope.device\n    kv_indptr = kv_indptr.to(device=device, dtype=torch.int32)\n    kv_indices = kv_indices.to(device=device, dtype=torch.int32)\n\n    output = torch.empty((batch_size, num_qo_heads, head_dim_ckv),\n                         dtype=torch.bfloat16, device=device)\n    lse = torch.empty((batch_size, num_qo_heads), dtype=torch.float32, device=device)\n\n    # ckv_cache / kpe_cache: [num_pages, 1, D]; page stride is stride(0), feature stride is stride(2).\n    grid = (batch_size,)\n    _mla_decode_kernel[grid](\n        q_nope, q_pe, ckv_cache, kpe_cache,\n        kv_indptr, kv_indices,\n        output, lse,\n        float(sm_scale),\n        q_nope.stride(0), q_nope.stride(1), q_nope.stride(2),\n        q_pe.stride(0), q_pe.stride(1), q_pe.stride(2),\n        ckv_cache.stride(0), ckv_cache.stride(2),\n        kpe_cache.stride(0), kpe_cache.stride(2),\n        output.stride(0), output.stride(1), output.stride(2),\n        lse.stride(0), lse.stride(1),\n        H=_H, DCKV=_DCKV, DKPE=_DKPE,\n        BLOCK_N=64,\n        num_warps=4,\n        num_stages=2,\n    )\n    return output, lse\n","numLines":148,"startLine":1,"totalLines":148}}}
